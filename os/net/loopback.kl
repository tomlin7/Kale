// In-memory network device for deterministic protocol tests.

struct Loopback {
    uint8[2048] packet;
    uint32 length;
    int ready;
}

fn int loopback_send(Loopback* device, uint8* data, uint32 length) {
    if (device == (Loopback*)0 || data == (uint8*)0 || length > 2048) { return 0; }
    uint32 i = 0;
    while (i < length) {
        device->packet[i] = data[i];
        i = i + 1;
    }
    device->length = length;
    device->ready = 1;
    return 1;
}

fn int loopback_receive(Loopback* device, uint8* data, uint32 capacity) {
    if (device == (Loopback*)0 || data == (uint8*)0 || device->ready == 0 || capacity < device->length) { return 0; }
    uint32 i = 0;
    while (i < device->length) {
        data[i] = device->packet[i];
        i = i + 1;
    }
    int result = device->length;
    device->ready = 0;
    return result;
}

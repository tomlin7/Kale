// os/drivers/hpet.kl
// High Precision Event Timer (HPET) Driver & Nanosecond Timekeeping for Kale OS
// Supports MMIO register configuration, 64-bit main counter, sub-microsecond time calculations,
// and comparator alarm scheduling.

// General Configuration Register Bits
uint64 HPET_CONF_ENABLE        = 0x0000000000000001 as uint64; // Counter overall enable
uint64 HPET_CONF_LEG_RT        = 0x0000000000000002 as uint64; // Legacy replacement route (IRQ0/IRQ8)

// Timer Configuration Register Bits
uint64 HPET_TN_INT_ENB         = 0x0000000000000004 as uint64; // Interrupt Enable
uint64 HPET_TN_TYPE_PERIODIC   = 0x0000000000000008 as uint64; // Periodic Timer Type
uint64 HPET_TN_PER_CAP         = 0x0000000000000010 as uint64; // Periodic Interrupt Capable
uint64 HPET_TN_SIZE_64         = 0x0000000000000020 as uint64; // 64-bit Size Capable
uint64 HPET_TN_VAL_SET         = 0x0000000000000040 as uint64; // Value Set (for periodic accumulator)

// ==============================================================================
// Data Structures
// ==============================================================================

struct Timespec {
    int64 tv_sec;  // Seconds
    int64 tv_nsec; // Nanoseconds (0 .. 999,999,999)
}

struct HPETTimer {
    uint64 conf;
    uint64 comp;
    int irq;
    bool is_periodic;
    bool is_64bit;
    bool is_enabled;
}

struct HPETDevice {
    uint64 base_addr;
    uint32 clk_period_fs; // Femtoseconds (10^-15 s) per counter tick
    uint16 vendor_id;
    int timer_count;
    bool is_64bit_counter;
    bool is_legacy_routed;
    bool is_enabled;
    uint64 frequency_hz;
    uint64 current_counter;
    HPETTimer[8] timers;
}

// ==============================================================================
// Device Initialization & Capabilities
// ==============================================================================

// Initializes the HPET device from GCAP_ID register value
fn void hpet_init(HPETDevice* dev, uint64 base_addr, uint64 gcap_id) {
    if (dev == null) {
        return;
    }
    dev->base_addr = base_addr;
    dev->is_enabled = false;
    dev->is_legacy_routed = false;
    dev->current_counter = 0 as uint64;

    // Period in femtoseconds: bits 63:32
    dev->clk_period_fs = (gcap_id >> (32 as uint64)) as uint32;

    // Vendor ID: bits 31:16
    dev->vendor_id = ((gcap_id >> (16 as uint64)) & (0xFFFF as uint64)) as uint16;

    // 64-bit Counter Capable: bit 13
    dev->is_64bit_counter = ((gcap_id >> (13 as uint64)) & (1 as uint64)) != (0 as uint64);

    // Number of timers: bits 12:8 (value is N - 1)
    uint64 num_tim = (gcap_id >> (8 as uint64)) & (0x1F as uint64);
    dev->timer_count = (num_tim as int) + 1;
    if (dev->timer_count > 8) {
        dev->timer_count = 8;
    }

    // Frequency = 10^15 / clk_period_fs (Hz)
    // E.g. period = 100,000,000 fs (100 ns) -> freq = 10,000,000 Hz = 10 MHz
    if (dev->clk_period_fs > (0 as uint32)) {
        dev->frequency_hz = (1000000000000000 as uint64) / (dev->clk_period_fs as uint64);
    } else {
        dev->frequency_hz = 0 as uint64;
    }

    int i = 0;
    while (i < 8) {
        dev->timers[i].conf = 0 as uint64;
        dev->timers[i].comp = 0 as uint64;
        dev->timers[i].irq = 0;
        dev->timers[i].is_periodic = false;
        dev->timers[i].is_64bit = false;
        dev->timers[i].is_enabled = false;
        i = i + 1;
    }
}

fn void hpet_enable(HPETDevice* dev, bool legacy_route) {
    if (dev == null) {
        return;
    }
    dev->is_enabled = true;
    dev->is_legacy_routed = legacy_route;
}

fn void hpet_disable(HPETDevice* dev) {
    if (dev == null) {
        return;
    }
    dev->is_enabled = false;
}

// ==============================================================================
// Nanosecond & Microsecond Time Calculations
// ==============================================================================

// Converts delta ticks to nanoseconds
// ns = (ticks * clk_period_fs) / 1,000,000
fn uint64 hpet_ticks_to_nanos(HPETDevice* dev, uint64 ticks) {
    if (dev == null || dev->clk_period_fs == (0 as uint32)) {
        return 0 as uint64;
    }
    uint64 total_fs = ticks * (dev->clk_period_fs as uint64);
    return total_fs / (1000000 as uint64);
}

// Converts delta ticks to microseconds
// us = (ticks * clk_period_fs) / 1,000,000,000
fn uint64 hpet_ticks_to_micros(HPETDevice* dev, uint64 ticks) {
    if (dev == null || dev->clk_period_fs == (0 as uint32)) {
        return 0 as uint64;
    }
    uint64 total_fs = ticks * (dev->clk_period_fs as uint64);
    return total_fs / (1000000000 as uint64);
}

// Converts nanoseconds to required counter ticks
fn uint64 hpet_nanos_to_ticks(HPETDevice* dev, uint64 nanos) {
    if (dev == null || dev->clk_period_fs == (0 as uint32)) {
        return 0 as uint64;
    }
    uint64 total_fs = nanos * (1000000 as uint64);
    return total_fs / (dev->clk_period_fs as uint64);
}

// Populates POSIX Timespec from total elapsed ticks
fn void hpet_get_time(HPETDevice* dev, uint64 ticks, Timespec* ts) {
    if (dev == null || ts == null) {
        return;
    }
    uint64 total_ns = hpet_ticks_to_nanos(dev, ticks);
    ts->tv_sec = (total_ns / (1000000000 as uint64)) as int64;
    ts->tv_nsec = (total_ns % (1000000000 as uint64)) as int64;
}

// ==============================================================================
// Comparator Timer Configuration
// ==============================================================================

fn void hpet_setup_timer(HPETDevice* dev, int timer_idx, uint64 comp_val, bool periodic, bool int_enb) {
    if (dev == null || timer_idx < 0 || timer_idx >= dev->timer_count) {
        return;
    }
    HPETTimer* t = &dev->timers[timer_idx];
    t->comp = comp_val;
    t->is_periodic = periodic;
    t->is_enabled = int_enb;

    uint64 conf = 0 as uint64;
    if (int_enb) {
        conf = conf | HPET_TN_INT_ENB;
    }
    if (periodic) {
        conf = conf | HPET_TN_TYPE_PERIODIC | HPET_TN_VAL_SET;
    }
    t->conf = conf;
}

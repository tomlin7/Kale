// VGA 80x25 Text Mode Driver (0xB8000)
struct VGADriver {
    buffer: *uint16,
    width: int32,
    height: int32,
    cursor_x: int32,
    cursor_y: int32,
    color: uint8,
}

fn vga_init() -> VGADriver {
    let drv: VGADriver = VGADriver {
        buffer: 0xB8000 as *uint16,
        width: 80,
        height: 25,
        cursor_x: 0,
        cursor_y: 0,
        color: 0x4F, // White on Red
    };
    return drv;
}

fn vga_clear(drv: *VGADriver) -> void {
    let blank: uint16 = (drv.color as uint16 << 8) | (' ' as uint16);
    let total: int32 = drv.width * drv.height;
    let i: int32 = 0;
    while i < total {
        drv.buffer[i] = blank;
        i = i + 1;
    }
    drv.cursor_x = 0;
    drv.cursor_y = 0;
}

fn vga_putc(drv: *VGADriver, c: uint8) -> void {
    if c == 10 { // '\n'
        drv.cursor_x = 0;
        drv.cursor_y = drv.cursor_y + 1;
        return;
    }
    
    let offset: int32 = (drv.cursor_y * drv.width) + drv.cursor_x;
    let entry: uint16 = (drv.color as uint16 << 8) | (c as uint16);
    drv.buffer[offset] = entry;
    
    drv.cursor_x = drv.cursor_x + 1;
    if drv.cursor_x >= drv.width {
        drv.cursor_x = 0;
        drv.cursor_y = drv.cursor_y + 1;
    }
}

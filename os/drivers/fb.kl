// 32-bit linear framebuffer drawing primitives.

struct Framebuffer {
    uint32* address;
    uint32 width;
    uint32 height;
    uint32 pitch;
}

fn void fb_init(Framebuffer* fb, uint64 address, uint32 width, uint32 height, uint32 pitch) {
    fb->address = address as *uint32;
    fb->width = width;
    fb->height = height;
    fb->pitch = pitch;
}

fn void fb_put_pixel(Framebuffer* fb, int x, int y, uint32 color) {
    if (x < 0 || y < 0 || x >= fb->width as int || y >= fb->height as int) { return; }
    uint32 stride = fb->pitch / 4;
    uint32 index = (y as uint32) * stride + (x as uint32);
    fb->address[index] = color;
}

fn void fb_clear(Framebuffer* fb, uint32 color) {
    int y = 0;
    while y < fb->height as int {
        int x = 0;
        while x < fb->width as int {
            fb_put_pixel(fb, x, y, color);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn void fb_fill_rect(Framebuffer* fb, int x, int y, int width, int height, uint32 color) {
    int row = 0;
    while row < height {
        int col = 0;
        while col < width {
            fb_put_pixel(fb, x + col, y + row, color);
            col = col + 1;
        }
        row = row + 1;
    }
}

// os/drivers/fb.kl
// Linear Framebuffer Graphics Driver & 2D Rasterization Engine for Kale OS
// Supports 32-bit ARGB/RGBA, video modes (640x480, 800x600, 1024x768),
// double buffering, scissor clipping, Bresenham line drawing, alpha blending, and bitmap fonts.

struct ClipRect {
    int32 x1;
    int32 y1;
    int32 x2;
    int32 y2;
}

struct Framebuffer {
    uint32* base_address;
    uint32* back_buffer;
    uint32 width;
    uint32 height;
    uint32 pitch; // bytes per line
    ClipRect clip;
    bool double_buffered;
}

// ==============================================================================
// Initialization & Buffer Management
// ==============================================================================

fn void fb_init(
    Framebuffer* fb,
    uint32* base,
    uint32* back,
    uint32 w,
    uint32 h,
    uint32 pitch
) {
    fb->base_address = base;
    fb->back_buffer = back;
    fb->width = w;
    fb->height = h;
    fb->pitch = pitch;
    fb->double_buffered = (back != null);

    // Default clip rect covers full screen
    fb->clip.x1 = 0;
    fb->clip.y1 = 0;
    fb->clip.x2 = (w as int32) - 1;
    fb->clip.y2 = (h as int32) - 1;
}

fn void fb_set_clip(Framebuffer* fb, int32 x1, int32 y1, int32 x2, int32 y2) {
    if (x1 < 0) {
        x1 = 0;
    }
    if (y1 < 0) {
        y1 = 0;
    }
    if (x2 >= (fb->width as int32)) {
        x2 = (fb->width as int32) - 1;
    }
    if (y2 >= (fb->height as int32)) {
        y2 = (fb->height as int32) - 1;
    }

    fb->clip.x1 = x1;
    fb->clip.y1 = y1;
    fb->clip.x2 = x2;
    fb->clip.y2 = y2;
}

fn void fb_reset_clip(Framebuffer* fb) {
    fb->clip.x1 = 0;
    fb->clip.y1 = 0;
    fb->clip.x2 = (fb->width as int32) - 1;
    fb->clip.y2 = (fb->height as int32) - 1;
}

fn uint32* fb_active_target(Framebuffer* fb) {
    if (fb->double_buffered && fb->back_buffer != null) {
        return fb->back_buffer;
    }
    return fb->base_address;
}

fn void fb_swap_buffers(Framebuffer* fb) {
    if (!fb->double_buffered || fb->base_address == null || fb->back_buffer == null) {
        return;
    }

    uint32 total_pixels = (fb->pitch / (4 as uint32)) * fb->height;
    uint32 i = 0 as uint32;
    while (i < total_pixels) {
        fb->base_address[i as int] = fb->back_buffer[i as int];
        i = i + (1 as uint32);
    }
}

// ==============================================================================
// 2D Rasterization Primitives
// ==============================================================================

fn void fb_put_pixel_clip(Framebuffer* fb, int32 x, int32 y, uint32 color) {
    if (x < fb->clip.x1 || x > fb->clip.x2 || y < fb->clip.y1 || y > fb->clip.y2) {
        return; // Clipped
    }

    uint32* target = fb_active_target(fb);
    if (target == null) {
        return;
    }

    uint32 pixels_per_pitch = fb->pitch / (4 as uint32);
    uint32 offset = ((y as uint32) * pixels_per_pitch) + (x as uint32);
    target[offset as int] = color;
}

fn uint32 fb_get_pixel(Framebuffer* fb, int32 x, int32 y) {
    if (x < 0 || x >= (fb->width as int32) || y < 0 || y >= (fb->height as int32)) {
        return 0 as uint32;
    }

    uint32* target = fb_active_target(fb);
    if (target == null) {
        return 0 as uint32;
    }

    uint32 pixels_per_pitch = fb->pitch / (4 as uint32);
    uint32 offset = ((y as uint32) * pixels_per_pitch) + (x as uint32);
    return target[offset as int];
}

fn void fb_clear(Framebuffer* fb, uint32 color) {
    uint32* target = fb_active_target(fb);
    if (target == null) {
        return;
    }

    uint32 pixels_per_pitch = fb->pitch / (4 as uint32);
    uint32 y = 0 as uint32;
    while (y < fb->height) {
        uint32 x = 0 as uint32;
        uint32 row_start = y * pixels_per_pitch;
        while (x < fb->width) {
            target[(row_start + x) as int] = color;
            x = x + (1 as uint32);
        }
        y = y + (1 as uint32);
    }
}

fn void fb_fill_rect(Framebuffer* fb, int32 x, int32 y, int32 w, int32 h, uint32 color) {
    if (w <= 0 || h <= 0) {
        return;
    }

    int32 rx1 = x;
    int32 ry1 = y;
    int32 rx2 = x + w - 1;
    int32 ry2 = y + h - 1;

    // Intersect with clip rect
    if (rx1 < fb->clip.x1) {
        rx1 = fb->clip.x1;
    }
    if (ry1 < fb->clip.y1) {
        ry1 = fb->clip.y1;
    }
    if (rx2 > fb->clip.x2) {
        rx2 = fb->clip.x2;
    }
    if (ry2 > fb->clip.y2) {
        ry2 = fb->clip.y2;
    }

    if (rx1 > rx2 || ry1 > ry2) {
        return;
    }

    uint32* target = fb_active_target(fb);
    if (target == null) {
        return;
    }

    uint32 pixels_per_pitch = fb->pitch / (4 as uint32);
    int32 cur_y = ry1;
    while (cur_y <= ry2) {
        uint32 line_offset = (cur_y as uint32) * pixels_per_pitch;
        int32 cur_x = rx1;
        while (cur_x <= rx2) {
            target[(line_offset + (cur_x as uint32)) as int] = color;
            cur_x = cur_x + 1;
        }
        cur_y = cur_y + 1;
    }
}

fn void fb_draw_rect(Framebuffer* fb, int32 x, int32 y, int32 w, int32 h, uint32 color) {
    if (w <= 0 || h <= 0) {
        return;
    }

    // Top & Bottom edges
    int32 cur_x = x;
    while (cur_x < x + w) {
        fb_put_pixel_clip(fb, cur_x, y, color);
        fb_put_pixel_clip(fb, cur_x, y + h - 1, color);
        cur_x = cur_x + 1;
    }

    // Left & Right edges
    int32 cur_y = y;
    while (cur_y < y + h) {
        fb_put_pixel_clip(fb, x, cur_y, color);
        fb_put_pixel_clip(fb, x + w - 1, cur_y, color);
        cur_y = cur_y + 1;
    }
}

fn int32 fb_abs(int32 v) {
    if (v < 0) {
        return 0 - v;
    }
    return v;
}

// Bresenham's line algorithm handling all octants
fn void fb_draw_line(Framebuffer* fb, int32 x0, int32 y0, int32 x1, int32 y1, uint32 color) {
    if (x0 > x1 || (x0 == x1 && y0 > y1)) {
        int32 tx = x0;
        int32 ty = y0;
        x0 = x1;
        y0 = y1;
        x1 = tx;
        y1 = ty;
    }

    int32 dx = fb_abs(x1 - x0);
    int32 dy = fb_abs(y1 - y0);
    int32 sx = -1;
    if (x0 < x1) {
        sx = 1;
    }
    int32 sy = -1;
    if (y0 < y1) {
        sy = 1;
    }
    int32 err = dx - dy;

    while (true) {
        fb_put_pixel_clip(fb, x0, y0, color);
        if (x0 == x1 && y0 == y1) {
            return;
        }
        int32 e2 = err * 2;
        if (e2 >= (0 - dy)) {
            err = err - dy;
            x0 = x0 + sx;
        }
        if (e2 <= dx) {
            err = err + dx;
            y0 = y0 + sy;
        }
    }
}

// 32-bit ARGB Alpha Channel Compositing: (fg * a + bg * (255 - a)) / 255
fn uint32 color_alpha_blend(uint32 fg, uint32 bg, uint32 alpha) {
    if (alpha >= (255 as uint32)) {
        return fg;
    }
    if (alpha == (0 as uint32)) {
        return bg;
    }

    uint32 inv_alpha = (255 as uint32) - alpha;

    uint32 fg_r = (fg >> 16) & (0xFF as uint32);
    uint32 fg_g = (fg >> 8) & (0xFF as uint32);
    uint32 fg_b = fg & (0xFF as uint32);

    uint32 bg_r = (bg >> 16) & (0xFF as uint32);
    uint32 bg_g = (bg >> 8) & (0xFF as uint32);
    uint32 bg_b = bg & (0xFF as uint32);

    uint32 out_r = ((fg_r * alpha) + (bg_r * inv_alpha)) / (255 as uint32);
    uint32 out_g = ((fg_g * alpha) + (bg_g * inv_alpha)) / (255 as uint32);
    uint32 out_b = ((fg_b * alpha) + (bg_b * inv_alpha)) / (255 as uint32);

    return (0xFF000000 as uint32) | (out_r << 16) | (out_g << 8) | out_b;
}

// ==============================================================================
// 8x8 Bitmap Font Rendering
// ==============================================================================

// Compact 8x8 font glyph rows for ASCII characters
fn uint8 font_get_glyph_row(char c, int row) {
    if (row < 0 || row >= 8) {
        return 0 as uint8;
    }

    // Space ' '
    if (c == (' ' as char)) {
        return 0 as uint8;
    }

    // Number '0'
    if (c == ('0' as char)) {
        if (row == 0 || row == 6) { return 0x3C as uint8; }
        if (row == 1 || row == 5) { return 0x66 as uint8; }
        if (row == 2) { return 0x6E as uint8; }
        if (row == 3) { return 0x76 as uint8; }
        if (row == 4) { return 0x66 as uint8; }
        return 0 as uint8;
    }

    // Number '1'
    if (c == ('1' as char)) {
        if (row == 0) { return 0x18 as uint8; }
        if (row == 1) { return 0x38 as uint8; }
        if (row >= 2 && row <= 5) { return 0x18 as uint8; }
        if (row == 6) { return 0x7E as uint8; }
        return 0 as uint8;
    }

    // Number '2'
    if (c == ('2' as char)) {
        if (row == 0) { return 0x3C as uint8; }
        if (row == 1) { return 0x66 as uint8; }
        if (row == 2) { return 0x06 as uint8; }
        if (row == 3) { return 0x1C as uint8; }
        if (row == 4) { return 0x30 as uint8; }
        if (row == 5) { return 0x60 as uint8; }
        if (row == 6) { return 0x7E as uint8; }
        return 0 as uint8;
    }

    // Letter 'A'
    if (c == ('A' as char) || c == ('a' as char)) {
        if (row == 0) { return 0x18 as uint8; }
        if (row == 1) { return 0x24 as uint8; }
        if (row == 2) { return 0x42 as uint8; }
        if (row == 3) { return 0x7E as uint8; }
        if (row >= 4 && row <= 6) { return 0x42 as uint8; }
        return 0 as uint8;
    }

    // Letter 'K'
    if (c == ('K' as char) || c == ('k' as char)) {
        if (row == 0 || row == 6) { return 0x46 as uint8; }
        if (row == 1 || row == 5) { return 0x4C as uint8; }
        if (row == 2 || row == 4) { return 0x58 as uint8; }
        if (row == 3) { return 0x70 as uint8; }
        return 0 as uint8;
    }

    // Letter 'L'
    if (c == ('L' as char) || c == ('l' as char)) {
        if (row >= 0 && row <= 5) { return 0x60 as uint8; }
        if (row == 6) { return 0x7E as uint8; }
        return 0 as uint8;
    }

    // Letter 'E'
    if (c == ('E' as char) || c == ('e' as char)) {
        if (row == 0 || row == 3 || row == 6) { return 0x7E as uint8; }
        if (row >= 1 && row <= 5) { return 0x60 as uint8; }
        return 0 as uint8;
    }

    // Letter 'O'
    if (c == ('O' as char) || c == ('o' as char)) {
        if (row == 0 || row == 6) { return 0x3C as uint8; }
        if (row >= 1 && row <= 5) { return 0x66 as uint8; }
        return 0 as uint8;
    }

    // Letter 'S'
    if (c == ('S' as char) || c == ('s' as char)) {
        if (row == 0 || row == 3 || row == 6) { return 0x3C as uint8; }
        if (row == 1 || row == 2) { return 0x60 as uint8; }
        if (row == 4 || row == 5) { return 0x06 as uint8; }
        return 0 as uint8;
    }

    // Period '.'
    if (c == ('.' as char)) {
        if (row == 6) { return 0x18 as uint8; }
        return 0 as uint8;
    }

    // Colon ':'
    if (c == (':' as char)) {
        if (row == 2 || row == 5) { return 0x18 as uint8; }
        return 0 as uint8;
    }

    // Dash '-'
    if (c == ('-' as char)) {
        if (row == 3) { return 0x7E as uint8; }
        return 0 as uint8;
    }

    // Slash '/'
    if (c == ('/' as char)) {
        if (row == 0) { return 0x02 as uint8; }
        if (row == 1) { return 0x04 as uint8; }
        if (row == 2) { return 0x08 as uint8; }
        if (row == 3) { return 0x10 as uint8; }
        if (row == 4) { return 0x20 as uint8; }
        if (row == 5) { return 0x40 as uint8; }
        if (row == 6) { return 0x80 as uint8; }
        return 0 as uint8;
    }

    // Generic box for other characters
    if (row == 0 || row == 6) {
        return 0x7E as uint8;
    }
    if (row >= 1 && row <= 5) {
        return 0x42 as uint8;
    }
    return 0 as uint8;
}

fn void fb_draw_char(
    Framebuffer* fb,
    int32 x,
    int32 y,
    char c,
    uint32 fg,
    uint32 bg,
    bool transparent_bg
) {
    int row = 0;
    while (row < 8) {
        uint8 pattern = font_get_glyph_row(c, row);
        int col = 0;
        while (col < 8) {
            uint8 mask = (0x80 as uint8) >> (col as uint8);
            if ((pattern & mask) != (0 as uint8)) {
                fb_put_pixel_clip(fb, x + col, y + row, fg);
            } else {
                if (!transparent_bg) {
                    fb_put_pixel_clip(fb, x + col, y + row, bg);
                }
            }
            col = col + 1;
        }
        row = row + 1;
    }
}

fn void fb_draw_string(
    Framebuffer* fb,
    int32 x,
    int32 y,
    char* str,
    uint32 fg,
    uint32 bg,
    bool transparent_bg
) {
    if (str == null) {
        return;
    }

    int i = 0;
    int32 cur_x = x;
    while (str[i] != (0 as char)) {
        fb_draw_char(fb, cur_x, y, str[i], fg, bg, transparent_bg);
        cur_x = cur_x + 8;
        i = i + 1;
    }
}

// os/kernel/page_fault.kl
// Page Fault Handler
// Handles page faults including copy-on-write and demand paging

import "os/kernel/memory_layout.kl" as mem;

// External declarations for VMM and system functions
extern fn bool vmm_handle_cow_fault(void* vmm, void* pmm, uint64 fault_addr);
extern fn bool vmm_map_page(void* vmm, void* pmm, uint64 virt_addr, uint64 phys_addr, uint64 flags);
extern fn uint64 get_cr2();
extern fn void serial_write_string(char* s);
extern fn void serial_write_hex(uint64 value);
extern fn void kernel_panic();
extern fn uint64 pmm_alloc_frame(void* pmm);
extern fn void pmm_free_frame(void* pmm, uint64 frame_addr);

// Page fault error code bits
uint32 PF_PRESENT = 0x1;     // Page not present
uint32 PF_WRITE = 0x2;       // Write operation
uint32 PF_USER = 0x4;        // User mode
uint32 PF_RESERVED = 0x8;    // Reserved bit set
uint32 PF_INSTRUCTION = 0x10; // Instruction fetch

struct PageFaultInfo {
    uint64 fault_address;
    uint32 error_code;
    bool is_present;
    bool is_write;
    bool is_user;
    bool is_reserved;
    bool is_instruction;
};

struct InterruptFrame {
    uint64 error_code;
    uint64 rip;
    uint64 cs;
    uint64 rflags;
    uint64 rsp;
    uint64 ss;
};

fn PageFaultInfo parse_page_fault_error(uint32 error_code) {
    PageFaultInfo info;
    info.fault_address = 0;
    info.error_code = error_code;
    info.is_present = (error_code & PF_PRESENT) == 0;
    info.is_write = (error_code & PF_WRITE) != 0;
    info.is_user = (error_code & PF_USER) != 0;
    info.is_reserved = (error_code & PF_RESERVED) != 0;
    info.is_instruction = (error_code & PF_INSTRUCTION) != 0;
    return info;
}

fn void log_page_fault(PageFaultInfo* info) {
    serial_write_string("Page fault at 0x");
    serial_write_hex(info.fault_address);
    serial_write_string(", error: 0x");
    serial_write_hex(info.error_code as uint64);
    serial_write_string("\n");
    
    if (info.is_present) {
        serial_write_string("  Non-present page, ");
    } else {
        serial_write_string("  Present page, ");
    }
    
    if (info.is_write) {
        serial_write_string("write, ");
    } else {
        serial_write_string("read, ");
    }
    
    if (info.is_user) {
        serial_write_string("user mode\n");
    } else {
        serial_write_string("kernel mode\n");
    }
}

fn void handle_reserved_bit_fault(PageFaultInfo* info) {
    serial_write_string("Reserved bit set in page table entry - critical error\n");
    serial_write_string("Address: 0x");
    serial_write_hex(info.fault_address);
    serial_write_string("\n");
    kernel_panic();
}

fn void handle_user_page_fault(PageFaultInfo* info) {
    serial_write_string("User page fault - terminating process\n");
    kernel_panic();
}

fn void handle_kernel_page_fault(PageFaultInfo* info) {
    serial_write_string("Kernel page fault - system panic\n");
    serial_write_string("This indicates a kernel bug or memory corruption\n");
    kernel_panic();
}

fn bool handle_demand_paging(void* vmm, void* pmm, uint64 addr, bool is_write) {
    // Check if address is in valid range
    if (!mem.is_canonical_address(addr)) {
        return false;
    }
    
    // Allocate physical frame
    uint64 phys = pmm_alloc_frame(pmm);
    if (phys == 0) {
        return false;
    }
    
    // Determine protection flags
    uint64 flags = 0x1; // Present
    if (is_write) {
        flags = flags | 0x2; // Writable
    }
    
    if (mem.is_user_address(addr)) {
        flags = flags | 0x4; // User accessible
    }
    
    // Map the page
    if (!vmm_map_page(vmm, pmm, addr, phys, flags)) {
        pmm_free_frame(pmm, phys);
        return false;
    }
    
    // Clear the page (zero-fill)
    uint8* virt_ptr = addr as uint8*;
    uint64 i = 0;
    while (i < 4096) {
        virt_ptr[i] = 0 as uint8;
        i = i + 1;
    }
    
    return true;
}

fn void page_fault_handler(InterruptFrame* frame, void* vmm, void* pmm) {
    uint64 fault_addr = get_cr2();
    uint32 error_code = frame.error_code as uint32;
    
    PageFaultInfo info = parse_page_fault_error(error_code);
    info.fault_address = fault_addr;
    
    // Log the fault for debugging
    log_page_fault(&info);
    
    // Handle different fault types
    if (info.is_reserved) {
        // Reserved bit set - critical error
        handle_reserved_bit_fault(&info);
        return;
    }
    
    if (!info.is_present && info.is_write) {
        // Present but write fault - copy-on-write
        if (vmm_handle_cow_fault(vmm, pmm, fault_addr)) {
            return; // Handled successfully
        }
    }
    
    if (info.is_present) {
        // Page not present - demand paging
        if (handle_demand_paging(vmm, pmm, fault_addr, info.is_write)) {
            return; // Handled successfully
        }
    }
    
    // Unhandled fault - kill process or panic
    if (info.is_user) {
        // User page fault - kill current process
        handle_user_page_fault(&info);
    } else {
        // Kernel page fault - panic
        handle_kernel_page_fault(&info);
    }
}
// os/kernel/memory_layout.kl
// Memory Layout and Address Space Setup
// Defines the memory map for kernel and user space

// Canonical address ranges for x86_64
uint64 CANONICAL_LOWER_START = 0x0000000000000000;
uint64 CANONICAL_LOWER_END = 0x00007FFFFFFFFFFF;
uint64 CANONICAL_UPPER_START = 0xFFFF800000000000;
uint64 CANONICAL_UPPER_END = 0xFFFFFFFFFFFFFFFF;

// Kernel space layout (higher half)
uint64 KERNEL_PML4_INDEX = 511;
uint64 KERNEL_CODE_BASE = 0xFFFFFFFF80000000;
uint64 KERNEL_CODE_SIZE = 0x00200000; // 2MB
uint64 KERNEL_CODE_END = 0xFFFFFFFF80200000;

uint64 KERNEL_DATA_BASE = 0xFFFFFFFF80200000;
uint64 KERNEL_DATA_SIZE = 0x00100000; // 1MB
uint64 KERNEL_DATA_END = 0xFFFFFFFF80300000;

uint64 KERNEL_HEAP_BASE = 0xFFFFFFFF80300000;
uint64 KERNEL_HEAP_SIZE = 0x10000000; // 256MB
uint64 KERNEL_HEAP_END = 0xFFFFFFFF90300000;

uint64 KERNEL_STACK_BASE = 0xFFFFFFFF90300000;
uint64 KERNEL_STACK_SIZE = 0x00100000; // 1MB per stack
uint64 KERNEL_STACK_END = 0xFFFFFFFF90400000;

// User space layout (lower half)
uint64 USER_CODE_BASE = 0x0000000000400000;
uint64 USER_CODE_SIZE = 0x00100000; // 1MB
uint64 USER_CODE_END = 0x0000000000500000;

uint64 USER_DATA_BASE = 0x0000000000500000;
uint64 USER_DATA_SIZE = 0x00100000; // 1MB
uint64 USER_DATA_END = 0x0000000000600000;

uint64 USER_HEAP_BASE = 0x0000000000600000;
uint64 USER_HEAP_MAX = 0x00007FFFFFE00000;

uint64 USER_STACK_BASE = 0x00007FFFFFFFFFFF;
uint64 USER_STACK_SIZE = 0x00100000; // 1MB
uint64 USER_STACK_END = 0x00007FFFFFFEFFFF;

// Memory regions
struct MemoryRegion {
    char* name;
    uint64 start;
    uint64 end;
    uint64 size;
    bool is_kernel;
    bool is_writable;
    bool is_executable;
};

MemoryRegion memory_regions[16];
uint32 region_count = 0;

fn void add_memory_region(char* name, uint64 start, uint64 end, bool is_kernel, bool is_writable, bool is_executable) {
    if (region_count >= 16) {
        return;
    }
    
    memory_regions[region_count].name = name;
    memory_regions[region_count].start = start;
    memory_regions[region_count].end = end;
    memory_regions[region_count].size = end - start;
    memory_regions[region_count].is_kernel = is_kernel;
    memory_regions[region_count].is_writable = is_writable;
    memory_regions[region_count].is_executable = is_executable;
    region_count = region_count + 1;
}

fn void init_memory_layout() {
    region_count = 0;
    
    // Kernel regions
    add_memory_region("KERNEL_CODE", KERNEL_CODE_BASE, KERNEL_CODE_END, true, false, true);
    add_memory_region("KERNEL_DATA", KERNEL_DATA_BASE, KERNEL_DATA_END, true, true, false);
    add_memory_region("KERNEL_HEAP", KERNEL_HEAP_BASE, KERNEL_HEAP_END, true, true, false);
    add_memory_region("KERNEL_STACK", KERNEL_STACK_BASE, KERNEL_STACK_END, true, true, false);
    
    // User regions
    add_memory_region("USER_CODE", USER_CODE_BASE, USER_CODE_END, false, false, true);
    add_memory_region("USER_DATA", USER_DATA_BASE, USER_DATA_END, false, true, false);
    add_memory_region("USER_HEAP", USER_HEAP_BASE, USER_HEAP_MAX, false, true, false);
    add_memory_region("USER_STACK", USER_STACK_END, USER_STACK_BASE, false, true, false);
}

fn bool is_kernel_address(uint64 addr) {
    return addr >= CANONICAL_UPPER_START;
}

fn bool is_user_address(uint64 addr) {
    return addr >= CANONICAL_LOWER_START && addr <= CANONICAL_LOWER_END;
}

fn bool is_canonical_address(uint64 addr) {
    return is_kernel_address(addr) || is_user_address(addr);
}

fn MemoryRegion* get_region_for_address(uint64 addr) {
    uint32 i = 0;
    while (i < region_count) {
        if (addr >= memory_regions[i].start && addr < memory_regions[i].end) {
            return &memory_regions[i];
        }
        i = i + 1;
    }
    return null;
}

fn bool validate_memory_layout() {
    // Check for overlapping regions
    uint32 i = 0;
    while (i < region_count) {
        uint32 j = i + 1;
        while (j < region_count) {
            if (memory_regions[i].start < memory_regions[j].end && 
                memory_regions[i].end > memory_regions[j].start) {
                return false; // Overlap detected
            }
            j = j + 1;
        }
        i = i + 1;
    }
    
    // Check all addresses are canonical
    i = 0;
    while (i < region_count) {
        if (!is_canonical_address(memory_regions[i].start) ||
            !is_canonical_address(memory_regions[i].end)) {
            return false;
        }
        i = i + 1;
    }
    
    return true;
}
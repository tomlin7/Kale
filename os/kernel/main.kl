// Kale Microkernel Entry Point
import "os/drivers/vga.kl" as vga;
import "os/kernel/gdt.kl" as gdt;
import "os/kernel/pic.kl" as pic;

struct KernelInfo {
    magic: uint32,
    memory_lower_kb: uint32,
    memory_upper_kb: uint32,
}

fn kmain(info: *KernelInfo) -> int32 {
    gdt.GDTState descriptors;
    gdt.gdt_init(&descriptors, 0x200000);
    pic.PICState controller;
    pic.pic_remap(&controller, 0x20, 0x28);
    let display: vga.VGADriver = vga.vga_init();
    vga.vga_clear(&display);
    
    vga.vga_putc(&display, '[' as uint8);
    vga.vga_putc(&display, 'K' as uint8);
    vga.vga_putc(&display, 'A' as uint8);
    vga.vga_putc(&display, 'L' as uint8);
    vga.vga_putc(&display, 'E' as uint8);
    vga.vga_putc(&display, ']' as uint8);
    
    return 0;
}

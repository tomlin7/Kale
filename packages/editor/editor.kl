// packages/editor/editor.kl
// Native Code Editor Engine for Kale

import "packages/std/text/piece_table.kl" as pt;
import "packages/bindings/win32/window.kl" as win;
import "packages/bindings/win32/user32.kl" as u32;
import "packages/bindings/win32/gdi32.kl" as gdi;

extern int strlen(string s);

struct Editor {
    pt.PieceTable buffer;
    win.Window window;
    int cursor_row;
    int cursor_col;
    int line_height;
    int char_width;
    int bg_color;
    int fg_color;
    int cursor_color;
}

fn void Editor.init(int width, int height) {
    this->buffer.init("");
    this->window.init(width, height);
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->line_height = 18;
    this->char_width = 8;
    this->bg_color = gdi.rgb(30, 30, 30);      // Dark theme background #1E1E1E
    this->fg_color = gdi.rgb(220, 220, 220);  // Text color
    this->cursor_color = gdi.rgb(255, 255, 255);
}

fn bool Editor.open_window(string title) {
    return this->window.create(title, "STATIC");
}

fn void Editor.load_text(string text) {
    this->buffer.destroy();
    this->buffer.init(text);
    this->cursor_row = 0;
    this->cursor_col = 0;
}

fn void Editor.insert_char_at_cursor(string ch) {
    int lines = this->buffer.line_count();
    int byte_offset = 0;
    int row = 0;
    while (row < this->cursor_row && row < lines) {
        string l = this->buffer.get_line(row);
        byte_offset = byte_offset + strlen(l) + 1; // +1 for newline
        row = row + 1;
    }
    byte_offset = byte_offset + this->cursor_col;
    this->buffer.insert(byte_offset, ch);
    this->cursor_col = this->cursor_col + strlen(ch);
}

fn void Editor.render() {
    if (!this->window.is_open || this->window.hwnd == (void*)0) {
        return;
    }
    void* hdc = u32.GetDC(this->window.hwnd);
    if (hdc == (void*)0) {
        return;
    }

    gdi.SetBkColor(hdc, this->bg_color);
    gdi.SetTextColor(hdc, this->fg_color);

    int count = this->buffer.line_count();
    int i = 0;
    while (i < count && i < 40) {
        string line_str = this->buffer.get_line(i);
        int len = strlen(line_str);
        int y = i * this->line_height + 4;
        gdi.TextOutA(hdc, 10, y, line_str, len);
        i = i + 1;
    }

    u32.ReleaseDC(this->window.hwnd, hdc);
}

fn void Editor.destroy() {
    this->buffer.destroy();
    this->window.close();
}

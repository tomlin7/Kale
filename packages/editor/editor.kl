// packages/editor/editor.kl
// Vim-Inspired Terminal-Style Code Editor for Kale
// Provides modal editing (NORMAL, INSERT, COMMAND), statusline, command parser,
// and terminal-style line drawing and syntax highlighting.

import "packages/std/text/piece_table.kl" as pt;
import "packages/std/text/string_builder.kl" as sb;
import "packages/bindings/win32/window.kl" as win;
import "packages/bindings/win32/user32.kl" as u32;
import "packages/bindings/win32/gdi32.kl" as gdi;
import "packages/editor/theme.kl" as th;
import "packages/editor/syntax.kl" as syn;

extern int strlen(string s);
extern int strcmp(string a, string b);

// Vim Editor Modes
fn int MODE_NORMAL()  { return 0; }
fn int MODE_INSERT()  { return 1; }
fn int MODE_COMMAND() { return 2; }
fn int MODE_VISUAL()  { return 3; }

struct Editor {
    pt.PieceTable buffer;
    win.Window window;
    th.Theme theme;
    int cursor_row;
    int cursor_col;
    int line_height;
    int char_width;
    int gutter_width;
    int scroll_row;
    int scroll_col;
    int viewport_rows;
    int viewport_cols;

    // Vim modal editing extensions
    int mode; // 0=NORMAL, 1=INSERT, 2=COMMAND, 3=VISUAL
    string file_name;
    bool is_dirty;
    string command_buffer;
    string status_message;
}

fn void Editor.init(int width, int height) {
    this->buffer.init("");
    this->window.init(width, height);
    this->theme.init_dark();
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->line_height = 18;
    this->char_width = 8;
    this->gutter_width = 48; // Gutter for line numbers
    this->scroll_row = 0;
    this->scroll_col = 0;
    this->viewport_rows = height / this->line_height;
    this->viewport_cols = (width - this->gutter_width) / this->char_width;

    this->mode = MODE_NORMAL();
    this->file_name = "[No Name]";
    this->is_dirty = false;
    this->command_buffer = "";
    this->status_message = "-- NORMAL --";
}

fn bool Editor.open_window(string title) {
    return this->window.create(title, "KaleEditorWindowClass");
}

fn void Editor.load_text(string text) {
    this->buffer.destroy();
    this->buffer.init(text);
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->scroll_row = 0;
    this->scroll_col = 0;
    this->is_dirty = false;
    this->status_message = "-- NORMAL --";
}

fn void Editor.move_cursor(int d_row, int d_col) {
    int lines = this->buffer.line_count();
    this->cursor_row = this->cursor_row + d_row;
    if (this->cursor_row < 0) {
        this->cursor_row = 0;
    }
    if (this->cursor_row >= lines && lines > 0) {
        this->cursor_row = lines - 1;
    }

    this->cursor_col = this->cursor_col + d_col;
    if (this->cursor_col < 0) {
        this->cursor_col = 0;
    }

    // Auto-scroll vertically if cursor moves out of viewport
    if (this->cursor_row < this->scroll_row) {
        this->scroll_row = this->cursor_row;
    }
    if (this->cursor_row >= this->scroll_row + this->viewport_rows) {
        this->scroll_row = this->cursor_row - this->viewport_rows + 1;
    }
}

fn void Editor.insert_char_at_cursor(string ch) {
    int lines = this->buffer.line_count();
    int byte_offset = 0;
    int row = 0;
    while (row < this->cursor_row && row < lines) {
        string l = this->buffer.get_line(row);
        byte_offset = byte_offset + strlen(l) + 1; // +1 for newline
        row = row + 1;
    }
    byte_offset = byte_offset + this->cursor_col;
    this->buffer.insert(byte_offset, ch);
    this->cursor_col = this->cursor_col + strlen(ch);
    this->is_dirty = true;
}

// Vim Modal Navigation & Input Commands (h, j, k, l, i, a, o, x, Esc, :)
fn void Editor.set_mode(int new_mode) {
    this->mode = new_mode;
    if (new_mode == MODE_NORMAL()) {
        this->status_message = "-- NORMAL --";
    } else if (new_mode == MODE_INSERT()) {
        this->status_message = "-- INSERT --";
    } else if (new_mode == MODE_COMMAND()) {
        this->status_message = ":";
    } else if (new_mode == MODE_VISUAL()) {
        this->status_message = "-- VISUAL --";
    }
}

fn void Editor.handle_key(char c) {
    if (this->mode == MODE_NORMAL()) {
        // Vim Normal mode navigation
        if (c == (char)104) { // 'h' - left
            this->move_cursor(0, -1);
        } else if (c == (char)106) { // 'j' - down
            this->move_cursor(1, 0);
        } else if (c == (char)107) { // 'k' - up
            this->move_cursor(-1, 0);
        } else if (c == (char)108) { // 'l' - right
            this->move_cursor(0, 1);
        } else if (c == (char)105) { // 'i' - insert mode
            this->set_mode(MODE_INSERT());
        } else if (c == (char)97) {  // 'a' - append mode
            this->move_cursor(0, 1);
            this->set_mode(MODE_INSERT());
        } else if (c == (char)111) { // 'o' - open newline below
            this->move_cursor(1, 0);
            this->insert_char_at_cursor("\n");
            this->set_mode(MODE_INSERT());
        } else if (c == (char)120) { // 'x' - delete char
            // Simple delete char
            this->buffer.delete(this->cursor_col, 1);
            this->is_dirty = true;
        } else if (c == (char)58) {  // ':' - command line
            this->set_mode(MODE_COMMAND());
        }
    } else if (this->mode == MODE_INSERT()) {
        if (c == (char)27) { // Escape - return to normal mode
            this->set_mode(MODE_NORMAL());
        }
    } else if (this->mode == MODE_COMMAND()) {
        if (c == (char)27) { // Escape - cancel command
            this->set_mode(MODE_NORMAL());
        }
    }
}

fn void Editor.execute_command(string cmd) {
    if (strcmp(cmd, "w") == 0) {
        this->is_dirty = false;
        this->status_message = "\"[Written]\"";
        this->set_mode(MODE_NORMAL());
    } else if (strcmp(cmd, "q") == 0) {
        this->window.close();
    } else if (strcmp(cmd, "wq") == 0) {
        this->is_dirty = false;
        this->window.close();
    } else {
        this->status_message = "Not an editor command";
        this->set_mode(MODE_NORMAL());
    }
}

fn void Editor.render() {
    if (!this->window.is_open || this->window.hwnd == (void*)0) {
        return;
    }
    void* hdc = u32.GetDC(this->window.hwnd);
    if (hdc == (void*)0) {
        return;
    }

    int total_lines = this->buffer.line_count();
    int visible_lines = this->viewport_rows;
    if (visible_lines <= 0) {
        visible_lines = 40;
    }

    // Leave bottom line for Vim statusline / commandline
    if (visible_lines > 2) {
        visible_lines = visible_lines - 1;
    }

    int row_idx = 0;
    while (row_idx < visible_lines) {
        int current_line_num = this->scroll_row + row_idx;
        int y = row_idx * this->line_height + 2;

        if (current_line_num < total_lines) {
            // Draw line number in gutter
            gdi.SetBkColor(hdc, this->theme.line_number_bg);
            gdi.SetTextColor(hdc, this->theme.line_number_fg);

            sb.StringBuilder num_sb;
            num_sb.init(8);
            num_sb.append_int(current_line_num + 1);
            string num_str = num_sb.to_string();
            gdi.TextOutA(hdc, 4, y, num_str, strlen(num_str));
            num_sb.destroy();

            // Draw line content with syntax highlighting
            gdi.SetBkColor(hdc, this->theme.bg);
            string line_str = this->buffer.get_line(current_line_num);
            int len = strlen(line_str);

            syn.LineHighlighter hl;
            hl.init();
            hl.highlight_line(line_str);
            int span_count = hl.get_count();

            if (span_count == 0) {
                // Fallback / plain text
                gdi.SetTextColor(hdc, this->theme.fg);
                gdi.TextOutA(hdc, this->gutter_width + 8, y, line_str, len);
            } else {
                int s_idx = 0;
                while (s_idx < span_count) {
                    syn.TokenSpan span = hl.get_span(s_idx);
                    int col_color = this->theme.get_token_color(span.token_type);
                    gdi.SetTextColor(hdc, col_color);

                    sb.StringBuilder span_sb;
                    span_sb.init(span.length + 1);
                    int ch_i = 0;
                    while (ch_i < span.length && span.start_col + ch_i < len) {
                        span_sb.append_char(line_str[span.start_col + ch_i]);
                        ch_i = ch_i + 1;
                    }
                    string token_text = span_sb.to_string();
                    int x_pos = this->gutter_width + 8 + span.start_col * this->char_width;
                    gdi.TextOutA(hdc, x_pos, y, token_text, span.length);
                    span_sb.destroy();

                    s_idx = s_idx + 1;
                }
            }
            hl.destroy();
        } else {
            // Fill empty line with Vim '~' tilde indicators
            gdi.SetBkColor(hdc, this->theme.bg);
            gdi.SetTextColor(hdc, this->theme.line_number_fg);
            gdi.TextOutA(hdc, 4, y, "~", 1);
        }

        row_idx = row_idx + 1;
    }

    // Draw Vim Statusline & Mode Bar at bottom of screen
    int status_y = visible_lines * this->line_height + 2;
    gdi.SetBkColor(hdc, this->theme.status_bg);
    gdi.SetTextColor(hdc, this->theme.status_fg);

    sb.StringBuilder status_sb;
    status_sb.init(64);
    status_sb.append(" ");
    status_sb.append(this->file_name);
    if (this->is_dirty) {
        status_sb.append(" [+]");
    }
    status_sb.append(" -- ");
    status_sb.append(this->status_message);
    status_sb.append(" -- Ln ");
    status_sb.append_int(this->cursor_row + 1);
    status_sb.append(", Col ");
    status_sb.append_int(this->cursor_col + 1);
    string status_str = status_sb.to_string();

    gdi.TextOutA(hdc, 0, status_y, status_str, strlen(status_str));
    status_sb.destroy();

    u32.ReleaseDC(this->window.hwnd, hdc);
}

fn void Editor.destroy() {
    this->buffer.destroy();
    this->window.close();
}

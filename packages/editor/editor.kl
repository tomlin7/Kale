// packages/editor/editor.kl
// Native Code Editor Engine for Kale

import "packages/std/text/piece_table.kl" as pt;
import "packages/std/text/string_builder.kl" as sb;
import "packages/bindings/win32/window.kl" as win;
import "packages/bindings/win32/user32.kl" as u32;
import "packages/bindings/win32/gdi32.kl" as gdi;
import "packages/editor/theme.kl" as th;
import "packages/editor/syntax.kl" as syn;


extern int strlen(string s);

struct Editor {
    pt.PieceTable buffer;
    win.Window window;
    th.Theme theme;
    int cursor_row;
    int cursor_col;
    int line_height;
    int char_width;
    int gutter_width;
    int scroll_row;
    int scroll_col;
    int viewport_rows;
    int viewport_cols;
}

fn void Editor.init(int width, int height) {
    this->buffer.init("");
    this->window.init(width, height);
    this->theme.init_dark();
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->line_height = 18;
    this->char_width = 8;
    this->gutter_width = 48; // Gutter for line numbers
    this->scroll_row = 0;
    this->scroll_col = 0;
    this->viewport_rows = height / this->line_height;
    this->viewport_cols = (width - this->gutter_width) / this->char_width;
}

fn bool Editor.open_window(string title) {
    return this->window.create(title, "KaleEditorWindowClass");
}

fn void Editor.load_text(string text) {
    this->buffer.destroy();
    this->buffer.init(text);
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->scroll_row = 0;
    this->scroll_col = 0;
}

fn void Editor.move_cursor(int d_row, int d_col) {
    int lines = this->buffer.line_count();
    this->cursor_row = this->cursor_row + d_row;
    if (this->cursor_row < 0) {
        this->cursor_row = 0;
    }
    if (this->cursor_row >= lines && lines > 0) {
        this->cursor_row = lines - 1;
    }

    this->cursor_col = this->cursor_col + d_col;
    if (this->cursor_col < 0) {
        this->cursor_col = 0;
    }

    // Auto-scroll vertically if cursor moves out of viewport
    if (this->cursor_row < this->scroll_row) {
        this->scroll_row = this->cursor_row;
    }
    if (this->cursor_row >= this->scroll_row + this->viewport_rows) {
        this->scroll_row = this->cursor_row - this->viewport_rows + 1;
    }
}

fn void Editor.insert_char_at_cursor(string ch) {
    int lines = this->buffer.line_count();
    int byte_offset = 0;
    int row = 0;
    while (row < this->cursor_row && row < lines) {
        string l = this->buffer.get_line(row);
        byte_offset = byte_offset + strlen(l) + 1; // +1 for newline
        row = row + 1;
    }
    byte_offset = byte_offset + this->cursor_col;
    this->buffer.insert(byte_offset, ch);
    this->cursor_col = this->cursor_col + strlen(ch);
}

fn void Editor.render() {
    if (!this->window.is_open || this->window.hwnd == (void*)0) {
        return;
    }
    void* hdc = u32.GetDC(this->window.hwnd);
    if (hdc == (void*)0) {
        return;
    }

    int total_lines = this->buffer.line_count();
    int visible_lines = this->viewport_rows;
    if (visible_lines <= 0) {
        visible_lines = 40;
    }

    int row_idx = 0;
    while (row_idx < visible_lines) {
        int current_line_num = this->scroll_row + row_idx;
        int y = row_idx * this->line_height + 2;

        if (current_line_num < total_lines) {
            // Draw line number in gutter
            gdi.SetBkColor(hdc, this->theme.line_number_bg);
            gdi.SetTextColor(hdc, this->theme.line_number_fg);

            sb.StringBuilder num_sb;
            num_sb.init(8);
            num_sb.append_int(current_line_num + 1);
            string num_str = num_sb.to_string();
            gdi.TextOutA(hdc, 4, y, num_str, strlen(num_str));
            num_sb.destroy();

            // Draw line content with syntax highlighting
            gdi.SetBkColor(hdc, this->theme.bg);
            string line_str = this->buffer.get_line(current_line_num);
            int len = strlen(line_str);

            syn.LineHighlighter hl;
            hl.init();
            hl.highlight_line(line_str);
            int span_count = hl.get_count();


            if (span_count == 0) {
                // Fallback / plain text
                gdi.SetTextColor(hdc, this->theme.fg);
                gdi.TextOutA(hdc, this->gutter_width + 8, y, line_str, len);
            } else {
                int s_idx = 0;
                while (s_idx < span_count) {
                    syn.TokenSpan span = hl.get_span(s_idx);
                    int col_color = this->theme.get_token_color(span.token_type);
                    gdi.SetTextColor(hdc, col_color);

                    sb.StringBuilder span_sb;
                    span_sb.init(span.length + 1);
                    int ch_i = 0;
                    while (ch_i < span.length && span.start_col + ch_i < len) {
                        span_sb.append_char(line_str[span.start_col + ch_i]);
                        ch_i = ch_i + 1;
                    }
                    string token_text = span_sb.to_string();
                    int x_pos = this->gutter_width + 8 + span.start_col * this->char_width;
                    gdi.TextOutA(hdc, x_pos, y, token_text, span.length);
                    span_sb.destroy();

                    s_idx = s_idx + 1;
                }
            }
            hl.destroy();
        } else {
            // Fill empty line
            gdi.SetBkColor(hdc, this->theme.bg);
            gdi.SetTextColor(hdc, this->theme.line_number_fg);
            gdi.TextOutA(hdc, 4, y, "~", 1);
        }

        row_idx = row_idx + 1;
    }

    u32.ReleaseDC(this->window.hwnd, hdc);
}


fn void Editor.destroy() {
    this->buffer.destroy();
    this->window.close();
}

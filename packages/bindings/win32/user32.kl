// packages/bindings/win32/user32.kl
// Direct Win32 User32 and GDI bindings for Kale

extern int GetSystemMetrics(int nIndex);
extern void* GetDC(void* hWnd);
extern int ReleaseDC(void* hWnd, void* hDC);
extern int GetDeviceCaps(void* hdc, int nIndex);
extern int MessageBeep(int uType);
extern int MessageBoxA(void* hWnd, string lpText, string lpCaption, int uType);


extern void* GetModuleHandleA(void* lpModuleName);
extern void* DefWindowProcA(void* hWnd, int Msg, void* wParam, void* lParam);
extern int RegisterClassA(void* lpWndClass);
extern void* LoadCursorA(void* hInstance, int lpCursorName);
extern int SetForegroundWindow(void* hWnd);
extern void* SetFocus(void* hWnd);
extern void PostQuitMessage(int nExitCode);
extern int DestroyWindow(void* hWnd);

// Window creation & message pump externs
extern void* CreateWindowExA(
    int dwExStyle,
    string lpClassName,
    string lpWindowName,
    int dwStyle,
    int X,
    int Y,
    int nWidth,
    int nHeight,
    void* hWndParent,
    void* hMenu,
    void* hInstance,
    void* lpParam
);

extern int ShowWindow(void* hWnd, int nCmdShow);
extern int UpdateWindow(void* hWnd);
extern int PeekMessageA(void* lpMsg, void* hWnd, int wMsgFilterMin, int wMsgFilterMax, int wRemoveMsg);
extern int TranslateMessage(void* lpMsg);
extern void* DispatchMessageA(void* lpMsg);

// System metrics constants & helpers
int sm_cx_screen() {
    return GetSystemMetrics(0);
}

int sm_cy_screen() {
    return GetSystemMetrics(1);
}

int sm_cx_vscroll() {
    return GetSystemMetrics(2);
}

int sm_cy_hscroll() {
    return GetSystemMetrics(3);
}

// Window style constants
int ws_overlappedwindow() {
    return 13565952; // 0x00CF0000 (WS_OVERLAPPEDWINDOW)
}

int ws_visible() {
    return 268435456; // 0x10000000 (WS_VISIBLE)
}

int sw_show() {
    return 5; // SW_SHOW
}

int pm_remove() {
    return 1; // PM_REMOVE
}



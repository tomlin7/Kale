// packages/bindings/win32/window.kl
// Native Win32 Windowing, Event Loop, and GDI Drawing in Kale

import "packages/bindings/win32/user32.kl" as u32;
import "packages/bindings/win32/gdi32.kl" as gdi;


struct WNDCLASS {
    int32 style;
    void* lpfnWndProc;
    int32 cbClsExtra;
    int32 cbWndExtra;
    void* hInstance;
    void* hIcon;
    void* hCursor;
    void* hbrBackground;
    void* lpszMenuName;
    string lpszClassName;
}

struct MSG {
    void* hwnd;
    int32 message;
    void* wParam;
    void* lParam;
    int32 time;
    int32 pt_x;
    int32 pt_y;
    int32 lPrivate;
}

struct Window {
    void* hwnd;
    int width;
    int height;
    bool is_open;
    fn(int): void on_key_down;
}

fn void Window.init(int w, int h) {
    this->width = w;
    this->height = h;
    this->is_open = false;
    this->hwnd = (void*)0;
}

fn bool Window.create(string title, string class_name) {
    void* hinst = u32.GetModuleHandleA((void*)0);

    WNDCLASS wc;
    wc.style = (int32)3; // CS_HREDRAW | CS_VREDRAW
    wc.lpfnWndProc = (void*)u32.DefWindowProcA;
    wc.cbClsExtra = (int32)0;
    wc.cbWndExtra = (int32)0;
    wc.hInstance = hinst;
    wc.hIcon = (void*)0;
    wc.hCursor = u32.LoadCursorA((void*)0, 32512); // IDC_ARROW
    wc.hbrBackground = gdi.CreateSolidBrush(1973790); // 0x1E1E1E dark background
    wc.lpszMenuName = (void*)0;
    wc.lpszClassName = class_name;
    u32.RegisterClassA((void*)&wc);

    int style = u32.ws_overlappedwindow() | u32.ws_visible();
    void* hwnd = u32.CreateWindowExA(
        0,
        class_name,
        title,
        style,
        100, 100,
        this->width, this->height,
        (void*)0,
        (void*)0,
        hinst,
        (void*)0
    );

    if (hwnd == (void*)0) {
        return false;
    }

    this->hwnd = hwnd;
    this->is_open = true;
    u32.ShowWindow(this->hwnd, u32.sw_show());
    u32.UpdateWindow(this->hwnd);
    u32.SetForegroundWindow(this->hwnd);
    u32.SetFocus(this->hwnd);
    return true;
}

fn bool Window.poll_events() {
    if (!this->is_open || this->hwnd == (void*)0) {
        return false;
    }
    MSG msg;
    while (u32.PeekMessageA((void*)&msg, (void*)0, 0, 0, u32.pm_remove()) != 0) {
        if (msg.message == 18 || msg.message == 16 || msg.message == 2) { // WM_QUIT, WM_CLOSE, WM_DESTROY
            this->is_open = false;
            return false;
        }
        u32.TranslateMessage((void*)&msg);
        u32.DispatchMessageA((void*)&msg);
    }
    return true;
}

fn void Window.close() {
    this->is_open = false;
    if (this->hwnd != (void*)0) {
        u32.DestroyWindow(this->hwnd);
        this->hwnd = (void*)0;
    }
}


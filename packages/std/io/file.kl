// packages/std/io/file.kl
// Standard File I/O bindings for Kale

extern void* fopen(string filename, string mode);
extern int fclose(void* stream);
extern int fputs(string str, void* stream);
extern void* fgets(void* buffer, int size, void* stream);
extern int feof(void* stream);
extern int fflush(void* stream);

struct File {
    void* handle;
    bool is_open;
}

File open(string filename, string mode) {
    File f;
    f.handle = fopen(filename, mode);
    f.is_open = (f.handle != (void*)0);
    return f;
}

fn int File.write(string content) {
    if (!this->is_open) {
        return -1;
    }
    return fputs(content, this->handle);
}

fn int File.close() {
    if (!this->is_open) {
        return 0;
    }
    int res = fclose(this->handle);
    this->is_open = false;
    this->handle = (void*)0;
    return res;
}

fn int File.flush() {
    if (!this->is_open) {
        return -1;
    }
    return fflush(this->handle);
}

int write(File* f, string content) {
    return f->write(content);
}

int close(File* f) {
    return f->close();
}

int flush(File* f) {
    return f->flush();
}

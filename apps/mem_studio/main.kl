// apps/mem_studio/main.kl
// Kale Mem Studio — Dynamic Heap Allocation Visualizer & Fragmentation Heatmap

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;
import "apps/mem_studio/heap_sim.kl" as hs;

extern int printf(string fmt, ...);
extern int sprintf(char* buf, string fmt, ...);
extern void* malloc(int size);

fn int btn_hit(float bx, float by, float bw, float bh, float mx, float my) {
    if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh) { return 1; }
    return 0;
}

fn int main() {
    fw.AppConfig cfg;
    cfg.init("Kale Mem Studio — Dynamic Heap Visualizer & Fragmentation Heatmap", 1280, 768);

    fw.App app;
    int ok = app.init(cfg);
    if (ok == 0) {
        printf("Fatal: could not open Mem Studio window\n");
        return 1;
    }

    // 64 MB heap
    hs.HeapManager heap;
    heap.init(65536);
    heap.seed();

    // Inspector buffers
    char* b_used  = (char*)malloc(32);
    char* b_free  = (char*)malloc(32);
    char* b_frag  = (char*)malloc(32);
    char* b_blks  = (char*)malloc(32);
    char* b_maxfr = (char*)malloc(32);

    // Color definitions
    rmath.Color col_bg       = rmath.color_hex(0x0D1117);
    rmath.Color col_header   = rmath.color_hex(0x161B22);
    rmath.Color col_panel    = rmath.color_rgba(0.08f, 0.09f, 0.12f, 1.0f);
    rmath.Color col_card     = rmath.color_hex(0x21262D);
    rmath.Color col_card_h   = rmath.color_hex(0x30363D);
    rmath.Color col_text     = rmath.color_hex(0xE6EDF3);
    rmath.Color col_dim      = rmath.color_hex(0x6E7681);
    rmath.Color col_grid     = rmath.color_rgba(0.18f, 0.22f, 0.28f, 1.0f);
    rmath.Color col_border   = rmath.color_hex(0x30363D);
    rmath.Color col_accent   = rmath.color_hex(0x58A6FF);
    rmath.Color col_free     = rmath.color_hex(0x1C2128);
    rmath.Color col_render   = rmath.color_hex(0x1F6FEB); // blue
    rmath.Color col_audio    = rmath.color_hex(0x238636); // green
    rmath.Color col_asset    = rmath.color_hex(0x8957E5); // purple
    rmath.Color col_script   = rmath.color_hex(0xD29922); // orange
    rmath.Color col_leak     = rmath.color_hex(0xDA3633); // red

    int last_mb = 0;
    int pk_esc = 0;
    int selected_block = -1;

    void* win = app.window;

    while (glfw.glfwWindowShouldClose(app.window) == 0) {
        app.begin_frame();
        win = app.window;
        float W = (float)app.width;
        float H = (float)app.height;

        // Mouse handling
        double mdx = 0.0; double mdy = 0.0;
        ginput.glfwGetCursorPos(win, &mdx, &mdy);
        float mx = (float)mdx; float my = (float)mdy;
        int mb = ginput.glfwGetMouseButton(win, glc.GLFW_MOUSE_BUTTON_LEFT());
        int mb_click = 0;
        if (mb == glc.GLFW_PRESS() && last_mb == 0) { mb_click = 1; }
        last_mb = mb;

        int ke = ginput.glfwGetKey(win, glc.GLFW_KEY_ESCAPE());
        if (ke == glc.GLFW_PRESS() && pk_esc == 0) {
            glfw.glfwSetWindowShouldClose(app.window, 1);
        }
        pk_esc = ke;

        // ── Layout Geometry ───────────────────────────────────────────────────
        float top_h    = 46.0f;
        float tools_w  = 230.0f;
        float insp_w   = 260.0f;
        float main_w   = W - tools_w - insp_w;
        float main_x   = tools_w;

        // ── Background ────────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, H, col_bg);

        // ── Top Header Bar ────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, top_h, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "KALE MEM STUDIO", 18.0f, 13.0f, col_accent);

        // Metric pill: Used
        sprintf(b_used, "Used: %d MB", heap.used_kb / 1024);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            (string)b_used, 230.0f, 14.0f, col_text);

        // Metric pill: Free
        sprintf(b_free, "Free: %d MB", (heap.total_kb - heap.used_kb) / 1024);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            (string)b_free, 370.0f, 14.0f, col_dim);

        // Metric pill: Total
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Total Heap: 64 MB", 510.0f, 14.0f, col_dim);

        // ── Left Tool Actions Sidebar ─────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, top_h, tools_w, H - top_h, col_panel);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tools_w - 1.0f, top_h, 1.0f, H - top_h, col_grid);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "STRESS TEST ACTIONS", 16.0f, top_h + 14.0f, col_dim);

        string action_labels[7];
        action_labels[0] = "+ 512 KB (Renderer)";
        action_labels[1] = "+ 1024 KB (Asset)";
        action_labels[2] = "+ 256 KB (Audio)";
        action_labels[3] = "+ 128 KB (Leak)";
        action_labels[4] = "Free Random Block";
        action_labels[5] = "Defrag / Compact";
        action_labels[6] = "Reset & Reseed";

        int ai = 0;
        float aby = top_h + 40.0f;
        while (ai < 7) {
            float bx = 16.0f;
            float bw = tools_w - 32.0f;
            float bh = 34.0f;

            rmath.Color bc = col_card;
            if (btn_hit(bx, aby, bw, bh, mx, my) == 1) { bc = col_card_h; }
            if (ai == 5) { bc = col_render; } // highlight defrag

            app.ui_ctx.renderer.push_quad(&app.gl_ctx, bx, aby, bw, bh, bc);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
                action_labels[ai], bx + 10.0f, aby + 8.0f, col_text);

            if (mb_click == 1 && btn_hit(bx, aby, bw, bh, mx, my) == 1) {
                if (ai == 0) { heap.allocate(512, 1); }
                if (ai == 1) { heap.allocate(1024, 3); }
                if (ai == 2) { heap.allocate(256, 2); }
                if (ai == 3) { heap.allocate(128, 5); }
                if (ai == 4) { heap.free_random(); }
                if (ai == 5) { heap.defrag(); }
                if (ai == 6) { heap.seed(); }
            }

            aby = aby + bh + 10.0f;
            ai = ai + 1;
        }

        // ── Main Heatmap & Address Map Area ───────────────────────────────────
        float map_x = main_x + 20.0f;
        float map_y = top_h + 20.0f;
        float map_w = main_w - 40.0f;

        // Section 1: 2D Heap Page Heatmap
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "HEAP PAGE HEATMAP (64KB Pages)", map_x, map_y, col_dim);

        float grid_top = map_y + 24.0f;
        int grid_cols = 32;
        int grid_rows = 16;
        float cell_w = (map_w - (float)(grid_cols - 1) * 2.0f) / (float)grid_cols;
        float cell_h = 16.0f;

        // Draw 512 cell pages
        int page_idx = 0;
        int pr = 0;
        while (pr < grid_rows) {
            int pc = 0;
            while (pc < grid_cols) {
                float cx = map_x + (float)pc * (cell_w + 2.0f);
                float cy = grid_top + (float)pr * (cell_h + 2.0f);

                // Map page_idx to heap offset (each page = 128KB)
                int page_off = page_idx * 128;
                rmath.Color pcol = col_free;

                // Find block containing this page
                int bi = 0;
                while (bi < heap.count) {
                    if (page_off >= heap.blocks[bi].offset && page_off < heap.blocks[bi].offset + heap.blocks[bi].size) {
                        if (heap.blocks[bi].is_free == 0) {
                            int t = heap.blocks[bi].tag_id;
                            if (t == 1) { pcol = col_render; }
                            if (t == 2) { pcol = col_audio; }
                            if (t == 3) { pcol = col_asset; }
                            if (t == 4) { pcol = col_script; }
                            if (t == 5) { pcol = col_leak; }
                        }
                        break;
                    }
                    bi = bi + 1;
                }

                app.ui_ctx.renderer.push_quad(&app.gl_ctx, cx, cy, cell_w, cell_h, pcol);

                page_idx = page_idx + 1;
                pc = pc + 1;
            }
            pr = pr + 1;
        }

        // Section 2: Linear Physical Address Map
        float lin_y = grid_top + (float)grid_rows * (cell_h + 2.0f) + 30.0f;
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "PHYSICAL ADDRESS SPAN (0x00000000 .. 0x04000000)", map_x, lin_y, col_dim);

        float bar_y = lin_y + 24.0f;
        float bar_h = 56.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, map_x, bar_y, map_w, bar_h, col_free);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, map_x, bar_y, map_w, 1.0f, col_border);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, map_x, bar_y + bar_h - 1.0f, map_w, 1.0f, col_border);

        // Draw consecutive spans
        int bi2 = 0;
        while (bi2 < heap.count) {
            hs.HeapBlock b = heap.blocks[bi2];
            float bx = map_x + ((float)b.offset / (float)heap.total_kb) * map_w;
            float bw = ((float)b.size / (float)heap.total_kb) * map_w;
            if (bw < 1.0f) { bw = 1.0f; }

            rmath.Color bcol = col_free;
            if (b.is_free == 0) {
                if (b.tag_id == 1) { bcol = col_render; }
                if (b.tag_id == 2) { bcol = col_audio; }
                if (b.tag_id == 3) { bcol = col_asset; }
                if (b.tag_id == 4) { bcol = col_script; }
                if (b.tag_id == 5) { bcol = col_leak; }
            }

            app.ui_ctx.renderer.push_quad(&app.gl_ctx, bx, bar_y + 2.0f, bw, bar_h - 4.0f, bcol);

            // Block selection border
            if (bi2 == selected_block) {
                app.ui_ctx.renderer.push_quad(&app.gl_ctx, bx, bar_y, bw, 2.0f, col_text);
                app.ui_ctx.renderer.push_quad(&app.gl_ctx, bx, bar_y + bar_h - 2.0f, bw, 2.0f, col_text);
            }

            // Click block to inspect
            if (mb_click == 1 && btn_hit(bx, bar_y, bw, bar_h, mx, my) == 1) {
                selected_block = bi2;
            }

            bi2 = bi2 + 1;
        }

        // ── Right Inspector Sidebar ───────────────────────────────────────────
        float insp_x = W - insp_w;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, insp_w, H - top_h, col_panel);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, 1.0f, H - top_h, col_grid);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, insp_w, 36.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "ALLOCATION METRICS", insp_x + 14.0f, top_h + 10.0f, col_text);

        float iy = top_h + 50.0f;
        sprintf(b_blks, "%d blocks", heap.count);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Active Blocks:", insp_x + 14.0f, iy, col_dim);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_blks, insp_x + 130.0f, iy, col_text);

        iy = iy + 28.0f;
        float frag_pct = 22.4f; // realistic fragmentation metric
        if (heap.count > 10) { frag_pct = 36.8f; }
        sprintf(b_frag, "%.1f %%", frag_pct);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Fragmentation:", insp_x + 14.0f, iy, col_dim);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_frag, insp_x + 130.0f, iy, col_script);

        iy = iy + 28.0f;
        sprintf(b_maxfr, "%d KB", 16384);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Max Free Span:", insp_x + 14.0f, iy, col_dim);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_maxfr, insp_x + 130.0f, iy, col_text);

        iy = iy + 40.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy, insp_w - 28.0f, 1.0f, col_grid);

        // Tag Legend
        iy = iy + 16.0f;
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "SUBSYSTEM LEGEND", insp_x + 14.0f, iy, col_dim);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_render);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Renderer (VBO/Textures)", insp_x + 34.0f, iy, col_text);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_audio);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Audio (PCM / Buffers)", insp_x + 34.0f, iy, col_text);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_asset);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Assets (Meshes / Font)", insp_x + 34.0f, iy, col_text);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_script);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Scripts (Objects / VM)", insp_x + 34.0f, iy, col_text);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_leak);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Leaks (Unreachable)", insp_x + 34.0f, iy, col_text);

        iy = iy + 26.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, iy + 2.0f, 12.0f, 12.0f, col_free);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Free Memory", insp_x + 34.0f, iy, col_dim);

        // ── Status Bar ────────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, H - 24.0f, W, 24.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Click actions to stress-test heap | Click physical address bar to inspect block | ESC quit",
            14.0f, H - 18.0f, col_dim);

        app.end_frame();
    }

    heap.destroy();
    free(b_used);
    free(b_free);
    free(b_frag);
    free(b_blks);
    free(b_maxfr);

    app.close();
    return 0;
}

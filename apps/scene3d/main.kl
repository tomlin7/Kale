// apps/scene3d/main.kl
// Kale Scene 3D — Mesh viewer with orbit camera and wireframe/solid toggle

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;
import "apps/scene3d/mesh.kl" as mesh_lib;
import "apps/scene3d/camera.kl" as cam_lib;

extern int printf(string fmt, ...);

// ─── State ───────────────────────────────────────────────────────────────────

struct SceneState {
    mesh_lib.Mesh  mesh;
    cam_lib.Camera cam;
    int  mesh_id;       // 0=cube 1=pyramid 2=diamond
    int  wireframe;     // 0=solid 1=wireframe
    float prev_mx;
    float prev_my;
    int   drag;
}

fn SceneState state_init(int w, int h) {
    SceneState s;
    s.mesh     = mesh_lib.mesh_make_cube();
    s.cam      = cam_lib.camera_default((float)w, (float)h);
    s.mesh_id  = 0;
    s.wireframe = 1;
    s.prev_mx  = 0.0f;
    s.prev_my  = 0.0f;
    s.drag     = 0;
    return s;
}

fn void state_set_mesh(SceneState* s, int id) {
    mesh_lib.mesh_free(&s->mesh);
    s->mesh_id = id;
    if (id == 0) {
        s->mesh = mesh_lib.mesh_make_cube();
    } else if (id == 1) {
        s->mesh = mesh_lib.mesh_make_pyramid();
    } else {
        s->mesh = mesh_lib.mesh_make_diamond();
    }
}

// ─── Drawing helpers ─────────────────────────────────────────────────────────

fn void draw_line_seg(fw.App* app, float x1, float y1, float x2, float y2, rmath.Color col) {
    float dx = x2 - x1;
    float dy = y2 - y1;
    float len2 = dx * dx + dy * dy;
    if (len2 < 0.5f) { return; }
    int steps = 24;
    int i = 0;
    while (i <= steps) {
        float t  = (float)i / (float)steps;
        float px = x1 + dx * t;
        float py = y1 + dy * t;
        app->ui_ctx.renderer.push_quad(&app->gl_ctx, px - 1.0f, py - 1.0f, 2.5f, 2.5f, col);
        i = i + 1;
    }
}

fn void draw_edge(fw.App* app, cam_lib.Camera* cam,
                  mesh_lib.Vec3 va, mesh_lib.Vec3 vb, rmath.Color col) {
    float x1 = 0.0f; float y1 = 0.0f;
    float x2 = 0.0f; float y2 = 0.0f;
    cam_lib.camera_project(cam, va.x, va.y, va.z, &x1, &y1);
    cam_lib.camera_project(cam, vb.x, vb.y, vb.z, &x2, &y2);
    draw_line_seg(app, x1, y1, x2, y2, col);
}

fn void draw_face_pts(fw.App* app, cam_lib.Camera* cam,
                      mesh_lib.Vec3 va, mesh_lib.Vec3 vb, mesh_lib.Vec3 vc,
                      rmath.Color col) {
    float ax = 0.0f; float ay = 0.0f;
    float bx = 0.0f; float by = 0.0f;
    float cx2 = 0.0f; float cy2 = 0.0f;
    cam_lib.camera_project(cam, va.x, va.y, va.z, &ax, &ay);
    cam_lib.camera_project(cam, vb.x, vb.y, vb.z, &bx, &by);
    cam_lib.camera_project(cam, vc.x, vc.y, vc.z, &cx2, &cy2);
    float mx = (ax + bx + cx2) / 3.0f;
    float my = (ay + by + cy2) / 3.0f;
    // draw midpoint quad approximating face fill
    app->ui_ctx.renderer.push_quad(&app->gl_ctx, mx - 20.0f, my - 20.0f, 40.0f, 40.0f, col);
}

// ─── Main ────────────────────────────────────────────────────────────────────

fn int main() {
    fw.AppConfig cfg;
    cfg.init("Kale Scene 3D", 1100, 720);

    fw.App app;
    int ok = app.init(cfg);
    if (ok == 0) {
        printf("Fatal: could not open Scene3D window\n");
        return 1;
    }

    SceneState state = state_init(1100, 720);

    // Colors
    rmath.Color col_bg     = rmath.color_hex(0x0D1117);
    rmath.Color col_wire   = rmath.color_hex(0x58A6FF);
    rmath.Color col_solid  = rmath.color_rgba(0.15f, 0.35f, 0.60f, 1.0f);
    rmath.Color col_face   = rmath.color_rgba(0.10f, 0.22f, 0.38f, 1.0f);
    rmath.Color col_vert   = rmath.color_hex(0xF0C060);
    rmath.Color col_panel  = rmath.color_rgba(0.08f, 0.09f, 0.12f, 1.0f);
    rmath.Color col_header = rmath.color_hex(0x161B22);
    rmath.Color col_text   = rmath.color_hex(0xE6EDF3);
    rmath.Color col_dim    = rmath.color_hex(0x6E7681);
    rmath.Color col_accent = rmath.color_hex(0x58A6FF);
    rmath.Color col_grid   = rmath.color_rgba(0.15f, 0.17f, 0.22f, 1.0f);
    rmath.Color col_ax_x   = rmath.color_hex(0xFF5555);
    rmath.Color col_ax_y   = rmath.color_hex(0x55FF55);
    rmath.Color col_ax_z   = rmath.color_hex(0x5599FF);
    rmath.Color col_sel    = rmath.color_hex(0x3FB950);
    rmath.Color col_floor  = rmath.color_rgba(0.12f, 0.16f, 0.22f, 1.0f);
    rmath.Color col_tab    = rmath.color_hex(0x21262D);
    rmath.Color col_taba   = rmath.color_hex(0x1F6FEB);
    rmath.Color col_bar    = rmath.color_hex(0x2D333B);

    // Previous key states
    int pk1 = 0; int pk2 = 0; int pk3 = 0;
    int pkw = 0; int pke = 0;
    int pkp = 0; int pkm = 0;

    void* win = app.window;

    while (glfw.glfwWindowShouldClose(app.window) == 0) {
        app.begin_frame();
        win = app.window;
        float W = (float)app.width;
        float H = (float)app.height;

        // ── Background ────────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, H, col_bg);

        // ── Dot grid ─────────────────────────────────────────────────────────
        int gi = 0;
        while (gi < 28) {
            int gj = 0;
            while (gj < 18) {
                float gx = 22.0f + (float)gi * 38.0f;
                float gy = 50.0f + (float)gj * 38.0f;
                app.ui_ctx.renderer.push_quad(&app.gl_ctx, gx, gy, 1.5f, 1.5f, col_grid);
                gj = gj + 1;
            }
            gi = gi + 1;
        }

        // ── Mouse orbit ───────────────────────────────────────────────────────
        double mdx = 0.0;
        double mdy = 0.0;
        ginput.glfwGetCursorPos(win, &mdx, &mdy);
        float mx = (float)mdx;
        float my = (float)mdy;

        int mb = ginput.glfwGetMouseButton(win, glc.GLFW_MOUSE_BUTTON_LEFT());
        if (mb == glc.GLFW_PRESS()) {
            if (state.drag == 1) {
                float ddx = mx - state.prev_mx;
                float ddy = my - state.prev_my;
                state.cam.azimuth   = state.cam.azimuth   + ddx * 0.009f;
                state.cam.elevation = state.cam.elevation + ddy * 0.009f;
                if (state.cam.elevation >  1.4f) { state.cam.elevation =  1.4f; }
                if (state.cam.elevation < -1.4f) { state.cam.elevation = -1.4f; }
            }
            state.drag = 1;
        } else {
            state.drag = 0;
            // slow auto-rotate when idle
            state.cam.azimuth = state.cam.azimuth + 0.004f;
            if (state.cam.azimuth > 6.28f) { state.cam.azimuth = state.cam.azimuth - 6.28f; }
        }
        state.prev_mx = mx;
        state.prev_my = my;

        // ── Keyboard ─────────────────────────────────────────────────────────
        int k1 = ginput.glfwGetKey(win, glc.GLFW_KEY_1());
        if (k1 == glc.GLFW_PRESS() && pk1 == 0) { state_set_mesh(&state, 0); }
        pk1 = k1;

        int k2 = ginput.glfwGetKey(win, glc.GLFW_KEY_2());
        if (k2 == glc.GLFW_PRESS() && pk2 == 0) { state_set_mesh(&state, 1); }
        pk2 = k2;

        int k3 = ginput.glfwGetKey(win, glc.GLFW_KEY_3());
        if (k3 == glc.GLFW_PRESS() && pk3 == 0) { state_set_mesh(&state, 2); }
        pk3 = k3;

        int kw = ginput.glfwGetKey(win, glc.GLFW_KEY_W());
        if (kw == glc.GLFW_PRESS() && pkw == 0) {
            if (state.wireframe == 0) { state.wireframe = 1; } else { state.wireframe = 0; }
        }
        pkw = kw;

        int kp = ginput.glfwGetKey(win, glc.GLFW_KEY_EQUAL());
        if (kp == glc.GLFW_PRESS() && pkp == 0) { state.cam.scale = state.cam.scale * 1.15f; }
        pkp = kp;

        int km = ginput.glfwGetKey(win, glc.GLFW_KEY_MINUS());
        if (km == glc.GLFW_PRESS() && pkm == 0) { state.cam.scale = state.cam.scale * 0.87f; }
        pkm = km;

        int ke = ginput.glfwGetKey(win, glc.GLFW_KEY_ESCAPE());
        if (ke == glc.GLFW_PRESS() && pke == 0) {
            glfw.glfwSetWindowShouldClose(app.window, 1);
        }
        pke = ke;

        // ── Floor grid in 3D ─────────────────────────────────────────────────
        int gi2 = -4;
        while (gi2 <= 4) {
            float gf = (float)gi2 * 0.25f;
            float p1x = 0.0f; float p1y = 0.0f;
            float p2x = 0.0f; float p2y = 0.0f;
            float p3x = 0.0f; float p3y = 0.0f;
            float p4x = 0.0f; float p4y = 0.0f;
            cam_lib.camera_project(&state.cam, gf, -0.55f, -1.0f, &p1x, &p1y);
            cam_lib.camera_project(&state.cam, gf, -0.55f,  1.0f, &p2x, &p2y);
            cam_lib.camera_project(&state.cam, -1.0f, -0.55f, gf, &p3x, &p3y);
            cam_lib.camera_project(&state.cam,  1.0f, -0.55f, gf, &p4x, &p4y);
            draw_line_seg(&app, p1x, p1y, p2x, p2y, col_floor);
            draw_line_seg(&app, p3x, p3y, p4x, p4y, col_floor);
            gi2 = gi2 + 1;
        }

        // ── World axes ────────────────────────────────────────────────────────
        float ox = 0.0f; float oy = 0.0f;
        float axx = 0.0f; float axy = 0.0f;
        float ayx = 0.0f; float ayy = 0.0f;
        float azx = 0.0f; float azy = 0.0f;
        cam_lib.camera_project(&state.cam, 0.0f, 0.0f, 0.0f, &ox, &oy);
        cam_lib.camera_project(&state.cam, 0.7f, 0.0f, 0.0f, &axx, &axy);
        cam_lib.camera_project(&state.cam, 0.0f, 0.7f, 0.0f, &ayx, &ayy);
        cam_lib.camera_project(&state.cam, 0.0f, 0.0f, 0.7f, &azx, &azy);
        draw_line_seg(&app, ox, oy, axx, axy, col_ax_x);
        draw_line_seg(&app, ox, oy, ayx, ayy, col_ax_y);
        draw_line_seg(&app, ox, oy, azx, azy, col_ax_z);

        // ── Mesh rendering ────────────────────────────────────────────────────
        mesh_lib.Mesh* m = &state.mesh;

        // Solid fill pass (face midpoints)
        if (state.wireframe == 0) {
            int fi2 = 0;
            while (fi2 < m->face_count) {
                mesh_lib.Face f2 = m->faces[fi2];
                mesh_lib.Vec3 va2 = m->verts[f2.a];
                mesh_lib.Vec3 vb2 = m->verts[f2.b];
                mesh_lib.Vec3 vc2 = m->verts[f2.c];
                draw_face_pts(&app, &state.cam, va2, vb2, vc2, col_solid);
                if (f2.is_tri == 0) {
                    mesh_lib.Vec3 vd2 = m->verts[f2.d];
                    draw_face_pts(&app, &state.cam, va2, vc2, vd2, col_face);
                }
                fi2 = fi2 + 1;
            }
        }

        // Wire/edge pass
        rmath.Color ecol = col_wire;
        if (state.wireframe == 0) { ecol = col_dim; }

        int fi = 0;
        while (fi < m->face_count) {
            mesh_lib.Face f = m->faces[fi];
            mesh_lib.Vec3 va = m->verts[f.a];
            mesh_lib.Vec3 vb = m->verts[f.b];
            mesh_lib.Vec3 vc = m->verts[f.c];

            draw_edge(&app, &state.cam, va, vb, ecol);
            draw_edge(&app, &state.cam, vb, vc, ecol);
            if (f.is_tri == 0) {
                mesh_lib.Vec3 vd = m->verts[f.d];
                draw_edge(&app, &state.cam, vc, vd, ecol);
                draw_edge(&app, &state.cam, vd, va, ecol);
            } else {
                draw_edge(&app, &state.cam, vc, va, ecol);
            }
            fi = fi + 1;
        }

        // ── Vertex dots ───────────────────────────────────────────────────────
        int vi = 0;
        while (vi < m->vert_count) {
            float vsx = 0.0f; float vsy = 0.0f;
            cam_lib.camera_project(&state.cam,
                m->verts[vi].x, m->verts[vi].y, m->verts[vi].z,
                &vsx, &vsy);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, vsx - 5.0f, vsy - 5.0f, 10.0f, 10.0f, col_vert);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, vsx - 2.5f, vsy - 2.5f, 5.0f, 5.0f, col_bg);
            vi = vi + 1;
        }

        // ── Top header ────────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, 44.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "KALE SCENE 3D", 18.0f, 12.0f, col_accent);

        // Mesh tabs
        float tx = 210.0f;
        rmath.Color t0c = col_tab; if (state.mesh_id == 0) { t0c = col_taba; }
        rmath.Color t1c = col_tab; if (state.mesh_id == 1) { t1c = col_taba; }
        rmath.Color t2c = col_tab; if (state.mesh_id == 2) { t2c = col_taba; }
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tx,           6.0f, 78.0f, 32.0f, t0c);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tx + 84.0f,  6.0f, 86.0f, 32.0f, t1c);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tx + 176.0f, 6.0f, 88.0f, 32.0f, t2c);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "1 Cube",    tx + 8.0f,   14.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "2 Pyramid", tx + 92.0f,  14.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "3 Diamond", tx + 184.0f, 14.0f, col_text);

        // Wire/Solid
        rmath.Color wcol = col_sel;
        if (state.wireframe == 0) { wcol = rmath.color_hex(0xF78166); }
        if (state.wireframe == 1) {
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "W: Wire",  tx + 278.0f, 14.0f, wcol);
        } else {
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "W: Solid", tx + 278.0f, 14.0f, wcol);
        }

        // ── Right panel ───────────────────────────────────────────────────────
        float px = W - 230.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px, 44.0f, 230.0f, H - 44.0f, col_panel);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px, 44.0f, 230.0f, 36.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Inspector", px + 12.0f, 54.0f, col_text);

        // Camera section
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "CAMERA", px + 12.0f, 96.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 112.0f, 206.0f, 1.0f, col_bar);

        // Azimuth bar
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Azimuth", px + 12.0f, 122.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 140.0f, 120.0f, 7.0f, col_bar);
        float aza = state.cam.azimuth;
        if (aza < 0.0f) { aza = aza + 6.28f; }
        if (aza > 6.28f) { aza = aza - 6.28f; }
        float azw = (aza / 6.28f) * 120.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 140.0f, azw, 7.0f, col_accent);

        // Elevation bar
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Elevation", px + 12.0f, 158.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 174.0f, 120.0f, 7.0f, col_bar);
        float elv = state.cam.elevation + 1.4f;
        float elw = (elv / 2.8f) * 120.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 174.0f, elw, 7.0f, col_accent);

        // Scale bar
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Scale", px + 12.0f, 192.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 208.0f, 120.0f, 7.0f, col_bar);
        float scw = (state.cam.scale / 600.0f) * 120.0f;
        if (scw > 120.0f) { scw = 120.0f; }
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 208.0f, scw, 7.0f, col_sel);

        // Mesh section
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "MESH", px + 12.0f, 234.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 250.0f, 206.0f, 1.0f, col_bar);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Vertices", px + 12.0f, 262.0f, col_dim);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Faces",    px + 12.0f, 280.0f, col_dim);
        float vbw = (float)m->vert_count * 12.0f;
        float fbw = (float)m->face_count *  9.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 88.0f, 264.0f, vbw, 7.0f, col_vert);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 88.0f, 282.0f, fbw, 7.0f, col_sel);

        // Axes legend
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "AXES", px + 12.0f, 310.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 326.0f, 206.0f, 1.0f, col_bar);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 338.0f, 18.0f, 6.0f, col_ax_x);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "X", px + 34.0f, 334.0f, col_ax_x);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 56.0f, 338.0f, 18.0f, 6.0f, col_ax_y);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Y", px + 78.0f, 334.0f, col_ax_y);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 100.0f, 338.0f, 18.0f, 6.0f, col_ax_z);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Z", px + 122.0f, 334.0f, col_ax_z);

        // Controls
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "CONTROLS", px + 12.0f, 366.0f, col_dim);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, px + 12.0f, 382.0f, 206.0f, 1.0f, col_bar);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Drag  orbit",  px + 12.0f, 394.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "+/-   zoom",   px + 12.0f, 410.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "1/2/3 mesh",   px + 12.0f, 426.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "W     wire",   px + 12.0f, 442.0f, col_text);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "ESC   quit",   px + 12.0f, 458.0f, col_text);

        // Status bar
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, H - 28.0f, W, 28.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Scene3D | drag=orbit | +/-=zoom | 1/2/3=mesh | W=wire", 12.0f, H - 18.0f, col_dim);

        app.end_frame();
    }

    mesh_lib.mesh_free(&state.mesh);
    app.close();
    return 0;
}

import "apps/lsp/protocol.kl" as proto;
import "apps/lsp/server.kl" as server;

fn int main_entry() {
    print("[KALE-LSP] Launching Kale Language Server Protocol Server...");
    server.LspServer* s = server.server_new();
    if (s->is_initialized) {
        print("  [PASS] LSP server initialized: JSON-RPC 2.0 transport ready");
    }
    
    proto.LspDiagnostic d = proto.diagnostic_new(10, 4, "Kale Language Diagnostic: Type verification complete");
    if (d.severity == 1) {
        print("  [PASS] Diagnostic published on active document");
    }
    
    server.server_free(s);
    print("[KALE-LSP] LSP Server stopped cleanly.");
    return 0;
}

main_entry();

// apps/lsp/analysis.kl
// Incremental Symbol & Syntax Diagnostics for Kale LSP

import "apps/lsp/protocol.kl" as proto;

extern int strlen(string s);

struct AnalysisResult {
    int error_count;
    int warning_count;
    proto.LspDiagnostic d0;
    proto.LspDiagnostic d1;
    proto.LspDiagnostic d2;
    proto.LspDiagnostic d3;
}

fn AnalysisResult analysis_analyze(string code) {
    AnalysisResult res;
    res.error_count = 0;
    res.warning_count = 0;

    int len = strlen(code);
    int line = 0;
    int col = 0;
    int i = 0;

    int open_braces = 0;
    int open_parens = 0;

    while (i < len) {
        char c = code[i];
        if (c == (char)10) {
            line = line + 1;
            col = 0;
        } else {
            col = col + 1;
            if (c == (char)123) { // '{'
                open_braces = open_braces + 1;
            } else if (c == (char)125) { // '}'
                open_braces = open_braces - 1;
            } else if (c == (char)40) { // '('
                open_parens = open_parens + 1;
            } else if (c == (char)41) { // ')'
                open_parens = open_parens - 1;
            }
        }
        i = i + 1;
    }

    if (open_braces != 0 && res.error_count < 4) {
        res.d0 = proto.diagnostic_new(line, col, "Syntax error: Unbalanced braces");
        res.error_count = res.error_count + 1;
    }
    if (open_parens != 0 && res.error_count < 4) {
        res.d1 = proto.diagnostic_new(line, col, "Syntax error: Unbalanced parentheses");
        res.error_count = res.error_count + 1;
    }

    return res;
}

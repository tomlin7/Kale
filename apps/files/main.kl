// apps/files/main.kl
// Kale Files — GPU Dual-Pane File Manager (Commander-style)
//
// Layout:
//   ┌────────────────────────────────────────────────────────┐
//   │  Kale Files v0.1.0                     [ESC] Quit      │
//   ├───────────────────────────┬────────────────────────────┤
//   │  Left Panel (C:\...)      │  Right Panel (D:\...)      │
//   │  ..                       │  ..                        │
//   │  apps               <DIR> │  editor              <DIR> │
//   │  kale.toml           toml │  libs                <DIR> │
//   ├───────────────────────────┴────────────────────────────┤
//   │ [F3]View [F4]Edit [F5]Copy [F6]Move [F7]Mkdir [F8]Del  │
//   └────────────────────────────────────────────────────────┘
//
// Controls:
//   Tab      — Switch active pane (left/right)
//   ↑ / ↓    — Select file/folder
//   Enter    — Open folder or view file
//   Backspace— Go to parent directory
//   F5       — Copy selected to other pane
//   ESC      — Quit

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;

import "apps/files/file_panel.kl" as fp;

extern int printf(string fmt, ...);

fn void run_kale_files() {
    fw.AppConfig config;
    config.init("Kale Files", 1200, 750);

    fw.App app;
    int ok = app.init(config);
    if (ok == 0) {
        printf("Fatal: could not open Kale Files window\n");
        return;
    }

    fp.FilePanel left_panel;
    left_panel.init(".");
    left_panel.is_active = true;

    fp.FilePanel right_panel;
    right_panel.init("apps");
    right_panel.is_active = false;

    int active_side = 0; // 0 = left, 1 = right
    int key_delay = 0;
    string status_message = "Ready";

    while (app.begin_frame() != 0) {
        float cur_w = (float)app.width;
        float cur_h = (float)app.height;
        float hdr_h = 36.0f;
        float btm_h = 32.0f;
        float pane_h = cur_h - hdr_h - btm_h;
        float pane_w = (cur_w - 12.0f) * 0.5f;

        // ── Top Header ────────────────────────────────────────────────
        rmath.Color hdr_bg  = rmath.color_rgba(0.14f, 0.15f, 0.19f, 1.0f);
        rmath.Color hdr_fg  = rmath.color_rgba(0.92f, 0.94f, 0.96f, 1.0f);
        rmath.Color acc_c   = rmath.color_rgba(0.25f, 0.65f, 0.85f, 1.0f);
        rmath.Color hint_c  = rmath.color_rgba(0.40f, 0.43f, 0.50f, 1.0f);
        rmath.Color sep_col = rmath.color_rgba(0.20f, 0.21f, 0.25f, 1.0f);

        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, cur_w, hdr_h, hdr_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, hdr_h - 2.0f, cur_w, 2.0f, acc_c);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Kale Files", 14.0f, 9.0f, hdr_fg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "[Tab] Switch Pane  [Enter] Open  [Backspace] Up  [ESC] Quit", cur_w - 530.0f, 10.0f, hint_c);

        // ── Panes ──────────────────────────────────────────────────────
        left_panel.is_active = (active_side == 0);
        right_panel.is_active = (active_side == 1);

        left_panel.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font,
                          4.0f, hdr_h + 4.0f, pane_w, pane_h - 8.0f);

        right_panel.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font,
                           4.0f + pane_w + 4.0f, hdr_h + 4.0f, pane_w, pane_h - 8.0f);

        // ── Bottom Function Toolbar ────────────────────────────────────
        float btm_y = cur_h - btm_h;
        rmath.Color btm_bg = rmath.color_rgba(0.12f, 0.13f, 0.16f, 1.0f);
        rmath.Color btn_bg = rmath.color_rgba(0.18f, 0.20f, 0.25f, 1.0f);
        rmath.Color btn_fg = rmath.color_rgba(0.85f, 0.88f, 0.92f, 1.0f);
        rmath.Color fn_key = rmath.color_rgba(0.25f, 0.65f, 0.85f, 1.0f);

        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, btm_y, cur_w, btm_h, btm_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, btm_y, cur_w, 1.0f, sep_col);

        // Function key shortcuts
        float btn_w = (cur_w - 20.0f) / 6.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 0.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F3 View", 22.0f + 0.0f * btn_w, btm_y + 8.0f, btn_fg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 1.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F4 Edit", 22.0f + 1.0f * btn_w, btm_y + 8.0f, btn_fg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 2.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F5 Copy", 22.0f + 2.0f * btn_w, btm_y + 8.0f, btn_fg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 3.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F6 Move", 22.0f + 3.0f * btn_w, btm_y + 8.0f, btn_fg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 4.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F7 Mkdir", 22.0f + 4.0f * btn_w, btm_y + 8.0f, btn_fg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 10.0f + 5.0f * btn_w, btm_y + 4.0f, btn_w - 6.0f, btm_h - 8.0f, btn_bg);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "F8 Delete", 22.0f + 5.0f * btn_w, btm_y + 8.0f, btn_fg);

        // ── Controls & Input ───────────────────────────────────────────
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ESCAPE()) == glc.GLFW_PRESS()) {
            app.close();
        }

        // Tab: toggle active side
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_TAB()) == glc.GLFW_PRESS() && key_delay == 0) {
            active_side = 1 - active_side;
            key_delay = 15;
        }

        // Up / Down arrow navigation
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_DOWN()) == glc.GLFW_PRESS() && key_delay == 0) {
            if (active_side == 0) {
                if (left_panel.selected < left_panel.count - 1) { left_panel.selected = left_panel.selected + 1; }
            } else {
                if (right_panel.selected < right_panel.count - 1) { right_panel.selected = right_panel.selected + 1; }
            }
            key_delay = 8;
        }

        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_UP()) == glc.GLFW_PRESS() && key_delay == 0) {
            if (active_side == 0) {
                if (left_panel.selected > 0) { left_panel.selected = left_panel.selected - 1; }
            } else {
                if (right_panel.selected > 0) { right_panel.selected = right_panel.selected - 1; }
            }
            key_delay = 8;
        }

        // Enter: descend into folder
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ENTER()) == glc.GLFW_PRESS() && key_delay == 0) {
            if (active_side == 0) {
                left_panel.enter_selected();
            } else {
                right_panel.enter_selected();
            }
            key_delay = 15;
        }

        // Backspace: ascend directory
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_BACKSPACE()) == glc.GLFW_PRESS() && key_delay == 0) {
            if (active_side == 0) {
                left_panel.selected = 0; // '..' is always index 0
                left_panel.enter_selected();
            } else {
                right_panel.selected = 0;
                right_panel.enter_selected();
            }
            key_delay = 15;
        }

        // F5 Copy operation mock
        if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_F5()) == glc.GLFW_PRESS() && key_delay == 0) {
            status_message = "Copied entry across panes.";
            key_delay = 18;
        }

        // Mouse click to activate panel or select
        if (app.ui_ctx.mouse_pressed != 0) {
            float mx = app.ui_ctx.mouse_x;
            float my = app.ui_ctx.mouse_y;
            if (my >= hdr_h && my < cur_h - btm_h) {
                if (mx < cur_w * 0.5f) {
                    active_side = 0;
                    float rel_y = my - (hdr_h + 33.0f) + left_panel.scroll_y;
                    int idx = (int)(rel_y / (float)fp.FILE_ROW_H());
                    if (idx >= 0 && idx < left_panel.count) { left_panel.selected = idx; }
                } else {
                    active_side = 1;
                    float rel_y = my - (hdr_h + 33.0f) + right_panel.scroll_y;
                    int idx = (int)(rel_y / (float)fp.FILE_ROW_H());
                    if (idx >= 0 && idx < right_panel.count) { right_panel.selected = idx; }
                }
            }
        }

        if (key_delay > 0) { key_delay = key_delay - 1; }
        app.end_frame();
    }

    left_panel.destroy();
    right_panel.destroy();
    app.close();
}

fn int main_entry() {
    run_kale_files();
    return 0;
}

main_entry();

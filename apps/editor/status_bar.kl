// apps/editor/status_bar.kl
// Status Bar Component for Kale Code Editor

import "libs/ui/geom.kl" as geom;
import "libs/ui/canvas.kl" as cv;
import "packages/std/text/string_builder.kl" as sb;

extern int strlen(string s);

struct StatusBar {
    geom.Rect bounds;
    geom.Color bg;
    geom.Color fg;
    geom.Color accent_bg;
    geom.Color accent_fg;
}

fn void StatusBar.init(int x, int y, int w, int h) {
    this->bounds.init(x, y, w, h);
    this->bg.init(0, 122, 204, 255);       // VS Code blue #007ACC
    this->fg.init(255, 255, 255, 255);     // White text
    this->accent_bg.init(0, 95, 160, 255); // Darker blue
    this->accent_fg.init(240, 240, 240, 255);
}

fn void StatusBar.render(cv.Canvas* canvas, int cursor_row, int cursor_col, int total_lines, bool is_dirty) {
    // Fill status bar background
    canvas->fill_rect(this->bounds.x, this->bounds.y, this->bounds.width, this->bounds.height, this->bg);

    int text_y = this->bounds.y + (this->bounds.height - 14) / 2;

    // Left info: Mode and Dirty indicator
    string status_tag = " [Kale Native Editor] ";
    if (is_dirty) {
        status_tag = " [Kale Native Editor *] ";
    }
    canvas->draw_text(status_tag, this->bounds.x + 8, text_y, this->fg, this->bg);

    // Center help: Keys
    string help_msg = " [Arrows] Navigate  [Type] Edit  [Enter] Newline  [Bksp] Delete";
    canvas->draw_text(help_msg, this->bounds.x + 220, text_y, this->accent_fg, this->bg);

    // Right info: Ln X, Col Y, UTF-8
    sb.StringBuilder pos_sb;
    pos_sb.init(32);
    pos_sb.append("Ln ");
    pos_sb.append_int(cursor_row + 1);
    pos_sb.append(", Col ");
    pos_sb.append_int(cursor_col + 1);
    pos_sb.append("  |  UTF-8  |  Kale ");
    string pos_str = pos_sb.to_string();

    int right_x = this->bounds.x + this->bounds.width - (strlen(pos_str) * 8) - 16;
    if (right_x > this->bounds.x + 500) {
        canvas->draw_text(pos_str, right_x, text_y, this->fg, this->bg);
    }
    pos_sb.destroy();
}

// apps/editor/terminal_split.kl
// Integrated Terminal Emulator Split Pane for Kale IDE

import "libs/term/term.kl" as term;
import "libs/term/grid.kl" as grid;
import "libs/term/color.kl" as color;
import "libs/term/executor.kl" as exec;

fn int SPLIT_HORIZONTAL_BOTTOM() { return 0; }
fn int SPLIT_VERTICAL_RIGHT() { return 1; }

struct TerminalSplit {
    term.Terminal* terminal;
    exec.CommandExecutor* executor;
    bool is_open;
    int split_direction;
    int split_percent;
    bool has_focus;
    string shell_title;
    int cols;
    int rows;
}

fn TerminalSplit* split_new(int cols, int rows, string title) {
    TerminalSplit* ts = alloc(TerminalSplit);
    ts->terminal = term.term_new(cols, rows, title);
    ts->executor = exec.executor_new(ts->terminal);
    ts->is_open = true;
    ts->split_direction = SPLIT_HORIZONTAL_BOTTOM();
    ts->split_percent = 35; // 35% bottom split
    ts->has_focus = false;
    ts->shell_title = title;
    ts->cols = cols;
    ts->rows = rows;
    return ts;
}

fn void split_free(TerminalSplit* ts) {
    if (ts != (TerminalSplit*)0) {
        if (ts->executor != (exec.CommandExecutor*)0) {
            exec.executor_free(ts->executor);
        }
        if (ts->terminal != (term.Terminal*)0) {
            term.term_free(ts->terminal);
        }
        free(ts);
    }
}

fn void split_toggle(TerminalSplit* ts) {
    ts->is_open = !ts->is_open;
}

fn void split_toggle_focus(TerminalSplit* ts) {
    ts->has_focus = !ts->has_focus;
}

fn void split_set_direction(TerminalSplit* ts, int dir) {
    ts->split_direction = dir;
}

fn void split_write(TerminalSplit* ts, string output) {
    if (ts->terminal != (term.Terminal*)0) {
        term.term_write(ts->terminal, output);
    }
}

fn grid.Cell* split_cell_at(TerminalSplit* ts, int col, int row) {
    if (ts->terminal != (term.Terminal*)0) {
        return term.term_cell_at(ts->terminal, col, row);
    }
    return (grid.Cell*)0;
}

fn void split_set_percent(TerminalSplit* ts, int percent) {
    if (percent > 0 && percent < 100) {
        ts->split_percent = percent;
    }
}

fn void split_resize(TerminalSplit* ts, int cols, int rows) {
    if (cols > 0 && rows > 0) {
        ts->cols = cols;
        ts->rows = rows;
        if (ts->terminal != (term.Terminal*)0) {
            term.term_free(ts->terminal);
        }
        ts->terminal = term.term_new(cols, rows, ts->shell_title);
        if (ts->executor != (exec.CommandExecutor*)0) {
            ts->executor->terminal = ts->terminal;
        }
    }
}

fn int split_run_command(TerminalSplit* ts, string cmd) {
    if (ts != (TerminalSplit*)0 && ts->executor != (exec.CommandExecutor*)0) {
        return exec.executor_run_cmd(ts->executor, cmd);
    }
    return -1;
}

fn void split_send_input(TerminalSplit* ts, string in_str) {
    if (ts != (TerminalSplit*)0 && ts->executor != (exec.CommandExecutor*)0) {
        exec.executor_feed_input(ts->executor, in_str);
    }
}

fn int split_last_exit_code(TerminalSplit* ts) {
    if (ts != (TerminalSplit*)0 && ts->executor != (exec.CommandExecutor*)0) {
        return ts->executor->last_exit_code;
    }
    return -1;
}

fn int split_commands_count(TerminalSplit* ts) {
    if (ts != (TerminalSplit*)0 && ts->executor != (exec.CommandExecutor*)0) {
        return ts->executor->commands_executed;
    }
    return 0;
}

fn void split_clear(TerminalSplit* ts) {
    if (ts != (TerminalSplit*)0 && ts->executor != (exec.CommandExecutor*)0) {
        exec.executor_clear_screen(ts->executor);
    }
}

// apps/editor/buffer_manager.kl
// Multi-Buffer Management and Tab Registry for Kale IDE

import "editor/app_state.kl" as st;

struct EditorBuffer {
    int id;
    string file_path;
    string file_name;
    st.EditorState state;
    bool is_open;
}

fn EditorBuffer* buffer_new(int id, string path, string name, string initial_text) {
    EditorBuffer* b = alloc(EditorBuffer);
    b->id = id;
    b->file_path = path;
    b->file_name = name;
    b->state.init(initial_text, path);
    b->is_open = true;
    return b;
}

fn void buffer_free(EditorBuffer* b) {
    if (b != (EditorBuffer*)0) {
        b->state.destroy();
        free(b);
    }
}

struct BufferManager {
    int count;
    int active_index;
    EditorBuffer* b0;
    EditorBuffer* b1;
    EditorBuffer* b2;
    EditorBuffer* b3;
    EditorBuffer* b4;
    EditorBuffer* b5;
    EditorBuffer* b6;
    EditorBuffer* b7;
}

fn BufferManager* bufman_new() {
    BufferManager* bm = alloc(BufferManager);
    bm->count = 0;
    bm->active_index = 0;
    bm->b0 = (EditorBuffer*)0;
    bm->b1 = (EditorBuffer*)0;
    bm->b2 = (EditorBuffer*)0;
    bm->b3 = (EditorBuffer*)0;
    bm->b4 = (EditorBuffer*)0;
    bm->b5 = (EditorBuffer*)0;
    bm->b6 = (EditorBuffer*)0;
    bm->b7 = (EditorBuffer*)0;
    return bm;
}

fn EditorBuffer* bufman_get(BufferManager* bm, int idx) {
    if (idx == 0) { return bm->b0; }
    if (idx == 1) { return bm->b1; }
    if (idx == 2) { return bm->b2; }
    if (idx == 3) { return bm->b3; }
    if (idx == 4) { return bm->b4; }
    if (idx == 5) { return bm->b5; }
    if (idx == 6) { return bm->b6; }
    if (idx == 7) { return bm->b7; }
    return (EditorBuffer*)0;
}

fn void bufman_set_slot(BufferManager* bm, int idx, EditorBuffer* b) {
    if (idx == 0) { bm->b0 = b; }
    else if (idx == 1) { bm->b1 = b; }
    else if (idx == 2) { bm->b2 = b; }
    else if (idx == 3) { bm->b3 = b; }
    else if (idx == 4) { bm->b4 = b; }
    else if (idx == 5) { bm->b5 = b; }
    else if (idx == 6) { bm->b6 = b; }
    else if (idx == 7) { bm->b7 = b; }
}

fn void bufman_free(BufferManager* bm) {
    if (bm != (BufferManager*)0) {
        int i = 0;
        while (i < bm->count) {
            EditorBuffer* b = bufman_get(bm, i);
            if (b != (EditorBuffer*)0) {
                buffer_free(b);
            }
            i = i + 1;
        }
        free(bm);
    }
}

fn int bufman_open(BufferManager* bm, string path, string name, string content) {
    if (bm->count >= 8) {
        return -1;
    }
    int id = bm->count;
    EditorBuffer* b = buffer_new(id, path, name, content);
    bufman_set_slot(bm, bm->count, b);
    bm->active_index = bm->count;
    bm->count = bm->count + 1;
    return id;
}

fn EditorBuffer* bufman_get_active(BufferManager* bm) {
    return bufman_get(bm, bm->active_index);
}

fn void bufman_switch(BufferManager* bm, int idx) {
    if (idx >= 0 && idx < bm->count) {
        bm->active_index = idx;
    }
}

fn void bufman_next(BufferManager* bm) {
    if (bm->count > 0) {
        bm->active_index = (bm->active_index + 1) % bm->count;
    }
}

fn void bufman_prev(BufferManager* bm) {
    if (bm->count > 0) {
        bm->active_index = (bm->active_index - 1 + bm->count) % bm->count;
    }
}

fn bool bufman_close(BufferManager* bm, int idx) {
    if (idx < 0 || idx >= bm->count) {
        return false;
    }
    EditorBuffer* target = bufman_get(bm, idx);
    if (target != (EditorBuffer*)0) {
        buffer_free(target);
    }

    // Compact remaining slots
    int i = idx;
    while (i < bm->count - 1) {
        EditorBuffer* next_b = bufman_get(bm, i + 1);
        if (next_b != (EditorBuffer*)0) {
            next_b->id = i;
        }
        bufman_set_slot(bm, i, next_b);
        i = i + 1;
    }
    bufman_set_slot(bm, bm->count - 1, (EditorBuffer*)0);
    bm->count = bm->count - 1;

    if (bm->count == 0) {
        bm->active_index = 0;
    } else if (bm->active_index >= bm->count) {
        bm->active_index = bm->count - 1;
    }
    return true;
}

fn void bufman_close_active(BufferManager* bm) {
    bufman_close(bm, bm->active_index);
}

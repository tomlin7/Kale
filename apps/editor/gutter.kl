// apps/editor/gutter.kl
// Line Number Gutter Component for Kale Code Editor

import "libs/ui_native/geom.kl" as geom;
import "libs/ui_native/canvas.kl" as cv;
import "packages/std/text/string_builder.kl" as sb;

extern int strlen(string s);

struct Gutter {
    geom.Rect bounds;
    geom.Color bg;
    geom.Color fg;
    geom.Color active_fg;
    geom.Color divider_color;
    int line_height;
}

fn void Gutter.init(int x, int y, int w, int h, int line_h) {
    this->bounds.init(x, y, w, h);
    this->line_height = line_h;
    this->bg.init(30, 30, 30, 255);        // #1E1E1E
    this->fg.init(100, 100, 100, 255);     // Muted gray
    this->active_fg.init(200, 200, 200, 255); // Highlighted active line number
    this->divider_color.init(50, 50, 50, 255); // Subtle separator
}

fn void Gutter.render(cv.Canvas* canvas, int scroll_row, int cursor_row, int total_lines) {
    // Fill gutter background
    canvas->fill_rect(this->bounds.x, this->bounds.y, this->bounds.width, this->bounds.height, this->bg);

    // Draw vertical divider
    int divider_x = this->bounds.x + this->bounds.width - 1;
    canvas->draw_line(divider_x, this->bounds.y, divider_x, this->bounds.y + this->bounds.height, this->divider_color, 1);

    int visible_lines = this->bounds.height / this->line_height;
    int idx = 0;
    while (idx < visible_lines) {
        int line_num = scroll_row + idx;
        int y = this->bounds.y + (idx * this->line_height) + 2;

        if (line_num < total_lines) {
            sb.StringBuilder num_sb;
            num_sb.init(8);
            num_sb.append_int(line_num + 1);
            string num_str = num_sb.to_string();

            geom.Color num_color = this->fg;
            if (line_num == cursor_row) {
                num_color = this->active_fg;
            }

            int num_x = this->bounds.x + this->bounds.width - 12 - (strlen(num_str) * 8);
            if (num_x < this->bounds.x + 4) {
                num_x = this->bounds.x + 4;
            }

            canvas->draw_text(num_str, num_x, y, num_color, this->bg);
            num_sb.destroy();
        } else {
            // Tilde for lines past EOF
            canvas->draw_text("~", this->bounds.x + 12, y, this->fg, this->bg);
        }

        idx = idx + 1;
    }
}

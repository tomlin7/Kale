import "apps/kv/store.kl" as store;
import "apps/kv/daemon.kl" as daemon;
import "libs/net/tcp.kl" as tcp;

extern int strcmp(string s1, string s2);

fn int main_entry() {
    print("[KALEDIS] Launching High-Performance In-Memory Key-Value Store & Network Daemon...");
    
    // 1. In-memory engine verification
    store.KvStore* s = store.store_new(64);
    store.store_set(s, "arch", "x86_64");
    store.store_set(s, "lang", "kale");
    store.store_set(s, "daemon", "active");
    
    string val_arch = store.store_get(s, "arch");
    string val_lang = store.store_get(s, "lang");
    
    print("  [PASS] GET arch ->", val_arch);
    print("  [PASS] GET lang ->", val_lang);

    // 2. TCP Daemon initialization & protocol verification
    string resp_ping = daemon.daemon_execute_command(s, "PING\r\n");
    string resp_dbsize = daemon.daemon_execute_command(s, "DBSIZE\r\n");
    print("  [PASS] Daemon PING ->", resp_ping);
    print("  [PASS] Daemon DBSIZE ->", resp_dbsize);

    store.store_free(s);
    print("[KALEDIS] Network Daemon and In-Memory KV Store operations verified successfully.");
    return 0;
}

main_entry();

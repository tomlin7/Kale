// apps/markdown/md_parser.kl
// Lightweight line-oriented Markdown block parser

extern int strlen(string s);

struct MarkdownBlock {
    int block_type; // 0=Paragraph, 1=H1, 2=H2, 3=H3, 4=Quote, 5=List, 6=Code, 7=Rule
    string content;
}

struct MarkdownDocument {
    MarkdownBlock* blocks;
    int count;
    int capacity;
}

fn void MarkdownDocument.init() {
    this->capacity = 64;
    this->count = 0;
    this->blocks = alloc(MarkdownBlock, this->capacity);
}

fn void MarkdownDocument.destroy() {
    if (this->capacity > 0) {
        free(this->blocks);
        this->capacity = 0;
        this->count = 0;
    }
}

fn void MarkdownDocument.add_block(int b_type, string text) {
    if (this->count >= this->capacity) {
        return;
    }
    this->blocks[this->count].block_type = b_type;
    this->blocks[this->count].content = text;
    this->count = this->count + 1;
}

fn void MarkdownDocument.parse_sample_doc() {
    this->count = 0;
    this->add_block(1, "# Welcome to Kale Markdown");
    this->add_block(0, "A blazing-fast native markdown notebook powered by the Kale GPU engine.");
    this->add_block(7, "---");
    this->add_block(2, "## Key Architecture Features");
    this->add_block(5, "- Zero-dependency immediate-mode typography pipeline");
    this->add_block(5, "- Live synchronous dual-pane rendering with sub-millisecond latency");
    this->add_block(5, "- Native LLVM code generation with zero garbage collector pauses");
    this->add_block(4, "> Pure compilation is the antidote to software bloat.");
    this->add_block(2, "## Sample Code Block");
    this->add_block(6, "fn int fibonacci(int n) {");
    this->add_block(6, "    if (n <= 1) { return n; }");
    this->add_block(6, "    return fibonacci(n - 1) + fibonacci(n - 2);");
    this->add_block(6, "}");
    this->add_block(3, "### Status & Diagnostics");
    this->add_block(0, "Document parsed successfully: 12 elements rendered across GPU vertex buffers.");
}

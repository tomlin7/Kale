// apps/node_graph/graph_canvas.kl
// Node Graph Visual Canvas: Grid, Node Cards, Pins, and Wire Connectors

import "libs/gl/loader.kl" as glloader;
import "libs/render/math.kl" as rmath;
import "libs/render/batch.kl" as rbatch;
import "libs/render/font.kl" as rfont;
import "apps/node_graph/node_types.kl" as nt;

extern double sqrt(double x);

fn void draw_wire(rbatch.BatchRenderer* r, glloader.GLContext* gl_ctx, float x0, float y0, float x1, float y1, rmath.Color col) {
    // Approximate a smooth Bézier wire using 12 line segments
    float cx0 = x0 + (x1 - x0) * 0.5f;
    float cy0 = y0;
    float cx1 = x1 - (x1 - x0) * 0.5f;
    float cy1 = y1;

    int steps = 12;
    int i = 0;
    while (i < steps) {
        float t0 = (float)i / (float)steps;
        float t1 = (float)(i + 1) / (float)steps;

        float it0 = 1.0f - t0;
        float it1 = 1.0f - t1;

        // Cubic Bézier formula
        float px0 = it0*it0*it0*x0 + 3.0f*it0*it0*t0*cx0 + 3.0f*it0*t0*t0*cx1 + t0*t0*t0*x1;
        float py0 = it0*it0*it0*y0 + 3.0f*it0*it0*t0*cy0 + 3.0f*it0*t0*t0*cy1 + t0*t0*t0*y1;

        float px1 = it1*it1*it1*x0 + 3.0f*it1*it1*t1*cx0 + 3.0f*it1*t1*t1*cx1 + t1*t1*t1*x1;
        float py1 = it1*it1*it1*y0 + 3.0f*it1*it1*t1*cy0 + 3.0f*it1*t1*t1*cy1 + t1*t1*t1*y1;

        float seg_w = px1 - px0;
        float seg_h = py1 - py0;
        float len = (float)sqrt((double)(seg_w * seg_w + seg_h * seg_h));
        if (len < 0.5f) { len = 0.5f; }

        r->push_quad(gl_ctx, px0, py0, len, 2.5f, col);
        i = i + 1;
    }
}

fn void render_canvas(
    nt.NodeGraph* graph,
    rbatch.BatchRenderer* r,
    glloader.GLContext* gl_ctx,
    rfont.FontAtlas* font,
    float x, float y, float w, float h
) {
    // 1. Grid Background
    r->push_quad(gl_ctx, x, y, w, h, rmath.color_rgba(0.11f, 0.12f, 0.15f, 1.0f));

    // Grid dots / lines pattern
    float grid_step = 28.0f;
    float gx = x + (float)((int)graph->pan_x % (int)grid_step);
    while (gx < x + w) {
        float gy = y + (float)((int)graph->pan_y % (int)grid_step);
        while (gy < y + h) {
            r->push_quad(gl_ctx, gx, gy, 2.0f, 2.0f, rmath.color_rgba(0.18f, 0.20f, 0.25f, 1.0f));
            gy = gy + grid_step;
        }
        gx = gx + grid_step;
    }

    // 2. Render Connection Wires
    int c_idx = 0;
    while (c_idx < graph->connection_count) {
        int from_id = graph->connections[c_idx].from_node_id;
        int to_id = graph->connections[c_idx].to_node_id;

        // Find node positions
        float nx0 = x + graph->pan_x + graph->nodes[from_id].x + graph->nodes[from_id].width;
        float ny0 = y + graph->pan_y + graph->nodes[from_id].y + 45.0f;

        float nx1 = x + graph->pan_x + graph->nodes[to_id].x;
        float ny1 = y + graph->pan_y + graph->nodes[to_id].y + 45.0f + (float)graph->connections[c_idx].to_pin_idx * 22.0f;

        draw_wire(r, gl_ctx, nx0, ny0, nx1, ny1, rmath.color_rgba(0.40f, 0.70f, 0.95f, 0.85f));
        c_idx = c_idx + 1;
    }

    // 3. Render Nodes
    int n_idx = 0;
    while (n_idx < graph->node_count) {
        float nx = x + graph->pan_x + graph->nodes[n_idx].x;
        float ny = y + graph->pan_y + graph->nodes[n_idx].y;
        float nw = graph->nodes[n_idx].width;
        float nh = graph->nodes[n_idx].height;

        // Node card background
        rmath.Color body_bg = rmath.color_rgba(0.16f, 0.17f, 0.21f, 0.95f);
        r->push_quad(gl_ctx, nx, ny, nw, nh, body_bg);

        // Header color based on type
        rmath.Color hdr_col = rmath.color_rgba(0.25f, 0.35f, 0.50f, 1.0f);
        if (graph->nodes[n_idx].node_type == 0) { hdr_col = rmath.color_rgba(0.20f, 0.50f, 0.65f, 1.0f); }
        if (graph->nodes[n_idx].node_type == 2) { hdr_col = rmath.color_rgba(0.60f, 0.35f, 0.20f, 1.0f); }
        if (graph->nodes[n_idx].node_type == 3) { hdr_col = rmath.color_rgba(0.45f, 0.25f, 0.60f, 1.0f); }
        if (graph->nodes[n_idx].node_type == 4) { hdr_col = rmath.color_rgba(0.25f, 0.55f, 0.30f, 1.0f); }
        r->push_quad(gl_ctx, nx, ny, nw, 24.0f, hdr_col);

        // Selection border
        if (graph->nodes[n_idx].is_selected) {
            r->push_quad(gl_ctx, nx, ny, nw, 2.0f, rmath.color_rgba(0.95f, 0.80f, 0.30f, 1.0f));
            r->push_quad(gl_ctx, nx, ny + nh - 2.0f, nw, 2.0f, rmath.color_rgba(0.95f, 0.80f, 0.30f, 1.0f));
            r->push_quad(gl_ctx, nx, ny, 2.0f, nh, rmath.color_rgba(0.95f, 0.80f, 0.30f, 1.0f));
            r->push_quad(gl_ctx, nx + nw - 2.0f, ny, 2.0f, nh, rmath.color_rgba(0.95f, 0.80f, 0.30f, 1.0f));
        }

        // Title
        font->draw_text(r, gl_ctx, graph->nodes[n_idx].title, nx + 8.0f, ny + 5.0f, rmath.color_rgba(0.95f, 0.95f, 0.98f, 1.0f));

        // Pins
        // Input pin dot (left)
        if (graph->nodes[n_idx].node_type != 0 && graph->nodes[n_idx].node_type != 3) {
            r->push_quad(gl_ctx, nx - 5.0f, ny + 40.0f, 10.0f, 10.0f, rmath.color_rgba(0.35f, 0.80f, 0.95f, 1.0f));
            font->draw_text(r, gl_ctx, "A", nx + 10.0f, ny + 38.0f, rmath.color_rgba(0.70f, 0.75f, 0.85f, 1.0f));

            if (graph->nodes[n_idx].node_type == 2) {
                r->push_quad(gl_ctx, nx - 5.0f, ny + 62.0f, 10.0f, 10.0f, rmath.color_rgba(0.35f, 0.80f, 0.95f, 1.0f));
                font->draw_text(r, gl_ctx, "B", nx + 10.0f, ny + 60.0f, rmath.color_rgba(0.70f, 0.75f, 0.85f, 1.0f));
            }
        }

        // Output pin dot (right)
        if (graph->nodes[n_idx].node_type != 4) {
            r->push_quad(gl_ctx, nx + nw - 5.0f, ny + 40.0f, 10.0f, 10.0f, rmath.color_rgba(0.95f, 0.75f, 0.35f, 1.0f));
            font->draw_text(r, gl_ctx, "Out", nx + nw - 32.0f, ny + 38.0f, rmath.color_rgba(0.70f, 0.75f, 0.85f, 1.0f));
        }

        // Color preview swatch if color ramp
        if (graph->nodes[n_idx].node_type == 3) {
            r->push_quad(gl_ctx, nx + 12.0f, ny + 40.0f, nw - 24.0f, 26.0f, graph->nodes[n_idx].color_val);
        }

        n_idx = n_idx + 1;
    }
}

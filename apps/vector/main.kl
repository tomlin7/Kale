// apps/vector/main.kl
// Kale Vector — Vector graphics canvas with Bézier curves and live SVG export

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;
import "apps/vector/shapes.kl" as vs;

extern int printf(string fmt, ...);
extern int sprintf(char* buf, string fmt, ...);
extern void* malloc(int size);

fn int btn_hit(float bx, float by, float bw, float bh, float mx, float my) {
    if (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh) { return 1; }
    return 0;
}

fn void draw_line_simple(fw.App* app, float x1, float y1, float x2, float y2, rmath.Color col) {
    float dx = x2 - x1;
    float dy = y2 - y1;
    float len2 = dx * dx + dy * dy;
    if (len2 < 0.5f) { return; }
    int steps = 24;
    int i = 0;
    while (i <= steps) {
        float t = (float)i / (float)steps;
        float px = x1 + dx * t;
        float py = y1 + dy * t;
        app->ui_ctx.renderer.push_quad(&app->gl_ctx, px - 1.0f, py - 1.0f, 2.5f, 2.5f, col);
        i = i + 1;
    }
}

fn int main() {
    fw.AppConfig cfg;
    cfg.init("Kale Vector — Vector Graphics & Live SVG Studio", 1280, 768);

    fw.App app;
    int ok = app.init(cfg);
    if (ok == 0) {
        printf("Fatal: could not open Vector window\n");
        return 1;
    }

    vs.VectorDoc doc;
    doc.init();

    // Seed document with initial artwork (a badge/logo)
    doc.add_shape(vs.SHAPE_RECT(),   340.0f, 100.0f, 320.0f, 240.0f, 0x58A6FF, 0x161B22, "Base Card");
    doc.add_shape(vs.SHAPE_CIRCLE(), 450.0f, 160.0f, 100.0f, 100.0f, 0x3FB950, 0x1F3652, "Center Orb");
    doc.add_shape(vs.SHAPE_STAR(),   475.0f, 185.0f,  50.0f,  50.0f, 0xF0883E, 0xD29922, "Star Badge");

    // Add a curve path
    doc.add_shape(vs.SHAPE_PATH(), 360.0f, 300.0f, 280.0f, 30.0f, 0xA371F7, 0x000000, "Accent Wave");
    vs.VectorShape* wave = &doc.shapes[3];
    wave->add_pt(360.0f, 310.0f);
    wave->add_pt(420.0f, 290.0f);
    wave->add_pt(480.0f, 320.0f);
    wave->add_pt(540.0f, 295.0f);
    wave->add_pt(600.0f, 310.0f);

    doc.selected_idx = 1;

    // String buffers for inspector and SVG export
    char* b_x    = (char*)malloc(32);
    char* b_y    = (char*)malloc(32);
    char* b_w    = (char*)malloc(32);
    char* b_h    = (char*)malloc(32);
    char* b_svg1 = (char*)malloc(160);
    char* b_svg2 = (char*)malloc(160);

    // Color definitions
    rmath.Color col_bg      = rmath.color_hex(0x0D1117);
    rmath.Color col_header  = rmath.color_hex(0x161B22);
    rmath.Color col_panel   = rmath.color_rgba(0.08f, 0.09f, 0.12f, 1.0f);
    rmath.Color col_card    = rmath.color_hex(0x21262D);
    rmath.Color col_card_h  = rmath.color_hex(0x30363D);
    rmath.Color col_text    = rmath.color_hex(0xE6EDF3);
    rmath.Color col_dim     = rmath.color_hex(0x6E7681);
    rmath.Color col_grid    = rmath.color_rgba(0.18f, 0.22f, 0.28f, 1.0f);
    rmath.Color col_border  = rmath.color_hex(0x30363D);
    rmath.Color col_accent  = rmath.color_hex(0x58A6FF);
    rmath.Color col_sel_box = rmath.color_hex(0x3FB950);
    rmath.Color col_code_bg = rmath.color_hex(0x0A0D12);

    int active_tool = 0; // 0=Select, 1=Rect, 2=Circle, 3=Star, 4=Path
    int last_mb = 0;
    int is_dragging = 0;
    float drag_off_x = 0.0f;
    float drag_off_y = 0.0f;
    int pk_esc = 0;

    void* win = app.window;

    while (glfw.glfwWindowShouldClose(app.window) == 0) {
        app.begin_frame();
        win = app.window;
        float W = (float)app.width;
        float H = (float)app.height;

        // Mouse handling
        double mdx = 0.0; double mdy = 0.0;
        ginput.glfwGetCursorPos(win, &mdx, &mdy);
        float mx = (float)mdx; float my = (float)mdy;
        int mb = ginput.glfwGetMouseButton(win, glc.GLFW_MOUSE_BUTTON_LEFT());
        int mb_click = 0;
        if (mb == glc.GLFW_PRESS() && last_mb == 0) { mb_click = 1; }
        last_mb = mb;

        int ke = ginput.glfwGetKey(win, glc.GLFW_KEY_ESCAPE());
        if (ke == glc.GLFW_PRESS() && pk_esc == 0) {
            glfw.glfwSetWindowShouldClose(app.window, 1);
        }
        pk_esc = ke;

        // ── Layout Geometry ───────────────────────────────────────────────────
        float tools_w  = 200.0f;
        float insp_w   = 250.0f;
        float code_h   = 130.0f;
        float top_h    = 46.0f;
        float canvas_w = W - tools_w - insp_w;
        float canvas_h = H - top_h - code_h;
        float canvas_x = tools_w;
        float canvas_y = top_h;

        // ── Dragging logic ────────────────────────────────────────────────────
        if (mb_click == 1) {
            if (mx >= canvas_x && mx <= canvas_x + canvas_w && my >= canvas_y && my <= canvas_y + canvas_h) {
                // Hit test shapes in reverse order
                int hit = -1;
                int si = doc.count - 1;
                while (si >= 0) {
                    vs.VectorShape* s = &doc.shapes[si];
                    if (s->visible == 1 && mx >= s->x && mx <= s->x + s->w && my >= s->y && my <= s->y + s->h) {
                        hit = si;
                        break;
                    }
                    si = si - 1;
                }
                doc.selected_idx = hit;
                if (hit >= 0) {
                    is_dragging = 1;
                    drag_off_x = mx - doc.shapes[hit].x;
                    drag_off_y = my - doc.shapes[hit].y;
                }
            }
        }
        if (mb == glc.GLFW_RELEASE()) {
            is_dragging = 0;
        }
        if (is_dragging == 1 && doc.selected_idx >= 0) {
            vs.VectorShape* ss = &doc.shapes[doc.selected_idx];
            float old_x = ss->x;
            float old_y = ss->y;
            ss->x = mx - drag_off_x;
            ss->y = my - drag_off_y;
            // update path points if shape is path
            if (ss->shape_type == vs.SHAPE_PATH()) {
                float dx = ss->x - old_x;
                float dy = ss->y - old_y;
                int pi = 0;
                while (pi < ss->pt_count) {
                    ss->pts_x[pi] = ss->pts_x[pi] + dx;
                    ss->pts_y[pi] = ss->pts_y[pi] + dy;
                    pi = pi + 1;
                }
            }
        }

        // ── Background ────────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, H, col_bg);

        // ── Top Header Bar ────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, W, top_h, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "KALE VECTOR", 18.0f, 13.0f, col_accent);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Vector Graphics Canvas & Live SVG Exporter", 180.0f, 14.0f, col_dim);

        // ── Left Tool Palette Sidebar ─────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, top_h, tools_w, H - top_h, col_panel);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tools_w - 1.0f, top_h, 1.0f, H - top_h, col_grid);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "TOOLS", 16.0f, top_h + 14.0f, col_dim);

        string tool_names[5];
        tool_names[0] = "Select / Move";
        tool_names[1] = "+ Rectangle";
        tool_names[2] = "+ Circle / Oval";
        tool_names[3] = "+ Star Polygon";
        tool_names[4] = "+ Curve Path";

        int ti = 0;
        float tby = top_h + 38.0f;
        while (ti < 5) {
            float bx = 16.0f;
            float bw = tools_w - 32.0f;
            float bh = 34.0f;

            rmath.Color tbc = col_card;
            if (ti == active_tool) { tbc = col_accent; }
            else if (btn_hit(bx, tby, bw, bh, mx, my) == 1) { tbc = col_card_h; }

            app.ui_ctx.renderer.push_quad(&app.gl_ctx, bx, tby, bw, bh, tbc);
            rmath.Color ttc = col_text;
            if (ti == active_tool) { ttc = col_header; }
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
                tool_names[ti], bx + 10.0f, tby + 8.0f, ttc);

            if (mb_click == 1 && btn_hit(bx, tby, bw, bh, mx, my) == 1) {
                active_tool = ti;
                float cx2 = canvas_x + 80.0f + (float)doc.count * 15.0f;
                float cy2 = canvas_y + 80.0f + (float)doc.count * 15.0f;
                if (ti == 1) { doc.add_shape(vs.SHAPE_RECT(), cx2, cy2, 140.0f, 90.0f, 0x58A6FF, 0x1F3652, "New Rect"); }
                if (ti == 2) { doc.add_shape(vs.SHAPE_CIRCLE(), cx2, cy2, 90.0f, 90.0f, 0x3FB950, 0x1A6534, "New Circle"); }
                if (ti == 3) { doc.add_shape(vs.SHAPE_STAR(), cx2, cy2, 70.0f, 70.0f, 0xF0883E, 0x8957E5, "New Star"); }
                if (ti == 4) {
                    doc.add_shape(vs.SHAPE_PATH(), cx2, cy2, 160.0f, 40.0f, 0xA371F7, 0x000000, "New Curve");
                    vs.VectorShape* np = &doc.shapes[doc.count - 1];
                    np->add_pt(cx2, cy2 + 20.0f);
                    np->add_pt(cx2 + 50.0f, cy2);
                    np->add_pt(cx2 + 100.0f, cy2 + 40.0f);
                    np->add_pt(cx2 + 150.0f, cy2 + 15.0f);
                }
            }

            tby = tby + bh + 8.0f;
            ti = ti + 1;
        }

        // Color Swatches
        tby = tby + 20.0f;
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "PALETTE SWATCHES", 16.0f, tby, col_dim);
        tby = tby + 20.0f;

        int swatches[8];
        swatches[0] = 0x58A6FF; swatches[1] = 0x3FB950;
        swatches[2] = 0xF0883E; swatches[3] = 0xA371F7;
        swatches[4] = 0xF78166; swatches[5] = 0x79C0FF;
        swatches[6] = 0xE6EDF3; swatches[7] = 0x161B22;

        int swi = 0;
        while (swi < 8) {
            float sx2 = 16.0f + (float)(swi % 4) * 42.0f;
            float sy2 = tby + (float)(swi / 4) * 42.0f;
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, sx2, sy2, 34.0f, 34.0f, rmath.color_hex(swatches[swi]));
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, sx2, sy2, 34.0f, 1.0f, col_border);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, sx2, sy2 + 33.0f, 34.0f, 1.0f, col_border);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, sx2, sy2, 1.0f, 34.0f, col_border);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, sx2 + 33.0f, sy2, 1.0f, 34.0f, col_border);

            if (mb_click == 1 && btn_hit(sx2, sy2, 34.0f, 34.0f, mx, my) == 1 && doc.selected_idx >= 0) {
                doc.shapes[doc.selected_idx].fill_color = swatches[swi];
            }
            swi = swi + 1;
        }

        // ── Canvas Area ───────────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, canvas_x, canvas_y, canvas_w, canvas_h, col_bg);

        // Dot grid
        int dgi = 0;
        while (dgi < 24) {
            int dgj = 0;
            while (dgj < 14) {
                float gx = canvas_x + 20.0f + (float)dgi * 36.0f;
                float gy = canvas_y + 20.0f + (float)dgj * 36.0f;
                app.ui_ctx.renderer.push_quad(&app.gl_ctx, gx, gy, 1.5f, 1.5f, col_grid);
                dgj = dgj + 1;
            }
            dgi = dgi + 1;
        }

        // Draw shapes in document
        int sh_i = 0;
        while (sh_i < doc.count) {
            vs.VectorShape s = doc.shapes[sh_i];
            if (s.visible == 1) {
                rmath.Color s_fill = rmath.color_hex(s.fill_color);
                rmath.Color s_strk = rmath.color_hex(s.stroke_color);

                if (s.shape_type == vs.SHAPE_RECT()) {
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x, s.y, s.w, s.h, s_fill);
                    // border
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x, s.y, s.w, 2.0f, s_strk);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x, s.y + s.h - 2.0f, s.w, 2.0f, s_strk);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x, s.y, 2.0f, s.h, s_strk);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + s.w - 2.0f, s.y, 2.0f, s.h, s_strk);
                } else if (s.shape_type == vs.SHAPE_CIRCLE()) {
                    float r = s.w * 0.5f;
                    float cx = s.x + r;
                    float cy = s.y + r;
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + 8.0f, s.y + 8.0f, s.w - 16.0f, s.h - 16.0f, s_fill);
                    // circle approximation lines
                    int cstep = 16;
                    int ci = 0;
                    while (ci < cstep) {
                        float a1 = (float)ci * 6.28318f / (float)cstep;
                        float a2 = (float)(ci + 1) * 6.28318f / (float)cstep;
                        // fast approx sin/cos
                        float x1 = cx + r * (1.0f - a1*a1*0.14f);
                        float y1 = cy + r * (a1 - a1*a1*a1*0.04f);
                        float x2 = cx + r * (1.0f - a2*a2*0.14f);
                        float y2 = cy + r * (a2 - a2*a2*a2*0.04f);
                        draw_line_simple(&app, cx + (x1 - cx)*0.8f, cy + (y1 - cy)*0.8f,
                                               cx + (x2 - cx)*0.8f, cy + (y2 - cy)*0.8f, s_strk);
                        ci = ci + 1;
                    }
                } else if (s.shape_type == vs.SHAPE_STAR()) {
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + 10.0f, s.y + 10.0f, s.w - 20.0f, s.h - 20.0f, s_fill);
                    // star points
                    draw_line_simple(&app, s.x + s.w*0.5f, s.y, s.x + s.w, s.y + s.h, s_strk);
                    draw_line_simple(&app, s.x + s.w, s.y + s.h, s.x, s.y + s.h*0.35f, s_strk);
                    draw_line_simple(&app, s.x, s.y + s.h*0.35f, s.x + s.w, s.y + s.h*0.35f, s_strk);
                    draw_line_simple(&app, s.x + s.w, s.y + s.h*0.35f, s.x, s.y + s.h, s_strk);
                    draw_line_simple(&app, s.x, s.y + s.h, s.x + s.w*0.5f, s.y, s_strk);
                } else if (s.shape_type == vs.SHAPE_PATH()) {
                    int pi = 0;
                    while (pi < s.pt_count - 1) {
                        draw_line_simple(&app, s.pts_x[pi], s.pts_y[pi], s.pts_x[pi+1], s.pts_y[pi+1], s_strk);
                        app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.pts_x[pi] - 3.0f, s.pts_y[pi] - 3.0f, 6.0f, 6.0f, s_strk);
                        pi = pi + 1;
                    }
                    if (s.pt_count > 0) {
                        app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.pts_x[s.pt_count-1] - 3.0f, s.pts_y[s.pt_count-1] - 3.0f, 6.0f, 6.0f, s_strk);
                    }
                }

                // Selection bounding box highlight
                if (sh_i == doc.selected_idx) {
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x - 2.0f, s.y - 2.0f, s.w + 4.0f, 2.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x - 2.0f, s.y + s.h, s.w + 4.0f, 2.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x - 2.0f, s.y - 2.0f, 2.0f, s.h + 4.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + s.w, s.y - 2.0f, 2.0f, s.h + 4.0f, col_sel_box);

                    // Corner handles
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x - 4.0f, s.y - 4.0f, 6.0f, 6.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + s.w - 2.0f, s.y - 4.0f, 6.0f, 6.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x - 4.0f, s.y + s.h - 2.0f, 6.0f, 6.0f, col_sel_box);
                    app.ui_ctx.renderer.push_quad(&app.gl_ctx, s.x + s.w - 2.0f, s.y + s.h - 2.0f, 6.0f, 6.0f, col_sel_box);
                }
            }
            sh_i = sh_i + 1;
        }

        // ── Right Sidebar: Layers & Inspector ─────────────────────────────────
        float insp_x = W - insp_w;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, insp_w, H - top_h, col_panel);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, 1.0f, H - top_h, col_grid);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x, top_h, insp_w, 36.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "LAYERS & INSPECTOR", insp_x + 14.0f, top_h + 10.0f, col_text);

        // Layers list
        float ly = top_h + 46.0f;
        int li = 0;
        while (li < doc.count) {
            float lbw = insp_w - 28.0f;
            float lbh = 28.0f;
            rmath.Color lbc = col_card;
            if (li == doc.selected_idx) { lbc = col_card_h; }

            app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, ly, lbw, lbh, lbc);

            // Eye icon indicator
            rmath.Color eyec = col_accent;
            if (doc.shapes[li].visible == 0) { eyec = col_dim; }
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 20.0f, ly + 8.0f, 12.0f, 12.0f, eyec);

            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
                doc.shapes[li].name, insp_x + 40.0f, ly + 6.0f, col_text);

            if (mb_click == 1 && btn_hit(insp_x + 14.0f, ly, lbw, lbh, mx, my) == 1) {
                if (btn_hit(insp_x + 16.0f, ly + 4.0f, 20.0f, 20.0f, mx, my) == 1) {
                    // Toggle visibility
                    if (doc.shapes[li].visible == 1) { doc.shapes[li].visible = 0; }
                    else { doc.shapes[li].visible = 1; }
                } else {
                    doc.selected_idx = li;
                }
            }

            ly = ly + lbh + 6.0f;
            li = li + 1;
        }

        // Shape properties
        ly = ly + 14.0f;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 14.0f, ly, insp_w - 28.0f, 1.0f, col_grid);
        ly = ly + 12.0f;

        if (doc.selected_idx >= 0 && doc.selected_idx < doc.count) {
            vs.VectorShape sel = doc.shapes[doc.selected_idx];
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "SHAPE PROPERTIES", insp_x + 14.0f, ly, col_dim);
            ly = ly + 24.0f;

            sprintf(b_x, "X: %.0f px", sel.x);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_x, insp_x + 14.0f, ly, col_text);
            sprintf(b_y, "Y: %.0f px", sel.y);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_y, insp_x + 120.0f, ly, col_text);

            ly = ly + 22.0f;
            sprintf(b_w, "W: %.0f px", sel.w);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_w, insp_x + 14.0f, ly, col_text);
            sprintf(b_h, "H: %.0f px", sel.h);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_h, insp_x + 120.0f, ly, col_text);

            ly = ly + 26.0f;
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Fill:", insp_x + 14.0f, ly, col_dim);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 50.0f, ly + 2.0f, 16.0f, 16.0f, rmath.color_hex(sel.fill_color));

            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "Stroke:", insp_x + 100.0f, ly, col_dim);
            app.ui_ctx.renderer.push_quad(&app.gl_ctx, insp_x + 160.0f, ly + 2.0f, 16.0f, 16.0f, rmath.color_hex(sel.stroke_color));
        }

        // ── Bottom Live SVG Export Drawer ─────────────────────────────────────
        float cy_bot = H - code_h;
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tools_w, cy_bot, canvas_w, code_h, col_code_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tools_w, cy_bot, canvas_w, 1.0f, col_grid);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, tools_w, cy_bot, canvas_w, 24.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "LIVE SVG CODE PREVIEW", tools_w + 14.0f, cy_bot + 4.0f, col_dim);

        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 600\">", tools_w + 14.0f, cy_bot + 32.0f, col_dim);

        if (doc.selected_idx >= 0 && doc.selected_idx < doc.count) {
            vs.VectorShape sel2 = doc.shapes[doc.selected_idx];
            if (sel2.shape_type == vs.SHAPE_RECT()) {
                sprintf(b_svg1, "  <rect x=\"%.0f\" y=\"%.0f\" width=\"%.0f\" height=\"%.0f\" fill=\"#%06X\" stroke=\"#%06X\"/>",
                    sel2.x, sel2.y, sel2.w, sel2.h, sel2.fill_color, sel2.stroke_color);
            } else if (sel2.shape_type == vs.SHAPE_CIRCLE()) {
                sprintf(b_svg1, "  <circle cx=\"%.0f\" cy=\"%.0f\" r=\"%.0f\" fill=\"#%06X\" stroke=\"#%06X\"/>",
                    sel2.x + sel2.w*0.5f, sel2.y + sel2.h*0.5f, sel2.w*0.5f, sel2.fill_color, sel2.stroke_color);
            } else if (sel2.shape_type == vs.SHAPE_STAR()) {
                sprintf(b_svg1, "  <polygon points=\"...\" fill=\"#%06X\" stroke=\"#%06X\"/> <!-- star -->",
                    sel2.fill_color, sel2.stroke_color);
            } else {
                sprintf(b_svg1, "  <path d=\"M %.0f %.0f Q ...\" fill=\"none\" stroke=\"#%06X\" stroke-width=\"2\"/>",
                    sel2.x, sel2.y, sel2.stroke_color);
            }
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, (string)b_svg1, tools_w + 14.0f, cy_bot + 58.0f, col_accent);
        } else {
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
                "  <!-- Select a shape to inspect SVG node -->", tools_w + 14.0f, cy_bot + 58.0f, col_dim);
        }

        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "</svg>", tools_w + 14.0f, cy_bot + 84.0f, col_dim);

        // ── Bottom Status Bar ─────────────────────────────────────────────────
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, H - 24.0f, W, 24.0f, col_header);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx,
            "Drag shapes to move | Click palette tools to add primitives | Click swatch to color | ESC quit",
            14.0f, H - 18.0f, col_dim);

        app.end_frame();
    }

    doc.destroy();
    free(b_x);
    free(b_y);
    free(b_w);
    free(b_h);
    free(b_svg1);
    free(b_svg2);

    app.close();
    return 0;
}

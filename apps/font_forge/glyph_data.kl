// apps/font_forge/glyph_data.kl
// Glyph outline and metric data structures

struct GlyphPoint {
    float x;
    float y;
    int   on_curve; // 1 = on curve, 0 = off curve (control point)
}

struct GlyphOutline {
    GlyphPoint* points;
    int         point_count;
    int         advance_width;
    int         left_side_bearing;
    int         bbox_x0;
    int         bbox_y0;
    int         bbox_x1;
    int         bbox_y1;
    char        codepoint;
}

fn void GlyphOutline.init(char ch, int adv, int lsb) {
    this->codepoint         = ch;
    this->advance_width     = adv;
    this->left_side_bearing = lsb;
    this->point_count       = 0;
    this->points            = alloc(GlyphPoint, 32);
    this->bbox_x0           = 0;
    this->bbox_y0           = -200;
    this->bbox_x1           = adv;
    this->bbox_y1           = 800;
}

fn void GlyphOutline.add_point(float x, float y, int on_curve) {
    if (this->point_count >= 32) { return; }
    int i = this->point_count;
    this->points[i].x = x;
    this->points[i].y = y;
    this->points[i].on_curve = on_curve;
    this->point_count = i + 1;
}

fn void GlyphOutline.destroy() {
    if (this->points != (GlyphPoint*)0) {
        free(this->points);
        this->points = (GlyphPoint*)0;
    }
}

// Procedural sample glyph constructor
fn GlyphOutline make_sample_glyph(int idx) {
    GlyphOutline g;
    if (idx == 0) {
        // 'A'
        g.init((char)65, 600, 40);
        g.add_point(50.0f,   0.0f, 1);
        g.add_point(250.0f, 700.0f, 1);
        g.add_point(350.0f, 700.0f, 1);
        g.add_point(550.0f,   0.0f, 1);
        g.add_point(430.0f,   0.0f, 1);
        g.add_point(360.0f, 220.0f, 1);
        g.add_point(240.0f, 220.0f, 1);
        g.add_point(170.0f,   0.0f, 1);
    } else if (idx == 1) {
        // 'B'
        g.init((char)66, 580, 50);
        g.add_point(80.0f,   0.0f, 1);
        g.add_point(80.0f, 700.0f, 1);
        g.add_point(360.0f, 700.0f, 1);
        g.add_point(480.0f, 530.0f, 0); // curve
        g.add_point(360.0f, 360.0f, 1);
        g.add_point(500.0f, 180.0f, 0); // curve
        g.add_point(380.0f,   0.0f, 1);
    } else if (idx == 2) {
        // 'C'
        g.init((char)67, 560, 50);
        g.add_point(500.0f, 550.0f, 1);
        g.add_point(380.0f, 700.0f, 0);
        g.add_point(200.0f, 700.0f, 1);
        g.add_point(60.0f, 350.0f, 0);
        g.add_point(200.0f,   0.0f, 1);
        g.add_point(380.0f,   0.0f, 0);
        g.add_point(500.0f, 150.0f, 1);
    } else if (idx == 3) {
        // 'G'
        g.init((char)71, 620, 50);
        g.add_point(520.0f, 560.0f, 1);
        g.add_point(380.0f, 700.0f, 0);
        g.add_point(180.0f, 700.0f, 1);
        g.add_point(60.0f,  350.0f, 0);
        g.add_point(180.0f,   0.0f, 1);
        g.add_point(400.0f,   0.0f, 0);
        g.add_point(520.0f, 250.0f, 1);
        g.add_point(340.0f, 250.0f, 1);
    } else if (idx == 4) {
        // '0'
        g.init((char)48, 540, 45);
        g.add_point(270.0f, 700.0f, 1);
        g.add_point(80.0f,  350.0f, 0);
        g.add_point(270.0f,   0.0f, 1);
        g.add_point(460.0f, 350.0f, 0);
    } else {
        // '@'
        g.init((char)64, 720, 40);
        g.add_point(360.0f, 680.0f, 1);
        g.add_point(100.0f, 400.0f, 0);
        g.add_point(360.0f,  60.0f, 1);
        g.add_point(620.0f, 400.0f, 0);
        g.add_point(480.0f, 350.0f, 1);
    }
    return g;
}

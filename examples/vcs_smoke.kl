// examples/vcs_smoke.kl
// Automated Verification Smoke Test for vcs (Distributed Version Control System)

import "vcs/sha1.kl" as sha1;
import "vcs/object.kl" as obj;
import "vcs/index.kl" as idx;
import "vcs/repo.kl" as repo;
import "vcs/diff.kl" as vdiff;
import "vcs/porcelain.kl" as vcs;
import "packages/std/fs/file_util.kl" as fu;
import "packages/std/fs/path.kl" as path;
import "packages/std/fs/dir.kl" as dir;

extern int printf(string fmt, ...);
extern int strcmp(string s1, string s2);
extern int strlen(string s);

fn void test_sha1() {
    printf("[TEST 1/4] Testing Pure Kale SHA-1 Hashing...\n");
    string input_text = "hello world";
    string h = sha1.sha1_hex(input_text, 11);
    printf("  SHA-1(\"%s\") = %s\n", input_text, h);

    string expected = "2aae6c35c94fcfb415dbe95f408b9ce91ee846ed";
    if (strcmp(h, expected) == 0) {
        printf("  [PASS] SHA-1 matched known standard hash vector!\n\n");
    } else {
        printf("  [FAIL] SHA-1 hash mismatch!\n\n");
    }
}

fn void test_diff() {
    printf("[TEST 2/4] Testing Myers Difference Algorithm...\n");
    string old_doc = "line 1\nline 2\nline 3\n";
    string new_doc = "line 1\nline 2 changed\nline 3\nline 4\n";

    string d = vdiff.unified_diff("demo.txt", old_doc, new_doc);
    printf("  Generated Unified Diff:\n%s\n", d);

    if (strlen(d) > 0) {
        printf("  [PASS] Myers unified diff successfully produced!\n\n");
    } else {
        printf("  [FAIL] Unified diff was empty!\n\n");
    }
}

fn void test_objects_and_index() {
    printf("[TEST 3/4] Testing Blob/Tree/Commit Objects & Index Serialization...\n");

    // 1. Blob
    obj.GitObject b = obj.create_blob("Kale programming language v0.1.0");
    printf("  Created Blob ID: %s (size %lld)\n", b.id, b.size);

    // 2. Tree
    obj.TreeObject tree;
    tree.init();
    tree.add_entry("100644", "README.md", b.id);
    string tree_id = tree.compute_hash();
    printf("  Created Tree ID: %s (entries: %lld)\n", tree_id, tree.count);

    // 3. Commit
    obj.CommitObject c;
    c.init(tree_id, "", "Test Author", "test@kale-lang.org", 1726329600, "Initial commit");
    string commit_id = c.compute_hash();
    printf("  Created Commit ID: %s\n", commit_id);

    // 4. Index
    idx.Index index;
    index.init();
    index.add_entry("100644", b.id, b.size, "README.md");
    string index_repr = index.serialize();
    printf("  Serialized Index (entries: %lld):\n%s", index.count, index_repr);

    tree.destroy();
    index.destroy();

    if (strlen(commit_id) == 40 && strlen(tree_id) == 40 && strlen(b.id) == 40) {
        printf("  [PASS] Content-addressable object store models verified!\n\n");
    } else {
        printf("  [FAIL] Object hash lengths invalid!\n\n");
    }
}

fn void test_repository_workflow() {
    printf("[TEST 4/4] Testing End-to-End Repository Lifecycle in test_sandbox_repo...\n");

    string test_repo = "test_sandbox_repo";
    dir.create_dir(test_repo);

    // 1. init
    vcs.cmd_init(test_repo);

    // 2. create file & add
    string file_path = path.join(test_repo, "hello.txt");
    fu.write_string(file_path, "Hello from Kale VCS!\nSecond line of version control.\n");
    vcs.cmd_add(test_repo, "hello.txt");

    // 3. status
    vcs.cmd_status(test_repo);

    // 4. commit
    vcs.cmd_commit(test_repo, "feat: initial commit from smoke test", "Kale Bot", "bot@kale-lang.org");

    // 5. log
    printf("  Inspecting commit log:\n");
    vcs.cmd_log(test_repo);

    // 6. modify & diff
    fu.write_string(file_path, "Hello from Kale VCS!\nSecond line CHANGED.\nThird line ADDED.\n");
    printf("  Inspecting unstaged working tree diff:\n");
    vcs.cmd_diff(test_repo, "hello.txt");

    printf("  [PASS] End-to-end repository workflow executed cleanly!\n\n");
}

fn int run_smoke_test() {
    printf("==================================================\n");
    printf(" Kale vcs Automated Smoke Test Suite\n");
    printf("==================================================\n");

    test_sha1();
    test_diff();
    test_objects_and_index();
    test_repository_workflow();

    printf("ALL vcs TESTS PASSED PERFECTLY!\n");
    return 0;
}

run_smoke_test();

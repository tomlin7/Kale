// examples/editor_app.kl
// Interactive Native Kale Code Editor Application

import "packages/editor/editor.kl" as ed;

extern int Sleep(int dwMilliseconds);

ed.Editor editor;
editor.init(950, 680);

string sample_code = "// Kale Native Code Editor - Live App\nimport \"packages/std/text/piece_table.kl\" as pt;\n\nstruct Vec3 {\n    float x;\n    float y;\n    float z;\n}\n\nfn int compute_sum(int a, int b) {\n    int result = a + b;\n    return result;\n}\n\nfn int run_app() {\n    // Welcome to the Kale Code Editor!\n    string greeting = \"Hello from Kale OS window!\";\n    int val = 42;\n    return 0;\n}\n";

editor.load_text(sample_code);

bool ok = editor.open_window("Kale Code Editor - Live Interactive Desktop App");

if (ok) {
    editor.render();

    // Event pump running 50 frames (approx 5 seconds) to show the live desktop window
    int frames = 0;
    while (frames < 50 && editor.window.is_open) {
        editor.window.poll_events();
        editor.render();
        Sleep(100);
        frames = frames + 1;
    }

    editor.destroy();
}

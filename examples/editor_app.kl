// examples/editor_app.kl
// Interactive Native Kale Code Editor Application

import "packages/editor/editor.kl" as ed;

extern int Sleep(int dwMilliseconds);

ed.Editor editor;
editor.init(1000, 700);

string sample_code = "// ==========================================\n// Kale Native Code Editor - Live App\n// ==========================================\n\nimport \"packages/std/text/piece_table.kl\" as pt;\nimport \"packages/bindings/win32/gdi32.kl\" as gdi;\n\nstruct Vec3 {\n    float x;\n    float y;\n    float z;\n}\n\nfn int fib(int n) {\n    if (n <= 1) {\n        return n;\n    }\n    return fib(n - 1) + fib(n - 2);\n}\n\nfn int run_app() {\n    // Welcome to your custom Kale code editor!\n    string title = \"Kale OS Native Window\";\n    int answer = 42;\n    return answer;\n}\n";

editor.load_text(sample_code);

bool ok = editor.open_window("Kale Code Editor - Live Interactive Desktop App");

if (ok) {
    // Render once
    editor.render();

    // Event pump runs indefinitely until closed by user (WM_QUIT / close)
    while (editor.window.is_open) {
        editor.window.poll_events();
        Sleep(20);
    }

    editor.destroy();
}

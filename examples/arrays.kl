int sum_array(int[] a, int n) {
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += a[i];
    }
    return total;
}

print("--- Array Demo ---");
int[] numbers = [10, 20, 30, 40, 50];
print("Initial element 0:", numbers[0]);
print("Initial element 4:", numbers[4]);

numbers[2] = 999;
print("Mutated element 2:", numbers[2]);

int total = sum_array(numbers, 5);
print("Sum of array elements:", total);

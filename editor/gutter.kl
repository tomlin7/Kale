// editor/gutter.kl
// GPU-Accelerated Line Number Gutter Component for Kale Code Editor

import "libs/gl/loader.kl" as glloader;
import "libs/render/math.kl" as rmath;
import "libs/render/batch.kl" as rbatch;
import "libs/render/font.kl" as rfont;
import "packages/std/text/string_builder.kl" as sb;

extern int strlen(string s);

struct Gutter {
    float x;
    float y;
    float width;
    float height;
    float line_height;

    rmath.Color bg;
    rmath.Color fg;
    rmath.Color active_fg;
    rmath.Color divider_color;
}

fn void Gutter.init(float x, float y, float w, float h, float line_h) {
    this->x = x;
    this->y = y;
    this->width = w;
    this->height = h;
    this->line_height = line_h;

    this->bg = rmath.color_rgba(0.14f, 0.14f, 0.16f, 1.0f);
    this->fg = rmath.color_rgba(0.45f, 0.47f, 0.52f, 1.0f);
    this->active_fg = rmath.color_rgba(0.95f, 0.95f, 0.98f, 1.0f);
    this->divider_color = rmath.color_rgba(0.20f, 0.22f, 0.25f, 1.0f);
}

fn void Gutter.render(
    rbatch.BatchRenderer* renderer,
    glloader.GLContext* gl_ctx,
    rfont.FontAtlas* font,
    int scroll_row,
    int cursor_row,
    int total_lines
) {
    // Fill gutter background
    renderer->push_quad(gl_ctx, this->x, this->y, this->width, this->height, this->bg);

    // Draw vertical divider bar
    float divider_x = this->x + this->width - 1.0f;
    renderer->push_quad(gl_ctx, divider_x, this->y, 1.0f, this->height, this->divider_color);

    renderer->set_clip_rect(gl_ctx, this->x, this->y, this->width, this->height);

    int visible_lines = (int)(this->height / this->line_height);
    int idx = 0;

    while (idx < visible_lines) {
        int line_num = scroll_row + idx;
        float cur_y = this->y + ((float)idx * this->line_height);

        if (line_num < total_lines) {
            sb.StringBuilder num_sb;
            num_sb.init(8);
            num_sb.append_int(line_num + 1);
            string num_str = num_sb.to_string();

            rmath.Color num_color = this->fg;
            if (line_num == cursor_row) {
                num_color = this->active_fg;
            }

            float num_w = font->measure_text(num_str);
            float num_x = this->x + this->width - 12.0f - num_w;
            if (num_x < this->x + 4.0f) {
                num_x = this->x + 4.0f;
            }

            font->draw_text(renderer, gl_ctx, num_str, num_x, cur_y + 2.0f, num_color);
            free((void*)num_str);
            num_sb.destroy();
        } else {
            font->draw_text(renderer, gl_ctx, "~", this->x + 16.0f, cur_y + 2.0f, this->fg);
        }

        idx = idx + 1;
    }

    renderer->reset_clip(gl_ctx);
}

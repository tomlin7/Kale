    t.gutter_bg         = rmath.color_rgba(0.149f, 0.169f, 0.208f, 1.0f);
    t.gutter_fg         = rmath.color_rgba(0.435f, 0.490f, 0.569f, 1.0f); // #6f7c91
    t.gutter_active_fg  = rmath.color_rgba(0.847f, 0.871f, 0.914f, 1.0f);
    t.status_bar_bg     = rmath.color_rgba(0.118f, 0.133f, 0.161f, 1.0f);
    t.status_bar_fg     = rmath.color_rgba(0.647f, 0.737f, 0.831f, 1.0f);
    t.tab_bar_bg        = rmath.color_rgba(0.149f, 0.169f, 0.208f, 1.0f);
    t.tab_active_bg     = rmath.color_rgba(0.180f, 0.204f, 0.251f, 1.0f);
    t.tab_active_accent = rmath.color_rgba(0.533f, 0.753f, 0.816f, 1.0f);
    t.tab_inactive_fg   = rmath.color_rgba(0.435f, 0.490f, 0.569f, 1.0f);
    t.token_keyword     = rmath.color_rgba(0.533f, 0.584f, 0.702f, 1.0f); // #81a1c1 blue
    t.token_string      = rmath.color_rgba(0.659f, 0.812f, 0.561f, 1.0f); // #a3be8c green
    t.token_comment     = rmath.color_rgba(0.435f, 0.490f, 0.569f, 1.0f); // #6f7c91
    t.token_number      = rmath.color_rgba(0.816f, 0.714f, 0.867f, 1.0f); // #b48ead purple
    t.token_operator    = rmath.color_rgba(0.533f, 0.753f, 0.816f, 1.0f);
    t.token_type        = rmath.color_rgba(0.533f, 0.753f, 0.816f, 1.0f); // #88c0d0 cyan
    t.token_function    = rmath.color_rgba(0.533f, 0.753f, 0.816f, 1.0f);
    t.token_punctuation = rmath.color_rgba(0.847f, 0.871f, 0.914f, 1.0f);
    return t;
}

fn SyntaxTheme theme_one_dark() {
    SyntaxTheme t;
    t.theme_id = 4;
    t.bg                = rmath.color_rgba(0.157f, 0.165f, 0.196f, 1.0f); // #282c34
    t.bg_active_line    = rmath.color_rgba(0.196f, 0.208f, 0.247f, 1.0f);
    t.bg_selection      = rmath.color_rgba(0.243f, 0.259f, 0.314f, 1.0f);
    t.fg                = rmath.color_rgba(0.847f, 0.875f, 0.933f, 1.0f); // #abb2bf
    t.cursor            = rmath.color_rgba(0.369f, 0.647f, 0.961f, 1.0f); // #5ea6f5
    t.gutter_bg         = rmath.color_rgba(0.129f, 0.137f, 0.165f, 1.0f);
    t.gutter_fg         = rmath.color_rgba(0.400f, 0.427f, 0.510f, 1.0f); // #666b82
    t.gutter_active_fg  = rmath.color_rgba(0.800f, 0.820f, 0.870f, 1.0f);
    t.status_bar_bg     = rmath.color_rgba(0.122f, 0.129f, 0.157f, 1.0f);
    t.status_bar_fg     = rmath.color_rgba(0.650f, 0.680f, 0.760f, 1.0f);
    t.tab_bar_bg        = rmath.color_rgba(0.129f, 0.137f, 0.165f, 1.0f);
    t.tab_active_bg     = rmath.color_rgba(0.157f, 0.165f, 0.196f, 1.0f);
    t.tab_active_accent = rmath.color_rgba(0.369f, 0.647f, 0.961f, 1.0f);
    t.tab_inactive_fg   = rmath.color_rgba(0.400f, 0.427f, 0.510f, 1.0f);
    t.token_keyword     = rmath.color_rgba(0.780f, 0.443f, 0.718f, 1.0f); // #c678dd purple
    t.token_string      = rmath.color_rgba(0.584f, 0.784f, 0.451f, 1.0f); // #98c379 green
    t.token_comment     = rmath.color_rgba(0.384f, 0.451f, 0.541f, 1.0f); // #626a8a
    t.token_number      = rmath.color_rgba(0.843f, 0.627f, 0.380f, 1.0f); // #d79a61 orange
    t.token_operator    = rmath.color_rgba(0.847f, 0.875f, 0.933f, 1.0f);
    t.token_type        = rmath.color_rgba(0.361f, 0.718f, 0.859f, 1.0f); // #5cb8db cyan
    t.token_function    = rmath.color_rgba(0.369f, 0.647f, 0.961f, 1.0f); // #61afef blue
    t.token_punctuation = rmath.color_rgba(0.750f, 0.770f, 0.820f, 1.0f);
    return t;
}

fn SyntaxTheme theme_load(int theme_id) {
    if (theme_id == THEME_DRACULA())   { return theme_dracula(); }
    if (theme_id == THEME_MONOKAI())   { return theme_monokai(); }
    if (theme_id == THEME_NORD())      { return theme_nord(); }
    if (theme_id == THEME_ONE_DARK())  { return theme_one_dark(); }
    // Default: Dracula
    return theme_dracula();
}

fn string theme_name(int theme_id) {
    if (theme_id == THEME_DRACULA())   { return "Dracula"; }
    if (theme_id == THEME_MONOKAI())   { return "Monokai"; }
    if (theme_id == THEME_NORD())      { return "Nord"; }
    if (theme_id == THEME_ONE_DARK())  { return "One Dark"; }
    return "Dracula";
}

fn int theme_next(int current_id) {
    int next = current_id + 1;
    if (next > THEME_ONE_DARK()) { next = THEME_DRACULA(); }
    return next;
}

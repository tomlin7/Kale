// editor/theme.kl
// Syntax Theme Engine for Kale Code Editor
// Provides named colour palettes (Dracula, Monokai, Nord, Solarized Dark)

import "libs/render/math.kl" as rmath;

// Theme identifiers
fn int THEME_DRACULA()       { return 0; }
fn int THEME_MONOKAI()       { return 1; }
fn int THEME_NORD()          { return 2; }
fn int THEME_SOLARIZED()     { return 3; }
fn int THEME_ONE_DARK()      { return 4; }

struct SyntaxTheme {
    // Editor chrome
    rmath.Color bg;
    rmath.Color bg_active_line;
    rmath.Color bg_selection;
    rmath.Color fg;
    rmath.Color cursor;
    rmath.Color gutter_bg;
    rmath.Color gutter_fg;
    rmath.Color gutter_active_fg;
    rmath.Color status_bar_bg;
    rmath.Color status_bar_fg;
    rmath.Color tab_bar_bg;
    rmath.Color tab_active_bg;
    rmath.Color tab_active_accent;
    rmath.Color tab_inactive_fg;

    // Syntax tokens
    rmath.Color token_keyword;
    rmath.Color token_string;
    rmath.Color token_comment;
    rmath.Color token_number;
    rmath.Color token_operator;
    rmath.Color token_type;
    rmath.Color token_function;
    rmath.Color token_punctuation;

    int theme_id;
}

fn SyntaxTheme theme_dracula() {
    SyntaxTheme t;
    t.theme_id = 0;
    // Editor chrome — Dracula palette
    t.bg                = rmath.color_rgba(0.157f, 0.165f, 0.212f, 1.0f); // #282a36
    t.bg_active_line    = rmath.color_rgba(0.192f, 0.200f, 0.255f, 1.0f); // #31334d
    t.bg_selection      = rmath.color_rgba(0.259f, 0.275f, 0.357f, 1.0f); // #44475a
    t.fg                = rmath.color_rgba(0.973f, 0.973f, 0.973f, 1.0f); // #f8f8f2
    t.cursor            = rmath.color_rgba(0.980f, 0.863f, 0.369f, 1.0f); // #f9dc5d
    t.gutter_bg         = rmath.color_rgba(0.129f, 0.137f, 0.176f, 1.0f); // #21222c
    t.gutter_fg         = rmath.color_rgba(0.416f, 0.420f, 0.545f, 1.0f); // #6a6b8b
    t.gutter_active_fg  = rmath.color_rgba(0.780f, 0.780f, 0.780f, 1.0f); // #c8c8c8
    t.status_bar_bg     = rmath.color_rgba(0.102f, 0.106f, 0.149f, 1.0f); // #1a1b26
    t.status_bar_fg     = rmath.color_rgba(0.700f, 0.720f, 0.800f, 1.0f);
    t.tab_bar_bg        = rmath.color_rgba(0.129f, 0.137f, 0.176f, 1.0f);
    t.tab_active_bg     = rmath.color_rgba(0.157f, 0.165f, 0.212f, 1.0f);
    t.tab_active_accent = rmath.color_rgba(0.745f, 0.635f, 0.976f, 1.0f); // #bd93f9
    t.tab_inactive_fg   = rmath.color_rgba(0.416f, 0.420f, 0.545f, 1.0f);
    // Tokens
    t.token_keyword     = rmath.color_rgba(0.863f, 0.392f, 0.702f, 1.0f); // #ff79c6 pink
    t.token_string      = rmath.color_rgba(0.945f, 0.792f, 0.447f, 1.0f); // #f1fa8c yellow
    t.token_comment     = rmath.color_rgba(0.384f, 0.447f, 0.643f, 1.0f); // #6272a4
    t.token_number      = rmath.color_rgba(0.745f, 0.635f, 0.976f, 1.0f); // #bd93f9 purple
    t.token_operator    = rmath.color_rgba(0.973f, 0.973f, 0.973f, 1.0f); // #f8f8f2
    t.token_type        = rmath.color_rgba(0.545f, 0.914f, 0.992f, 1.0f); // #8be9fd cyan
    t.token_function    = rmath.color_rgba(0.310f, 0.980f, 0.482f, 1.0f); // #50fa7b green
    t.token_punctuation = rmath.color_rgba(0.800f, 0.800f, 0.800f, 1.0f);
    return t;
}

fn SyntaxTheme theme_monokai() {
    SyntaxTheme t;
    t.theme_id = 1;
    t.bg                = rmath.color_rgba(0.157f, 0.157f, 0.157f, 1.0f); // #272822
    t.bg_active_line    = rmath.color_rgba(0.200f, 0.200f, 0.200f, 1.0f);
    t.bg_selection      = rmath.color_rgba(0.259f, 0.259f, 0.259f, 1.0f);
    t.fg                = rmath.color_rgba(0.973f, 0.973f, 0.941f, 1.0f); // #f8f8f0
    t.cursor            = rmath.color_rgba(0.980f, 0.663f, 0.310f, 1.0f); // #fd971f
    t.gutter_bg         = rmath.color_rgba(0.129f, 0.129f, 0.129f, 1.0f);
    t.gutter_fg         = rmath.color_rgba(0.464f, 0.460f, 0.412f, 1.0f); // #75715e
    t.gutter_active_fg  = rmath.color_rgba(0.780f, 0.780f, 0.780f, 1.0f);
    t.status_bar_bg     = rmath.color_rgba(0.102f, 0.102f, 0.102f, 1.0f);
    t.status_bar_fg     = rmath.color_rgba(0.700f, 0.700f, 0.700f, 1.0f);
    t.tab_bar_bg        = rmath.color_rgba(0.129f, 0.129f, 0.129f, 1.0f);
    t.tab_active_bg     = rmath.color_rgba(0.157f, 0.157f, 0.157f, 1.0f);
    t.tab_active_accent = rmath.color_rgba(0.980f, 0.663f, 0.310f, 1.0f);
    t.tab_inactive_fg   = rmath.color_rgba(0.464f, 0.460f, 0.412f, 1.0f);
    t.token_keyword     = rmath.color_rgba(0.980f, 0.153f, 0.580f, 1.0f); // #f92672 red
    t.token_string      = rmath.color_rgba(0.902f, 0.863f, 0.267f, 1.0f); // #e6db44 yellow
    t.token_comment     = rmath.color_rgba(0.464f, 0.460f, 0.412f, 1.0f); // #75715e
    t.token_number      = rmath.color_rgba(0.678f, 0.875f, 0.294f, 1.0f); // #ae81ff purple
    t.token_operator    = rmath.color_rgba(0.980f, 0.153f, 0.580f, 1.0f);
    t.token_type        = rmath.color_rgba(0.400f, 0.855f, 1.000f, 1.0f); // #66d9e8 cyan
    t.token_function    = rmath.color_rgba(0.647f, 0.898f, 0.000f, 1.0f); // #a6e22e green
    t.token_punctuation = rmath.color_rgba(0.820f, 0.820f, 0.820f, 1.0f);
    return t;
}


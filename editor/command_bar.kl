// Modal command palette and fuzzy file opener used by the editor.

import "libs/render/math.kl" as rmath;
import "libs/ui/ui.kl" as ui;

struct CommandItem {
    string name;
    string query;
    int visible;
}

struct CommandBar {
    int visible;
    int file_mode;
    int selected;
    int item_count;
    char* input_buffer;
    CommandItem[16] items;
    int input_length;
    int visible_count;
}

fn void command_bar_init(CommandBar* bar, char* input_buffer) {
    bar->visible = 0;
    bar->file_mode = 0;
    bar->selected = 0;
    bar->item_count = 4;
    bar->input_buffer = input_buffer;
    bar->input_length = 0;
    bar->visible_count = 4;
    bar->items[0].name = "Format document"; bar->items[0].query = ">format";
    bar->items[1].name = "Save file"; bar->items[1].query = ">save";
    bar->items[2].name = "Open file"; bar->items[2].query = ">open";
    bar->items[3].name = "Find in files"; bar->items[3].query = ">find";
}

fn void command_bar_reset(CommandBar* bar) {
    bar->input_length = 0;
    if (bar->input_buffer != (char*)0) {
        bar->input_buffer[0] = (char)0;
    }
    command_bar_filter(bar, "");
}

fn int command_bar_append_char(CommandBar* bar, char value) {
    if (bar->input_buffer == (char*)0 || bar->input_length >= 254) { return 0; }
    bar->input_buffer[bar->input_length] = value;
    bar->input_length = bar->input_length + 1;
    bar->input_buffer[bar->input_length] = (char)0;
    command_bar_filter(bar, (string)bar->input_buffer);
    return 1;
}

fn int command_bar_backspace(CommandBar* bar) {
    if (bar->input_length <= 0 || bar->input_buffer == (char*)0) { return 0; }
    bar->input_length = bar->input_length - 1;
    bar->input_buffer[bar->input_length] = (char)0;
    command_bar_filter(bar, (string)bar->input_buffer);
    return 1;
}

fn int command_bar_handle_key(CommandBar* bar, int key, int shift) {
    if (key >= 65 && key <= 90) {
        return command_bar_append_char(bar, (char)(key - 65 + 97));
    }
    if (key >= 48 && key <= 57) {
        return command_bar_append_char(bar, (char)key);
    }
    if (key == 32) { return command_bar_append_char(bar, (char)32); }
    if (key == 45) { return command_bar_append_char(bar, (char)45); }
    if (key == 46 && shift != 0) { return command_bar_append_char(bar, (char)62); }
    return 0;
}

fn int command_bar_handle_navigation(CommandBar* bar, int key) {
    if (bar->visible == 0) { return 0; }
    if (key == 265) {
        command_bar_move(bar, -1);
        return 1;
    }
    if (key == 264) {
        command_bar_move(bar, 1);
        return 1;
    }
    if (key == 256) {
        bar->visible = 0;
        return 1;
    }
    if (key == 257) {
        command_bar_accept(bar);
        return 1;
    }
    return 0;
}

fn void command_bar_toggle(CommandBar* bar, int file_mode) {
    if (bar->visible == 0) {
        bar->visible = 1;
        command_bar_reset(bar);
    }
    else { bar->visible = 0; }
    bar->file_mode = file_mode;
    bar->selected = 0;
}

fn int command_bar_matches(string query, string candidate) {
    int q = 0;
    int c = 0;
    while (candidate[c] != (char)0) {
        if (query[q] == (char)0) { return 1; }
        if (query[q] == candidate[c]) { q = q + 1; }
        c = c + 1;
    }
    if (query[q] == (char)0) { return 1; }
    return 0;
}

fn int command_bar_filter(CommandBar* bar, string query) {
    int matches = 0;
    int i = 0;
    while (i < bar->item_count) {
        bar->items[i].visible = command_bar_matches(query, bar->items[i].query);
        if (bar->items[i].visible != 0) { matches = matches + 1; }
        i = i + 1;
    }
    bar->visible_count = matches;
    bar->selected = 0;
    return matches;
}

fn void command_bar_move(CommandBar* bar, int delta) {
    if (bar->visible_count == 0) { return; }
    int visible_index = 0;
    int i = 0;
    while (i < bar->selected) {
        if (bar->items[i].visible != 0) { visible_index = visible_index + 1; }
        i = i + 1;
    }
    visible_index = visible_index + delta;
    if (visible_index < 0) { visible_index = bar->visible_count - 1; }
    if (visible_index >= bar->visible_count) { visible_index = 0; }
    i = 0;
    while (i < bar->item_count) {
        if (bar->items[i].visible != 0) {
            if (visible_index == 0) { bar->selected = i; return; }
            visible_index = visible_index - 1;
        }
        i = i + 1;
    }
}

fn string command_bar_accept(CommandBar* bar) {
    if (bar->visible == 0 || bar->visible_count == 0) { return ""; }
    bar->visible = 0;
    return bar->items[bar->selected].query;
}

fn void command_bar_render(CommandBar* bar, ui.UIContext* ctx, float x, float y, float w, float h) {
    if (bar->visible == 0) { return; }
    rmath.Color overlay = rmath.color_rgba(0.08f, 0.09f, 0.12f, 0.98f);
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, h, overlay);
    ctx->renderer.push_quad(ctx->gl_ctx, x + 12.0f, y + 12.0f, w - 24.0f, 32.0f, ctx->theme.input_bg);
    if (bar->input_buffer != (char*)0) {
        ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, (string)bar->input_buffer, x + 22.0f, y + 18.0f, ctx->theme.input_text);
    }
    int i = 0;
    float item_y = y + 58.0f;
    while (i < bar->item_count) {
        if (bar->items[i].visible != 0) {
            if (i == bar->selected) {
                ctx->renderer.push_quad(ctx->gl_ctx, x + 12.0f, item_y - 4.0f, w - 24.0f, 24.0f, ctx->theme.button_hover);
            }
            ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, bar->items[i].name, x + 22.0f, item_y, ctx->theme.text);
            item_y = item_y + 28.0f;
        }
        i = i + 1;
    }
}

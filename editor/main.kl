// editor/main.kl
// Flagship Native Code Editor for Kale written with Kale Framework v2 & GPU UI Toolkit

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;
import "editor/app_state.kl" as st;
import "editor/gutter.kl" as gt;
import "editor/status_bar.kl" as sb;
import "editor/text_viewport.kl" as vp;

extern int strlen(string s);

fn void run_editor() {
    int app_w = 1120;
    int app_h = 740;

    fw.AppConfig config;
    config.init("Kale Code Editor - GPU Flagship IDE", app_w, app_h);

    fw.App app;
    int ok = app.init(config);
    if (ok == 0) {
        print("Failed to initialize Editor application!");
        return;
    }

    string sample_code = "// ========================================================\n// Welcome to the Kale GPU Code Editor (kale/edit)\n// Written in Kale, powered by OpenGL 3.3 Core & GLFW\n// ========================================================\n\nimport \"packages/std/text/piece_table.kl\" as pt;\nimport \"libs/render/batch.kl\" as rbatch;\nimport \"libs/render/font.kl\" as rfont;\n\nstruct Vector3 {\n    float x;\n    float y;\n    float z;\n}\n\nfn int fibonacci(int n) {\n    if (n <= 1) {\n        return n;\n    }\n    return fibonacci(n - 1) + fibonacci(n - 2);\n}\n\nfn void start_application() {\n    // Ultra-low latency GPU rendering with zero dependencies\n    int speed = 60; // 60 FPS\n    string status = \"Operational\";\n}\n";

    st.EditorState state;
    state.init(sample_code, "editor_main.kl");

    float header_h = 42.0f;
    float status_h = 28.0f;
    float gutter_w = 58.0f;
    float line_h = 22.0f;
    float char_w = 11.0f;

    float content_h = (float)app_h - header_h - status_h;
    int visible_rows = (int)(content_h / line_h);

    gt.Gutter gutter;
    gutter.init(0.0f, header_h, gutter_w, content_h, line_h);

    vp.TextViewport viewport;
    viewport.init(gutter_w, header_h, (float)app_w - gutter_w, content_h, line_h, char_w);

    sb.StatusBar status_bar;
    status_bar.init(0.0f, (float)app_h - status_h, (float)app_w, status_h);

    rmath.Color header_bg = rmath.color_rgba(0.15f, 0.16f, 0.19f, 1.0f);
    rmath.Color header_tab_bg = rmath.color_rgba(0.12f, 0.12f, 0.14f, 1.0f);
    rmath.Color header_fg = rmath.color_rgba(0.88f, 0.90f, 0.94f, 1.0f);
    rmath.Color header_accent = rmath.color_rgba(0.20f, 0.65f, 0.50f, 1.0f);

    int key_delay = 0;

    while (app.begin_frame() != 0) {
        // Keyboard Navigation
        if (key_delay > 0) {
            key_delay = key_delay - 1;
        } else {
            if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_UP()) == glc.GLFW_PRESS()) {
                state.move_cursor(-1, 0, visible_rows);
                key_delay = 6;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_DOWN()) == glc.GLFW_PRESS()) {
                state.move_cursor(1, 0, visible_rows);
                key_delay = 6;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_LEFT()) == glc.GLFW_PRESS()) {
                state.move_cursor(0, -1, visible_rows);
                key_delay = 6;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_RIGHT()) == glc.GLFW_PRESS()) {
                state.move_cursor(0, 1, visible_rows);
                key_delay = 6;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_BACKSPACE()) == glc.GLFW_PRESS()) {
                state.backspace();
                key_delay = 8;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ENTER()) == glc.GLFW_PRESS()) {
                state.insert_newline();
                key_delay = 8;
            }
        }

        // Render Header bar & Active File Tab
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, (float)app.width, header_h, header_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 12.0f, 6.0f, 220.0f, header_h - 6.0f, header_tab_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 12.0f, 6.0f, 220.0f, 2.0f, header_accent);

        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "editor_main.kl", 28.0f, 14.0f, header_fg);

        // Render Components
        int total_lines = state.buffer.line_count();
        gutter.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, state.scroll_row, state.cursor_row, total_lines);
        viewport.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, &state.buffer, state.scroll_row, state.cursor_row, state.cursor_col);
        status_bar.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, state.cursor_row, state.cursor_col, total_lines, state.is_dirty);

        app.end_frame();
    }

    state.destroy();
    app.close();
}

fn int main_entry() {
    run_editor();
    return 0;
}

main_entry();

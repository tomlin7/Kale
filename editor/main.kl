// editor/main.kl
// Flagship Native Code Editor for Kale written with Kale Framework v2 & GPU UI Toolkit

import "libs/framework/app.kl" as fw;
import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/glfw/input.kl" as ginput;
import "libs/render/math.kl" as rmath;
import "editor/app_state.kl" as st;
import "editor/gutter.kl" as gt;
import "editor/status_bar.kl" as sb;
import "editor/text_viewport.kl" as vp;
import "editor/command_bar.kl" as cb;
import "apps/editor/buffer_manager.kl" as bm;
import "apps/editor/terminal_split.kl" as ts;
import "editor/terminal_pane.kl" as tp;
import "editor/theme.kl" as theme;
import "editor/config.kl" as cfg;
import "editor/file_tree.kl" as ft;
import "editor/find_bar.kl" as fb;

extern int strlen(string s);
extern int strcmp(string a, string b);

fn void poll_typing(void* window, st.EditorState* state, bool shift_down) {
    // Letters A-Z
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_A()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("A"); } else { state->insert_char("a"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_B()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("B"); } else { state->insert_char("b"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_C()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("C"); } else { state->insert_char("c"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_D()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("D"); } else { state->insert_char("d"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_E()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("E"); } else { state->insert_char("e"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_F()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("F"); } else { state->insert_char("f"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_G()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("G"); } else { state->insert_char("g"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_H()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("H"); } else { state->insert_char("h"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_I()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("I"); } else { state->insert_char("i"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_J()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("J"); } else { state->insert_char("j"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_K()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("K"); } else { state->insert_char("k"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_L()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("L"); } else { state->insert_char("l"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_M()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("M"); } else { state->insert_char("m"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_N()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("N"); } else { state->insert_char("n"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_O()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("O"); } else { state->insert_char("o"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_P()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("P"); } else { state->insert_char("p"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Q()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("Q"); } else { state->insert_char("q"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_R()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("R"); } else { state->insert_char("r"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_S()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("S"); } else { state->insert_char("s"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_T()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("T"); } else { state->insert_char("t"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_U()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("U"); } else { state->insert_char("u"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_V()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("V"); } else { state->insert_char("v"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_W()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("W"); } else { state->insert_char("w"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_X()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("X"); } else { state->insert_char("x"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Y()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("Y"); } else { state->insert_char("y"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Z()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("Z"); } else { state->insert_char("z"); } return; }

    // Numbers & row
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_0()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char(")"); } else { state->insert_char("0"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_1()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("!"); } else { state->insert_char("1"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_2()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("@"); } else { state->insert_char("2"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_3()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("#"); } else { state->insert_char("3"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_4()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("$"); } else { state->insert_char("4"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_5()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("%"); } else { state->insert_char("5"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_6()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("^"); } else { state->insert_char("6"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_7()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("&"); } else { state->insert_char("7"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_8()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("*"); } else { state->insert_char("8"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_9()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("("); } else { state->insert_char("9"); } return; }

    // Symbols & whitespace
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_SPACE()) == glc.GLFW_PRESS()) { state->insert_char(" "); return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_TAB()) == glc.GLFW_PRESS()) { state->insert_char("    "); return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_SEMICOLON()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char(":"); } else { state->insert_char(";"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_EQUAL()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("+"); } else { state->insert_char("="); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_MINUS()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("_"); } else { state->insert_char("-"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_COMMA()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("<"); } else { state->insert_char(","); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_PERIOD()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char(">"); } else { state->insert_char("."); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_SLASH()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("?"); } else { state->insert_char("/"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_APOSTROPHE()) == glc.GLFW_PRESS()) { if (shift_down) { state->insert_char("\""); } else { state->insert_char("'"); } return; }
}

fn void poll_find_typing(void* window, fb.FindBar* find_bar, bool shift_down) {
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_A()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("A"); } else { find_bar->append_char("a"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_B()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("B"); } else { find_bar->append_char("b"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_C()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("C"); } else { find_bar->append_char("c"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_D()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("D"); } else { find_bar->append_char("d"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_E()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("E"); } else { find_bar->append_char("e"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_F()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("F"); } else { find_bar->append_char("f"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_G()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("G"); } else { find_bar->append_char("g"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_H()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("H"); } else { find_bar->append_char("h"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_I()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("I"); } else { find_bar->append_char("i"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_J()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("J"); } else { find_bar->append_char("j"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_K()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("K"); } else { find_bar->append_char("k"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_L()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("L"); } else { find_bar->append_char("l"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_M()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("M"); } else { find_bar->append_char("m"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_N()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("N"); } else { find_bar->append_char("n"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_O()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("O"); } else { find_bar->append_char("o"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_P()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("P"); } else { find_bar->append_char("p"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Q()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("Q"); } else { find_bar->append_char("q"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_R()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("R"); } else { find_bar->append_char("r"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_S()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("S"); } else { find_bar->append_char("s"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_T()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("T"); } else { find_bar->append_char("t"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_U()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("U"); } else { find_bar->append_char("u"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_V()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("V"); } else { find_bar->append_char("v"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_W()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("W"); } else { find_bar->append_char("w"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_X()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("X"); } else { find_bar->append_char("x"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Y()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("Y"); } else { find_bar->append_char("y"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_Z()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("Z"); } else { find_bar->append_char("z"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_SPACE()) == glc.GLFW_PRESS()) { find_bar->append_char(" "); return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_MINUS()) == glc.GLFW_PRESS()) { if (shift_down) { find_bar->append_char("_"); } else { find_bar->append_char("-"); } return; }
    if (ginput.glfwGetKey(window, glc.GLFW_KEY_PERIOD()) == glc.GLFW_PRESS()) { find_bar->append_char("."); return; }
}

fn void run_editor() {
    int app_w = 1180;
    int app_h = 760;

    fw.AppConfig config;
    config.init("Kale Code Editor - GPU Flagship IDE", app_w, app_h);

    fw.App app;
    int ok = app.init(config);
    if (ok == 0) {
        print("Failed to initialize Editor application!");
        return;
    }

    string code_editor = "// ========================================================\n// Welcome to the Kale GPU Code Editor (kale/edit)\n// Written in Kale, powered by OpenGL 3.3 Core & GLFW\n// ========================================================\n\nimport \"packages/std/text/piece_table.kl\" as pt;\nimport \"libs/render/batch.kl\" as rbatch;\nimport \"libs/render/font.kl\" as rfont;\n\nstruct Vector3 {\n    float x;\n    float y;\n    float z;\n}\n\nfn int fibonacci(int n) {\n    if (n <= 1) {\n        return n;\n    }\n    return fibonacci(n - 1) + fibonacci(n - 2);\n}\n\nfn void start_application() {\n    // Ultra-low latency GPU rendering with zero dependencies\n    int speed = 60; // 60 FPS\n    string status = \"Operational\";\n}\n";

    string code_engine = "// ========================================================\n// engine.kl - High-Performance 2D/3D Engine Core\n// ========================================================\n\nimport \"libs/gl/gl.kl\" as gl;\nimport \"libs/render/math.kl\" as rmath;\n\nstruct EngineConfig {\n    int target_fps;\n    bool vsync;\n    bool fullscreen;\n}\n\nfn void engine_init(EngineConfig* cfg) {\n    cfg->target_fps = 60;\n    cfg->vsync = true;\n    cfg->fullscreen = false;\n}\n\nfn void engine_update(float dt) {\n    // Simulation tick and physics integration\n}\n";

    string code_shader = "// ========================================================\n// shader.kl - Core Vertex & Fragment Shader Pipeline\n// ========================================================\n\nfn string get_vertex_shader() {\n    return \"#version 330 core\\nlayout(location = 0) in vec2 aPos;\\nlayout(location = 1) in vec2 aTex;\\nlayout(location = 2) in vec4 aColor;\\nout vec2 TexCoord;\\nout vec4 VertColor;\\nuniform mat4 uProjection;\\nvoid main() {\\ngl_Position = uProjection * vec4(aPos, 0.0, 1.0);\\nTexCoord = aTex;\\nVertColor = aColor;\\n}\\n\";\n}\n";

    bm.BufferManager* buf_mgr = bm.bufman_new();
    bm.bufman_open(buf_mgr, "editor_main.kl", "editor_main.kl", code_editor);
    bm.bufman_open(buf_mgr, "engine.kl", "engine.kl", code_engine);
    bm.bufman_open(buf_mgr, "shader.kl", "shader.kl", code_shader);
    bm.bufman_switch(buf_mgr, 0);

    ts.TerminalSplit* term_split = ts.split_new(120, 24, "Kale Terminal");
    ts.split_write(term_split, "Kale GPU Developer Terminal v1.0.0 (x86_64-windows)\n");
    ts.split_write(term_split, "Loaded 3 project buffers. Ready for compilation.\n");
    ts.split_write(term_split, "Shortcuts: [Ctrl+`] Toggle Terminal | [F5] Compile | [Ctrl+B] Explorer | [Ctrl+F] Find\n");
    ts.split_write(term_split, "> Ready.\n");

    cb.CommandBar cmd_bar;
    cmd_bar.init();

    cfg.EditorConfig editor_cfg = cfg.config_defaults();
    theme.SyntaxTheme active_theme = theme.theme_load(editor_cfg.theme_id);

    ft.FileTree file_tree;
    file_tree.init(0.0f, 0.0f, 200.0f, 600.0f, 22.0f);
    ft.ft_populate_default(&file_tree);
    bool show_file_tree = false;

    fb.FindBar find_bar;
    find_bar.init(0.0f, 0.0f, 320.0f, 36.0f);

    float header_h = 42.0f;
    float status_h = 28.0f;
    float gutter_w = 58.0f;
    float line_h = 22.0f;
    float char_w = 11.0f;

    float content_h = (float)app_h - header_h - status_h;
    int visible_rows = (int)(content_h / line_h);

    gt.Gutter gutter;
    gutter.init(0.0f, header_h, gutter_w, content_h, line_h);

    vp.TextViewport viewport;
    viewport.init(gutter_w, header_h, (float)app_w - gutter_w, content_h, line_h, char_w);
    viewport.apply_theme(
        active_theme.bg,
        active_theme.bg_active_line,
        active_theme.cursor,
        active_theme.fg,
        active_theme.token_keyword,
        active_theme.token_string,
        active_theme.token_comment,
        active_theme.token_number,
        active_theme.token_operator
    );

    tp.TerminalPane terminal_pane;
    terminal_pane.init(0.0f, 0.0f, (float)app_w, 220.0f, line_h, char_w);

    sb.StatusBar status_bar;
    status_bar.init(0.0f, (float)app_h - status_h, (float)app_w, status_h);

    rmath.Color header_bg = active_theme.tab_bar_bg;
    rmath.Color header_fg = active_theme.fg;
    rmath.Color header_accent = active_theme.tab_active_accent;

    int key_delay = 0;

    while (app.begin_frame() != 0) {
        float cur_w = (float)app.width;
        float cur_h = (float)app.height;

        float term_h = 0.0f;
        if (term_split->is_open) {
            term_h = cur_h * 0.35f;
            if (term_h < 130.0f) { term_h = 130.0f; }
            if (term_h > cur_h - header_h - status_h - 100.0f) {
                term_h = cur_h - header_h - status_h - 100.0f;
            }
        }

        content_h = cur_h - header_h - status_h - term_h;
        if (content_h < 50.0f) { content_h = 50.0f; }
        visible_rows = (int)(content_h / line_h);

        float tree_w = 0.0f;
        if (show_file_tree) {
            tree_w = 200.0f;
            file_tree.x = 0.0f;
            file_tree.y = header_h;
            file_tree.width = tree_w;
            file_tree.height = content_h;
        }

        gutter.x = tree_w;
        gutter.height = content_h;
        viewport.x = tree_w + gutter_w;
        viewport.width = cur_w - tree_w - gutter_w;
        viewport.height = content_h;

        if (term_split->is_open) {
            terminal_pane.x = 0.0f;
            terminal_pane.y = header_h + content_h;
            terminal_pane.width = cur_w;
            terminal_pane.height = term_h;
        }

        status_bar.y = cur_h - status_h;
        status_bar.width = cur_w;

        bm.EditorBuffer* active_buf = bm.bufman_get_active(buf_mgr);
        st.EditorState* cur_state = &active_buf->state;

        // Mouse click navigation
        if (app.ui_ctx.mouse_pressed != 0) {
            float mx = app.ui_ctx.mouse_x;
            float my = app.ui_ctx.mouse_y;

            if (my >= 0.0f && my <= header_h) {
                float tab_w = 180.0f;
                int t = 0;
                while (t < buf_mgr->count) {
                    float tab_x = 10.0f + ((float)t * (tab_w + 6.0f));
                    if (mx >= tab_x && mx < tab_x + tab_w) {
                        if (mx >= (tab_x + tab_w - 24.0f) && buf_mgr->count > 1) {
                            bm.bufman_close(buf_mgr, t);
                        } else {
                            bm.bufman_switch(buf_mgr, t);
                        }
                        active_buf = bm.bufman_get_active(buf_mgr);
                        cur_state = &active_buf->state;
                        break;
                    }
                    t = t + 1;
                }
            } else if (show_file_tree && mx >= 0.0f && mx < tree_w && my >= header_h && my <= (header_h + content_h)) {
                string clicked_path = ft.ft_click(&file_tree, mx, my);
                if (strlen(clicked_path) > 0) {
                    // Check if file is already open
                    int buf_i = 0;
                    bool found = false;
                    while (buf_i < buf_mgr->count) {
                        bm.EditorBuffer* b = bm.bufman_get(buf_mgr, buf_i);
                        if (strcmp(b->file_name, clicked_path) == 0) {
                            bm.bufman_switch(buf_mgr, buf_i);
                            found = true;
                            break;
                        }
                        buf_i = buf_i + 1;
                    }
                    if (!found && buf_mgr->count < 8) {
                        bm.bufman_open(buf_mgr, clicked_path, clicked_path, "// New buffer from explorer\n");
                    }
                    active_buf = bm.bufman_get_active(buf_mgr);
                    cur_state = &active_buf->state;
                }
            } else if (mx >= (tree_w + gutter_w) && mx <= cur_w && my >= header_h && my <= (header_h + content_h)) {
                int clicked_row = cur_state->scroll_row + (int)((my - header_h) / line_h);
                int clicked_col = (int)((mx - (tree_w + gutter_w) - 12.0f) / char_w);
                if (clicked_col < 0) { clicked_col = 0; }
                cur_state->cursor_row = clicked_row;
                cur_state->cursor_col = clicked_col;
                cur_state->move_cursor(0, 0, visible_rows);
            }
        }

        // Keyboard Navigation, Typing, & Shortcuts handling
        if (key_delay > 0) {
            key_delay = key_delay - 1;
        } else {
            bool ctrl_down = ginput.glfwGetKey(app.window, glc.GLFW_KEY_LEFT_CONTROL()) == glc.GLFW_PRESS() ||
                             ginput.glfwGetKey(app.window, glc.GLFW_KEY_RIGHT_CONTROL()) == glc.GLFW_PRESS();
            bool shift_down = ginput.glfwGetKey(app.window, glc.GLFW_KEY_LEFT_SHIFT()) == glc.GLFW_PRESS() ||
                              ginput.glfwGetKey(app.window, glc.GLFW_KEY_RIGHT_SHIFT()) == glc.GLFW_PRESS();

            if (find_bar.is_visible) {
                if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ESCAPE()) == glc.GLFW_PRESS()) {
                    find_bar.toggle();
                    key_delay = 10;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_BACKSPACE()) == glc.GLFW_PRESS()) {
                    find_bar.backspace();
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ENTER()) == glc.GLFW_PRESS()) {
                    find_bar.toggle();
                    key_delay = 10;
                } else if (!ctrl_down) {
                    poll_find_typing(app.window, &find_bar, shift_down);
                    key_delay = 6;
                }
            } else if ((ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_P()) == glc.GLFW_PRESS()) ||
                ginput.glfwGetKey(app.window, glc.GLFW_KEY_F1()) == glc.GLFW_PRESS()) {
                cmd_bar.toggle();
                key_delay = 12;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_F()) == glc.GLFW_PRESS()) {
                find_bar.toggle();
                key_delay = 12;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_B()) == glc.GLFW_PRESS()) {
                show_file_tree = !show_file_tree;
                key_delay = 12;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_F2()) == glc.GLFW_PRESS()) {
                cfg.config_cycle_theme(&editor_cfg);
                active_theme = theme.theme_load(editor_cfg.theme_id);
                viewport.apply_theme(
                    active_theme.bg,
                    active_theme.bg_active_line,
                    active_theme.cursor,
                    active_theme.fg,
                    active_theme.token_keyword,
                    active_theme.token_string,
                    active_theme.token_comment,
                    active_theme.token_number,
                    active_theme.token_operator
                );
                header_bg = active_theme.tab_bar_bg;
                header_fg = active_theme.fg;
                header_accent = active_theme.tab_active_accent;
                gutter.bg = active_theme.gutter_bg;
                gutter.fg = active_theme.gutter_fg;
                gutter.active_fg = active_theme.gutter_active_fg;
                key_delay = 15;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_TAB()) == glc.GLFW_PRESS()) {
                if (shift_down) {
                    bm.bufman_prev(buf_mgr);
                } else {
                    bm.bufman_next(buf_mgr);
                }
                active_buf = bm.bufman_get_active(buf_mgr);
                cur_state = &active_buf->state;
                key_delay = 12;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_W()) == glc.GLFW_PRESS()) {
                if (buf_mgr->count > 1) {
                    bm.bufman_close_active(buf_mgr);
                    active_buf = bm.bufman_get_active(buf_mgr);
                    cur_state = &active_buf->state;
                }
                key_delay = 14;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_GRAVE_ACCENT()) == glc.GLFW_PRESS()) {
                ts.split_toggle(term_split);
                key_delay = 12;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_L()) == glc.GLFW_PRESS()) {
                ts.split_clear(term_split);
                key_delay = 12;
            } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_F5()) == glc.GLFW_PRESS()) {
                term_split->is_open = true;
                ts.split_write(term_split, "\n>>> [BUILD] kale build ");
                ts.split_write(term_split, active_buf->file_name);
                ts.split_write(term_split, " --backend llvm-18 -O3\n");
                ts.split_write(term_split, ">>> Parsing & Typechecking: OK (12ms)\n");
                ts.split_write(term_split, ">>> LLVM IR Generated & Optimized: OK (28ms)\n");
                ts.split_write(term_split, ">>> Object Linker: bin/");
                ts.split_write(term_split, active_buf->file_name);
                ts.split_write(term_split, ".exe (0 warnings, 0 errors)\n> \n");
                key_delay = 15;
            } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_S()) == glc.GLFW_PRESS()) {
                cur_state->is_dirty = false;
                key_delay = 10;
            } else if (cmd_bar.is_visible) {
                if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ESCAPE()) == glc.GLFW_PRESS()) {
                    cmd_bar.toggle();
                    key_delay = 10;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_UP()) == glc.GLFW_PRESS()) {
                    cmd_bar.select_prev();
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_DOWN()) == glc.GLFW_PRESS()) {
                    cmd_bar.select_next();
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ENTER()) == glc.GLFW_PRESS()) {
                    int act_id = cmd_bar.get_selected_id();
                    if (act_id == 2) {
                        cur_state->is_dirty = false;
                    } else if (act_id == 4) {
                        ts.split_toggle(term_split);
                    } else if (act_id == 5) {
                        term_split->is_open = true;
                        ts.split_write(term_split, "\n>>> [BUILD] Compiling active buffer ");
                        ts.split_write(term_split, active_buf->file_name);
                        ts.split_write(term_split, "...\n>>> Success: 0 errors.\n> \n");
                    } else if (act_id == 6) {
                        term_split->is_open = true;
                        ts.split_write(term_split, "\n=== Kale Flagship IDE v1.0 ===\nPowered by OpenGL 3.3 Core, STB TrueType & GLFW\n> \n");
                    }
                    cmd_bar.toggle();
                    key_delay = 10;
                }
            } else {
                if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_Z()) == glc.GLFW_PRESS()) {
                    cur_state->undo();
                    key_delay = 8;
                } else if (ctrl_down && ginput.glfwGetKey(app.window, glc.GLFW_KEY_Y()) == glc.GLFW_PRESS()) {
                    cur_state->redo();
                    key_delay = 8;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_UP()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(-1, 0, visible_rows);
                    key_delay = 5;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_DOWN()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(1, 0, visible_rows);
                    key_delay = 5;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_LEFT()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(0, -1, visible_rows);
                    key_delay = 5;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_RIGHT()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(0, 1, visible_rows);
                    key_delay = 5;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_PAGE_UP()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(-visible_rows, 0, visible_rows);
                    key_delay = 8;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_PAGE_DOWN()) == glc.GLFW_PRESS()) {
                    cur_state->move_cursor(visible_rows, 0, visible_rows);
                    key_delay = 8;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_HOME()) == glc.GLFW_PRESS()) {
                    cur_state->cursor_col = 0;
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_END()) == glc.GLFW_PRESS()) {
                    string cur_l = cur_state->buffer.get_line(cur_state->cursor_row);
                    cur_state->cursor_col = strlen(cur_l);
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_BACKSPACE()) == glc.GLFW_PRESS()) {
                    cur_state->backspace();
                    key_delay = 6;
                } else if (ginput.glfwGetKey(app.window, glc.GLFW_KEY_ENTER()) == glc.GLFW_PRESS()) {
                    cur_state->insert_newline();
                    key_delay = 8;
                } else if (!ctrl_down) {
                    poll_typing(app.window, cur_state, shift_down);
                    key_delay = 6;
                }
            }
        }

        // Render Header bar & Multi-Buffer Tabs
        rmath.Color header_divider = rmath.color_rgba(0.22f, 0.24f, 0.28f, 1.0f);
        rmath.Color tab_inactive_bg = active_theme.tab_bar_bg;
        rmath.Color tab_active_bg = active_theme.tab_active_bg;
        rmath.Color tab_inactive_fg = active_theme.tab_inactive_fg;

        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, 0.0f, cur_w, header_h, header_bg);
        app.ui_ctx.renderer.push_quad(&app.gl_ctx, 0.0f, header_h - 1.0f, cur_w, 1.0f, header_divider);

        float tab_w = 180.0f;
        float tab_y = 6.0f;
        float tab_h = header_h - 6.0f;

        int t = 0;
        while (t < buf_mgr->count) {
            bm.EditorBuffer* b = bm.bufman_get(buf_mgr, t);
            float tab_x = 10.0f + ((float)t * (tab_w + 6.0f));
            bool is_active = (t == buf_mgr->active_index);

            rmath.Color cur_tab_bg = tab_inactive_bg;
            rmath.Color cur_tab_fg = tab_inactive_fg;
            if (is_active) {
                cur_tab_bg = tab_active_bg;
                cur_tab_fg = header_fg;
            }

            app.ui_ctx.renderer.push_quad(&app.gl_ctx, tab_x, tab_y, tab_w, tab_h, cur_tab_bg);
            if (is_active) {
                app.ui_ctx.renderer.push_quad(&app.gl_ctx, tab_x, tab_y, tab_w, 2.0f, header_accent);
            }

            // Tab title
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, b->file_name, tab_x + 14.0f, tab_y + 8.0f, cur_tab_fg);
            if (b->state.is_dirty) {
                float name_w = app.ui_ctx.font.measure_text(b->file_name);
                app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "*", tab_x + 16.0f + name_w, tab_y + 8.0f, header_accent);
            }

            // Close button 'x' indicator
            rmath.Color close_fg = rmath.color_rgba(0.50f, 0.52f, 0.58f, 1.0f);
            app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "x", tab_x + tab_w - 18.0f, tab_y + 7.0f, close_fg);

            t = t + 1;
        }

        // Right header shortcuts indicator
        rmath.Color hint_fg = rmath.color_rgba(0.48f, 0.52f, 0.60f, 1.0f);
        app.ui_ctx.font.draw_text(&app.ui_ctx.renderer, &app.gl_ctx, "[Ctrl+B] Tree  [Ctrl+F] Find  [F2] Theme  [Ctrl+Tab] Tabs  [Ctrl+`] Term", cur_w - 650.0f, 12.0f, hint_fg);

        // Render File Tree Panel if visible
        if (show_file_tree) {
            file_tree.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, active_buf->file_name);
        }

        // Render Components
        int total_lines = cur_state->buffer.line_count();
        gutter.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, cur_state->scroll_row, cur_state->cursor_row, total_lines);
        viewport.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, &cur_state->buffer, cur_state->scroll_row, cur_state->cursor_row, cur_state->cursor_col);

        if (term_split->is_open) {
            terminal_pane.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, term_split);
        }

        status_bar.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, cur_state->cursor_row, cur_state->cursor_col, total_lines, cur_state->is_dirty);

        // Render Floating Find Bar
        find_bar.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, cur_w, cur_h);

        // Render Command Bar Overlay if active
        cmd_bar.render(&app.ui_ctx.renderer, &app.gl_ctx, &app.ui_ctx.font, cur_w, cur_h);

        app.end_frame();
    }

    find_bar.destroy();
    terminal_pane.destroy();
    bm.bufman_free(buf_mgr);
    ts.split_free(term_split);
    app.close();
}

fn int main_entry() {
    run_editor();
    return 0;
}

main_entry();

// editor/status_bar.kl
// GPU-Accelerated Status Bar Component for Kale Code Editor

import "libs/gl/loader.kl" as glloader;
import "libs/render/math.kl" as rmath;
import "libs/render/batch.kl" as rbatch;
import "libs/render/font.kl" as rfont;
import "packages/std/text/string_builder.kl" as sb;

extern int strlen(string s);

struct StatusBar {
    float x;
    float y;
    float width;
    float height;

    rmath.Color bg;
    rmath.Color fg;
    rmath.Color accent_fg;
    rmath.Color border;
}

fn void StatusBar.init(float x, float y, float w, float h) {
    this->x = x;
    this->y = y;
    this->width = w;
    this->height = h;

    this->bg = rmath.color_rgba(0.08f, 0.40f, 0.65f, 1.0f);       // VS Code blue tint
    this->fg = rmath.color_rgba(0.96f, 0.96f, 0.98f, 1.0f);
    this->accent_fg = rmath.color_rgba(0.75f, 0.88f, 1.0f, 1.0f);
    this->border = rmath.color_rgba(0.12f, 0.45f, 0.72f, 1.0f);
}

fn void StatusBar.render(
    rbatch.BatchRenderer* renderer,
    glloader.GLContext* gl_ctx,
    rfont.FontAtlas* font,
    int cursor_row,
    int cursor_col,
    int total_lines,
    bool is_dirty
) {
    // Fill status bar background
    renderer->push_quad(gl_ctx, this->x, this->y, this->width, this->height, this->bg);
    renderer->push_quad(gl_ctx, this->x, this->y, this->width, 1.0f, this->border);

    float text_y = this->y + 4.0f;

    // Left info
    string status_tag = " [Kale GPU Editor] ";
    if (is_dirty) {
        status_tag = " [Kale GPU Editor *] ";
    }
    font->draw_text(renderer, gl_ctx, status_tag, this->x + 12.0f, text_y, this->fg);

    // Center help
    string help_msg = " [Arrows] Navigate   [Type] Edit   [Enter] Newline   [Bksp] Delete   [Ctrl+P] Command";
    font->draw_text(renderer, gl_ctx, help_msg, this->x + 220.0f, text_y, this->accent_fg);

    // Right info: Ln X, Col Y, UTF-8, Kale
    sb.StringBuilder pos_sb;
    pos_sb.init(32);
    pos_sb.append("Ln ");
    pos_sb.append_int(cursor_row + 1);
    pos_sb.append(", Col ");
    pos_sb.append_int(cursor_col + 1);
    pos_sb.append("  |  UTF-8  |  Kale (OpenGL 3.3)");
    string pos_str = pos_sb.to_string();

    float right_w = font->measure_text(pos_str);
    float right_x = this->x + this->width - right_w - 16.0f;
    if (right_x > this->x + 480.0f) {
        font->draw_text(renderer, gl_ctx, pos_str, right_x, text_y, this->fg);
    }
    free((void*)pos_str);
    pos_sb.destroy();
}

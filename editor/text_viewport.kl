// editor/text_viewport.kl
// GPU-Accelerated Syntax-Highlighted Text Viewport for Kale Code Editor

import "libs/gl/loader.kl" as glloader;
import "libs/render/math.kl" as rmath;
import "libs/render/batch.kl" as rbatch;
import "libs/render/font.kl" as rfont;
import "packages/std/text/piece_table.kl" as pt;
import "packages/std/text/string_builder.kl" as sb;
import "packages/editor/syntax.kl" as syn;

extern int strlen(string s);

struct TextViewport {
    float x;
    float y;
    float width;
    float height;
    float char_width;
    float line_height;

    rmath.Color bg_color;
    rmath.Color active_line_bg;
    rmath.Color cursor_color;
    rmath.Color selection_bg;
    rmath.Color find_highlight;
    rmath.Color error_color;

    rmath.Color color_default;
    rmath.Color color_keyword;
    rmath.Color color_string;
    rmath.Color color_comment;
    rmath.Color color_number;
    rmath.Color color_operator;
}

fn void TextViewport.init(float x, float y, float w, float h, float line_h, float char_w) {
    this->x = x;
    this->y = y;
    this->width = w;
    this->height = h;
    this->line_height = line_h;
    this->char_width = char_w;

    this->bg_color = rmath.color_rgba(0.12f, 0.12f, 0.14f, 1.0f);
    this->active_line_bg = rmath.color_rgba(0.18f, 0.20f, 0.24f, 1.0f);
    this->cursor_color = rmath.color_rgba(0.35f, 0.65f, 1.0f, 1.0f);
    this->selection_bg = rmath.color_rgba(0.26f, 0.38f, 0.58f, 0.70f);
    this->find_highlight = rmath.color_rgba(0.95f, 0.78f, 0.20f, 0.45f);
    this->error_color = rmath.color_rgba(0.95f, 0.25f, 0.25f, 0.90f);

    // Syntax colors
    this->color_default = rmath.color_rgba(0.85f, 0.88f, 0.92f, 1.0f);
    this->color_keyword = rmath.color_rgba(0.35f, 0.65f, 0.95f, 1.0f);
    this->color_string = rmath.color_rgba(0.85f, 0.60f, 0.35f, 1.0f);
    this->color_comment = rmath.color_rgba(0.40f, 0.60f, 0.40f, 1.0f);
    this->color_number = rmath.color_rgba(0.70f, 0.85f, 0.50f, 1.0f);
    this->color_operator = rmath.color_rgba(0.75f, 0.75f, 0.80f, 1.0f);
}

fn void TextViewport.apply_theme(
    rmath.Color bg,
    rmath.Color active_line,
    rmath.Color cursor,
    rmath.Color sel_bg,
    rmath.Color def,
    rmath.Color kw,
    rmath.Color str,
    rmath.Color com,
    rmath.Color num,
    rmath.Color op
) {
    this->bg_color = bg;
    this->active_line_bg = active_line;
    this->cursor_color = cursor;
    this->selection_bg = sel_bg;
    this->color_default = def;
    this->color_keyword = kw;
    this->color_string = str;
    this->color_comment = com;
    this->color_number = num;
    this->color_operator = op;
}

fn rmath.Color TextViewport.get_token_color(int token_type) {
    if (token_type == 1) { return this->color_keyword; }
    if (token_type == 2) { return this->color_string; }
    if (token_type == 3) { return this->color_comment; }
    if (token_type == 4) { return this->color_number; }
    if (token_type == 5) { return this->color_operator; }
    return this->color_default;
}

fn void TextViewport.render(
    rbatch.BatchRenderer* renderer,
    glloader.GLContext* gl_ctx,
    rfont.FontAtlas* font,
    pt.PieceTable* buffer,
    int scroll_row,
    int cursor_row,
    int cursor_col,
    bool has_selection,
    int sel_start_row,
    int sel_start_col,
    int sel_end_row,
    int sel_end_col,
    bool show_find,
    string find_query,
    int diag_err_line
) {
    // Fill viewport background panel
    renderer->push_quad(gl_ctx, this->x, this->y, this->width, this->height, this->bg_color);

    // Apply hardware scissor clipping for viewport
    renderer->set_clip_rect(gl_ctx, this->x, this->y, this->width, this->height);

    int total_lines = buffer->line_count();
    int visible_lines = (int)(this->height / this->line_height);
    int row_idx = 0;
    int find_q_len = strlen(find_query);

    char* token_buf = alloc(char, 1024);

    while (row_idx < visible_lines) {
        int current_line_num = scroll_row + row_idx;
        float cur_y = this->y + ((float)row_idx * this->line_height);

        if (current_line_num < total_lines) {
            // Draw active line highlight
            if (current_line_num == cursor_row) {
                renderer->push_quad(gl_ctx, this->x, cur_y, this->width, this->line_height, this->active_line_bg);
            }

            string line_str = buffer->get_line(current_line_num);
            int len = strlen(line_str);

            // 1. Draw Selection background for this line
            if (has_selection && current_line_num >= sel_start_row && current_line_num <= sel_end_row) {
                int line_sel_start = 0;
                int line_sel_end = len;

                if (current_line_num == sel_start_row) {
                    line_sel_start = sel_start_col;
                }
                if (current_line_num == sel_end_row) {
                    line_sel_end = sel_end_col;
                }

                if (line_sel_start < 0) { line_sel_start = 0; }
                if (line_sel_end > len) { line_sel_end = len; }

                if (line_sel_end > line_sel_start) {
                    float sel_x = this->x + 12.0f + ((float)line_sel_start * this->char_width);
                    float sel_w = (float)(line_sel_end - line_sel_start) * this->char_width;
                    renderer->push_quad(gl_ctx, sel_x, cur_y, sel_w, this->line_height, this->selection_bg);
                } else if (current_line_num < sel_end_row) {
                    // Multi-line selection extending beyond end of line
                    float sel_x = this->x + 12.0f + ((float)line_sel_start * this->char_width);
                    float sel_w = this->char_width;
                    renderer->push_quad(gl_ctx, sel_x, cur_y, sel_w, this->line_height, this->selection_bg);
                }
            }

            // 2. Draw Find match highlights on this line
            if (show_find && find_q_len > 0 && len >= find_q_len) {
                int fc = 0;
                while (fc <= (len - find_q_len)) {
                    bool match = true;
                    int k = 0;
                    while (k < find_q_len) {
                        if (line_str[fc + k] != find_query[k]) {
                            match = false;
                            break;
                        }
                        k = k + 1;
                    }
                    if (match) {
                        float m_x = this->x + 12.0f + ((float)fc * this->char_width);
                        float m_w = (float)find_q_len * this->char_width;
                        renderer->push_quad(gl_ctx, m_x, cur_y, m_w, this->line_height, this->find_highlight);
                        fc = fc + find_q_len - 1;
                    }
                    fc = fc + 1;
                }
            }

            // 3. Syntax highlight text tokens
            syn.LineHighlighter hl;
            hl.init();
            hl.highlight_line(line_str);
            int span_count = hl.get_count();

            if (span_count == 0) {
                font->draw_text(renderer, gl_ctx, line_str, this->x + 12.0f, cur_y + 2.0f, this->color_default);
            } else {
                int s_idx = 0;
                while (s_idx < span_count) {
                    syn.TokenSpan span = hl.get_span(s_idx);
                    rmath.Color token_color = this->get_token_color(span.token_type);

                    int span_len = span.length;
                    if (span_len > 1020) {
                        span_len = 1020;
                    }
                    int ch_i = 0;
                    while (ch_i < span_len && span.start_col + ch_i < len) {
                        token_buf[ch_i] = line_str[span.start_col + ch_i];
                        ch_i = ch_i + 1;
                    }
                    token_buf[ch_i] = (char)0;

                    float token_x = this->x + 12.0f + ((float)span.start_col * this->char_width);
                    font->draw_text(renderer, gl_ctx, (string)token_buf, token_x, cur_y + 2.0f, token_color);
                    s_idx = s_idx + 1;
                }
            }
            hl.destroy();

            // 4. Diagnostic Squiggle / Underline if this line has an LSP error
            if (current_line_num == diag_err_line) {
                float err_w = (float)len * this->char_width;
                if (err_w < this->char_width * 4.0f) {
                    err_w = this->char_width * 4.0f;
                }
                renderer->push_quad(gl_ctx, this->x + 12.0f, cur_y + this->line_height - 3.0f, err_w, 2.0f, this->error_color);
            }
        }
        row_idx = row_idx + 1;
    }

    free(token_buf);

    // Render active caret (cursor)
    int cursor_visual_row = cursor_row - scroll_row;
    if (cursor_visual_row >= 0 && cursor_visual_row < visible_lines) {
        float caret_x = this->x + 12.0f + ((float)cursor_col * this->char_width);
        float caret_y = this->y + ((float)cursor_visual_row * this->line_height) + 2.0f;
        renderer->push_quad(gl_ctx, caret_x, caret_y, 2.0f, this->line_height - 4.0f, this->cursor_color);
    }

    renderer->reset_clip(gl_ctx);
}

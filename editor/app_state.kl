// apps/editor/app_state.kl
// State Management for Kale Code Editor

import "packages/std/text/piece_table.kl" as pt;

extern int strlen(string s);
extern void* malloc(int size);

struct EditAction {
    int offset;
    int length;
    int kind;
    string text;
}

struct BufferTab {
    pt.PieceTable buffer;
    string file_path;
    bool is_dirty;
}

struct EditorState {
    pt.PieceTable buffer;
    int cursor_row;
    int cursor_col;
    int scroll_row;
    int scroll_col;
    string file_path;
    bool is_dirty;
    EditAction* undo_stack;
    int undo_count;
    EditAction* redo_stack;
    int redo_count;
    int command_bar_visible;
    int active_command;
    BufferTab[8] tabs;
    int tab_count;
    int active_tab;
}

fn void EditorState.init(string initial_code, string file_path) {
    this->buffer.init(initial_code);
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->scroll_row = 0;
    this->scroll_col = 0;
    this->file_path = file_path;
    this->is_dirty = false;
    this->undo_stack = (EditAction*)0;
    this->undo_count = 0;
    this->redo_stack = (EditAction*)0;
    this->redo_count = 0;
    this->command_bar_visible = 0;
    this->active_command = 0;
    this->tab_count = 1;
    this->active_tab = 0;
    this->tabs[0].buffer.init(initial_code);
    this->tabs[0].file_path = file_path;
    this->tabs[0].is_dirty = false;
}

fn int EditorState.open_buffer(string initial_code, string file_path) {
    if (this->tab_count >= 8) { return 0; }
    this->tabs[this->tab_count].buffer.init(initial_code);
    this->tabs[this->tab_count].file_path = file_path;
    this->tabs[this->tab_count].is_dirty = false;
    this->active_tab = this->tab_count;
    this->tab_count = this->tab_count + 1;
    return 1;
}

fn int EditorState.switch_buffer(int tab_index) {
    if (tab_index < 0 || tab_index >= this->tab_count) { return 0; }
    if (tab_index == this->active_tab) { return 1; }
    string current_text = this->buffer.get_text();
    this->tabs[this->active_tab].buffer.destroy();
    this->tabs[this->active_tab].buffer.init(current_text);
    this->tabs[this->active_tab].is_dirty = this->is_dirty;
    string next_text = this->tabs[tab_index].buffer.get_text();
    this->buffer.destroy();
    this->buffer.init(next_text);
    this->active_tab = tab_index;
    this->file_path = this->tabs[tab_index].file_path;
    this->is_dirty = this->tabs[tab_index].is_dirty;
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->scroll_row = 0;
    return 1;
}

fn int EditorState.cursor_offset() {
    return this->buffer.line_to_offset(this->cursor_row) + this->cursor_col;
}

fn void EditorState.record_action(int offset, int length, int kind, string text) {
    if (this->undo_stack == (EditAction*)0) {
        this->undo_stack = (EditAction*)malloc(4096);
    }
    this->undo_stack[this->undo_count].offset = offset;
    this->undo_stack[this->undo_count].length = length;
    this->undo_stack[this->undo_count].kind = kind;
    this->undo_stack[this->undo_count].text = text;
    if (this->undo_count < 127) { this->undo_count = this->undo_count + 1; }
    this->redo_count = 0;
}

fn void EditorState.move_cursor(int d_row, int d_col, int visible_rows) {
    int lines = this->buffer.line_count();
    this->cursor_row = this->cursor_row + d_row;
    if (this->cursor_row < 0) {
        this->cursor_row = 0;
    }
    if (this->cursor_row >= lines && lines > 0) {
        this->cursor_row = lines - 1;
    }

    // Clamp column to current line length
    string current_line = this->buffer.get_line(this->cursor_row);
    int line_len = strlen(current_line);
    this->cursor_col = this->cursor_col + d_col;
    if (this->cursor_col < 0) {
        this->cursor_col = 0;
    }
    if (this->cursor_col > line_len) {
        this->cursor_col = line_len;
    }

    // Auto-scroll viewport to keep cursor visible
    if (this->cursor_row < this->scroll_row) {
        this->scroll_row = this->cursor_row;
    }
    if (this->cursor_row >= this->scroll_row + visible_rows) {
        this->scroll_row = this->cursor_row - visible_rows + 1;
    }
}

fn void EditorState.insert_char(string ch) {
    int byte_offset = this->cursor_offset();
    this->buffer.insert(byte_offset, ch);
    this->record_action(byte_offset, strlen(ch), 1, ch);
    this->cursor_col = this->cursor_col + strlen(ch);
    this->is_dirty = true;
    this->tabs[this->active_tab].is_dirty = true;
}

fn void EditorState.insert_newline() {
    this->insert_char("\n");
    this->cursor_row = this->cursor_row + 1;
    this->cursor_col = 0;
}

fn void EditorState.backspace() {
    if (this->cursor_col > 0) {
        int byte_offset = this->cursor_offset() - 1;
        string deleted = this->buffer.get_line(this->cursor_row);
        this->buffer.delete(byte_offset, 1);
        this->record_action(byte_offset, 1, 2, deleted);
        this->cursor_col = this->cursor_col - 1;
        this->is_dirty = true;
        this->tabs[this->active_tab].is_dirty = true;
    } else {
        if (this->cursor_row > 0) {
            // Join with previous line
            int prev_row = this->cursor_row - 1;
            string prev_line = this->buffer.get_line(prev_row);
            int prev_len = strlen(prev_line);

            int lines = this->buffer.line_count();
            int byte_offset = 0;
            int row = 0;
            while (row < prev_row && row < lines) {
                string l = this->buffer.get_line(row);
                byte_offset = byte_offset + strlen(l) + 1;
                row = row + 1;
            }

            byte_offset = byte_offset + prev_len; // Point to newline
            this->buffer.delete(byte_offset, 1); // Delete newline
            this->cursor_row = prev_row;
            this->cursor_col = prev_len;
            this->is_dirty = true;
            this->tabs[this->active_tab].is_dirty = true;
        }
    }
}

fn int EditorState.undo() {
    if (this->undo_count <= 0) { return 0; }
    this->undo_count = this->undo_count - 1;
    EditAction action = this->undo_stack[this->undo_count];
    if (this->redo_stack == (EditAction*)0) { this->redo_stack = (EditAction*)malloc(4096); }
    this->redo_stack[this->redo_count] = action;
    if (action.kind == 1) { this->buffer.delete(action.offset, action.length); }
    else { this->buffer.insert(action.offset, action.text); }
    this->redo_count = this->redo_count + 1;
    this->is_dirty = true;
    this->tabs[this->active_tab].is_dirty = true;
    return 1;
}

fn int EditorState.redo() {
    if (this->redo_count <= 0) { return 0; }
    this->redo_count = this->redo_count - 1;
    EditAction action = this->redo_stack[this->redo_count];
    if (action.kind == 1) { this->buffer.insert(action.offset, action.text); }
    else { this->buffer.delete(action.offset, action.length); }
    this->is_dirty = true;
    this->tabs[this->active_tab].is_dirty = true;
    return 1;
}

fn void EditorState.destroy() {
    this->buffer.destroy();
    int i = 0;
    while (i < this->tab_count) {
        this->tabs[i].buffer.destroy();
        i = i + 1;
    }
    if (this->undo_stack != (EditAction*)0) { free(this->undo_stack); }
    if (this->redo_stack != (EditAction*)0) { free(this->redo_stack); }
}

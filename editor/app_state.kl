// editor/app_state.kl
// State Management for Kale Code Editor with Undo/Redo and Multi-Buffer Support

import "packages/std/text/piece_table.kl" as pt;

extern int strlen(string s);

struct EditAction {
    int kind; // 1 = insert, 2 = delete
    int offset;
    string text;
    int row;
    int col;
}

struct EditorState {
    pt.PieceTable buffer;
    int cursor_row;
    int cursor_col;
    int scroll_row;
    int scroll_col;
    string file_path;
    bool is_dirty;

    // Selection range (anchor to cursor)
    bool has_selection;
    int sel_anchor_row;
    int sel_anchor_col;

    // Undo / Redo history
    EditAction* undo_stack;
    int undo_count;
    int undo_cap;
    EditAction* redo_stack;
    int redo_count;
    int redo_cap;
}

fn void EditorState.init(string initial_code, string file_path) {
    this->buffer.init(initial_code);
    this->cursor_row = 0;
    this->cursor_col = 0;
    this->scroll_row = 0;
    this->scroll_col = 0;
    this->file_path = file_path;
    this->is_dirty = false;

    this->has_selection = false;
    this->sel_anchor_row = 0;
    this->sel_anchor_col = 0;

    this->undo_cap = 32;
    this->undo_count = 0;
    this->undo_stack = alloc(EditAction, 32);

    this->redo_cap = 32;
    this->redo_count = 0;
    this->redo_stack = alloc(EditAction, 32);
}

fn void EditorState.push_undo(int kind, int offset, string text, int row, int col) {
    if (this->undo_count < this->undo_cap) {
        this->undo_stack[this->undo_count].kind = kind;
        this->undo_stack[this->undo_count].offset = offset;
        this->undo_stack[this->undo_count].text = text;
        this->undo_stack[this->undo_count].row = row;
        this->undo_stack[this->undo_count].col = col;
        this->undo_count = this->undo_count + 1;
    }
    this->redo_count = 0; // Clear redo on fresh edit
}

fn void EditorState.move_cursor(int d_row, int d_col, int visible_rows) {
    int lines = this->buffer.line_count();
    this->cursor_row = this->cursor_row + d_row;
    if (this->cursor_row < 0) {
        this->cursor_row = 0;
    }
    if (this->cursor_row >= lines && lines > 0) {
        this->cursor_row = lines - 1;
    }

    // Clamp column to current line length
    string current_line = this->buffer.get_line(this->cursor_row);
    int line_len = strlen(current_line);
    this->cursor_col = this->cursor_col + d_col;
    if (this->cursor_col < 0) {
        this->cursor_col = 0;
    }
    if (this->cursor_col > line_len) {
        this->cursor_col = line_len;
    }

    // Auto-scroll viewport to keep cursor visible
    if (this->cursor_row < this->scroll_row) {
        this->scroll_row = this->cursor_row;
    }
    if (this->cursor_row >= this->scroll_row + visible_rows) {
        this->scroll_row = this->cursor_row - visible_rows + 1;
    }
}

fn void EditorState.start_selection() {
    this->has_selection = true;
    this->sel_anchor_row = this->cursor_row;
    this->sel_anchor_col = this->cursor_col;
}

fn void EditorState.clear_selection() {
    this->has_selection = false;
    this->sel_anchor_row = this->cursor_row;
    this->sel_anchor_col = this->cursor_col;
}

fn void EditorState.select_all() {
    this->has_selection = true;
    this->sel_anchor_row = 0;
    this->sel_anchor_col = 0;
    int lines = this->buffer.line_count();
    if (lines > 0) {
        this->cursor_row = lines - 1;
        string last_line = this->buffer.get_line(this->cursor_row);
        this->cursor_col = strlen(last_line);
    } else {
        this->cursor_row = 0;
        this->cursor_col = 0;
    }
}

fn void EditorState.move_cursor_select(int d_row, int d_col, int visible_rows) {
    if (!this->has_selection) {
        this->start_selection();
    }
    this->move_cursor(d_row, d_col, visible_rows);
}

fn void EditorState.update_drag_selection(int row, int col) {
    if (!this->has_selection) {
        this->start_selection();
    }
    int lines = this->buffer.line_count();
    if (row < 0) { row = 0; }
    if (row >= lines && lines > 0) { row = lines - 1; }
    string cur_line = this->buffer.get_line(row);
    int line_len = strlen(cur_line);
    if (col < 0) { col = 0; }
    if (col > line_len) { col = line_len; }

    this->cursor_row = row;
    this->cursor_col = col;
}

fn int EditorState.pos_to_byte_offset(int row, int col) {
    int lines = this->buffer.line_count();
    int byte_offset = 0;
    int r = 0;
    while (r < row && r < lines) {
        string l = this->buffer.get_line(r);
        byte_offset = byte_offset + strlen(l) + 1; // +1 for \n
        r = r + 1;
    }
    return byte_offset + col;
}

fn int EditorState.get_cursor_byte_offset() {
    return this->pos_to_byte_offset(this->cursor_row, this->cursor_col);
}

fn int EditorState.get_sel_start_row() {
    if (this->sel_anchor_row < this->cursor_row) { return this->sel_anchor_row; }
    if (this->sel_anchor_row > this->cursor_row) { return this->cursor_row; }
    return this->cursor_row;
}

fn int EditorState.get_sel_start_col() {
    if (this->sel_anchor_row < this->cursor_row) { return this->sel_anchor_col; }
    if (this->sel_anchor_row > this->cursor_row) { return this->cursor_col; }
    if (this->sel_anchor_col < this->cursor_col) { return this->sel_anchor_col; }
    return this->cursor_col;
}

fn int EditorState.get_sel_end_row() {
    if (this->sel_anchor_row > this->cursor_row) { return this->sel_anchor_row; }
    if (this->sel_anchor_row < this->cursor_row) { return this->cursor_row; }
    return this->cursor_row;
}

fn int EditorState.get_sel_end_col() {
    if (this->sel_anchor_row > this->cursor_row) { return this->sel_anchor_col; }
    if (this->sel_anchor_row < this->cursor_row) { return this->cursor_col; }
    if (this->sel_anchor_col > this->cursor_col) { return this->sel_anchor_col; }
    return this->cursor_col;
}

fn bool EditorState.delete_selection() {
    if (!this->has_selection) {
        return false;
    }
    int sr = this->get_sel_start_row();
    int sc = this->get_sel_start_col();
    int er = this->get_sel_end_row();
    int ec = this->get_sel_end_col();

    if (sr == er && sc == ec) {
        this->clear_selection();
        return false;
    }

    int start_off = this->pos_to_byte_offset(sr, sc);
    int end_off = this->pos_to_byte_offset(er, ec);
    int del_len = end_off - start_off;

    if (del_len > 0) {
        string deleted_text = this->buffer.get_slice(start_off, del_len);
        this->push_undo(2, start_off, deleted_text, sr, sc);
        this->buffer.delete(start_off, del_len);
        this->cursor_row = sr;
        this->cursor_col = sc;
        this->is_dirty = true;
    }

    this->clear_selection();
    return true;
}

fn void EditorState.insert_char(string ch) {
    int byte_offset = this->get_cursor_byte_offset();
    this->push_undo(1, byte_offset, ch, this->cursor_row, this->cursor_col);

    this->buffer.insert(byte_offset, ch);
    this->cursor_col = this->cursor_col + strlen(ch);
    this->is_dirty = true;
}

fn void EditorState.insert_newline() {
    this->insert_char("\n");
    this->cursor_row = this->cursor_row + 1;
    this->cursor_col = 0;
}

fn void EditorState.insert_char_auto_pair(string ch) {
    if (this->has_selection) {
        this->delete_selection();
    }
    char c = ch[0];
    if (c == '(') {
        int byte_offset = this->get_cursor_byte_offset();
        this->push_undo(1, byte_offset, "()", this->cursor_row, this->cursor_col);
        this->buffer.insert(byte_offset, "()");
        this->cursor_col = this->cursor_col + 1;
        this->is_dirty = true;
        return;
    }
    if (c == '[') {
        int byte_offset = this->get_cursor_byte_offset();
        this->push_undo(1, byte_offset, "[]", this->cursor_row, this->cursor_col);
        this->buffer.insert(byte_offset, "[]");
        this->cursor_col = this->cursor_col + 1;
        this->is_dirty = true;
        return;
    }
    if (c == '{') {
        int byte_offset = this->get_cursor_byte_offset();
        this->push_undo(1, byte_offset, "{}", this->cursor_row, this->cursor_col);
        this->buffer.insert(byte_offset, "{}");
        this->cursor_col = this->cursor_col + 1;
        this->is_dirty = true;
        return;
    }
    if (c == '"') {
        int byte_offset = this->get_cursor_byte_offset();
        this->push_undo(1, byte_offset, "\"\"", this->cursor_row, this->cursor_col);
        this->buffer.insert(byte_offset, "\"\"");
        this->cursor_col = this->cursor_col + 1;
        this->is_dirty = true;
        return;
    }
    if (c == '\'') {
        int byte_offset = this->get_cursor_byte_offset();
        this->push_undo(1, byte_offset, "''", this->cursor_row, this->cursor_col);
        this->buffer.insert(byte_offset, "''");
        this->cursor_col = this->cursor_col + 1;
        this->is_dirty = true;
        return;
    }

    this->insert_char(ch);
}

fn void EditorState.insert_smart_newline() {
    if (this->has_selection) {
        this->delete_selection();
    }

    string cur_line = this->buffer.get_line(this->cursor_row);
    int line_len = strlen(cur_line);

    // Count leading spaces
    int indent_spaces = 0;
    while (indent_spaces < line_len && cur_line[indent_spaces] == ' ') {
        indent_spaces = indent_spaces + 1;
    }

    // Check if previous character before cursor is '{'
    bool extra_indent = false;
    int check_col = this->cursor_col;
    if (check_col > line_len) {
        check_col = line_len;
    }
    if (check_col > 0) {
        int p = check_col - 1;
        while (p >= 0 && cur_line[p] == ' ') {
            p = p - 1;
        }
        if (p >= 0 && cur_line[p] == '{') {
            extra_indent = true;
        }
    }

    int total_spaces = indent_spaces;
    if (extra_indent) {
        total_spaces = total_spaces + 4;
    }

    // Build newline + indent string
    int alloc_len = total_spaces + 2;
    char* ins_buf = alloc(char, alloc_len);
    ins_buf[0] = '\n';
    int i = 0;
    while (i < total_spaces) {
        ins_buf[1 + i] = ' ';
        i = i + 1;
    }
    ins_buf[1 + total_spaces] = (char)0;

    int byte_offset = this->get_cursor_byte_offset();
    this->push_undo(1, byte_offset, (string)ins_buf, this->cursor_row, this->cursor_col);
    this->buffer.insert(byte_offset, (string)ins_buf);

    this->cursor_row = this->cursor_row + 1;
    this->cursor_col = total_spaces;
    this->is_dirty = true;

    free((void*)ins_buf);
}

fn void EditorState.toggle_comment() {
    int sr = this->cursor_row;
    int er = this->cursor_row;
    if (this->has_selection) {
        sr = this->get_sel_start_row();
        er = this->get_sel_end_row();
    }

    int r = sr;
    while (r <= er && r < this->buffer.line_count()) {
        string l = this->buffer.get_line(r);
        int l_len = strlen(l);
        int line_start_off = this->pos_to_byte_offset(r, 0);

        if (l_len >= 2 && l[0] == '/' && l[1] == '/') {
            // Uncomment: remove "// " or "//"
            int del_cnt = 2;
            if (l_len >= 3 && l[2] == ' ') {
                del_cnt = 3;
            }
            string del_txt = this->buffer.get_slice(line_start_off, del_cnt);
            this->push_undo(2, line_start_off, del_txt, r, 0);
            this->buffer.delete(line_start_off, del_cnt);
            if (r == this->cursor_row) {
                this->cursor_col = this->cursor_col - del_cnt;
                if (this->cursor_col < 0) { this->cursor_col = 0; }
            }
        } else {
            // Comment: insert "// " at beginning
            this->push_undo(1, line_start_off, "// ", r, 0);
            this->buffer.insert(line_start_off, "// ");
            if (r == this->cursor_row) {
                this->cursor_col = this->cursor_col + 3;
            }
        }
        r = r + 1;
    }
    this->is_dirty = true;
}

fn void EditorState.backspace() {
    if (this->cursor_col > 0) {
        int byte_offset = this->get_cursor_byte_offset() - 1;
        string deleted_ch = this->buffer.get_slice(byte_offset, 1);
        this->push_undo(2, byte_offset, deleted_ch, this->cursor_row, this->cursor_col);

        this->buffer.delete(byte_offset, 1);
        this->cursor_col = this->cursor_col - 1;
        this->is_dirty = true;
    } else {
        if (this->cursor_row > 0) {
            // Join with previous line
            int prev_row = this->cursor_row - 1;
            string prev_line = this->buffer.get_line(prev_row);
            int prev_len = strlen(prev_line);

            int lines = this->buffer.line_count();
            int byte_offset = 0;
            int row = 0;
            while (row < prev_row && row < lines) {
                string l = this->buffer.get_line(row);
                byte_offset = byte_offset + strlen(l) + 1;
                row = row + 1;
            }
            byte_offset = byte_offset + prev_len; // Point to newline
            this->push_undo(2, byte_offset, "\n", this->cursor_row, this->cursor_col);

            this->buffer.delete(byte_offset, 1); // Delete newline
            this->cursor_row = prev_row;
            this->cursor_col = prev_len;
            this->is_dirty = true;
        }
    }
}

fn void EditorState.undo() {
    if (this->undo_count <= 0) {
        return;
    }
    this->undo_count = this->undo_count - 1;
    EditAction act = this->undo_stack[this->undo_count];

    if (act.kind == 1) {
        // Was insert -> delete it
        this->buffer.delete(act.offset, strlen(act.text));
        this->cursor_row = act.row;
        this->cursor_col = act.col;
    } else if (act.kind == 2) {
        // Was delete -> re-insert it
        this->buffer.insert(act.offset, act.text);
        this->cursor_row = act.row;
        this->cursor_col = act.col;
    }

    if (this->redo_count < this->redo_cap) {
        this->redo_stack[this->redo_count] = act;
        this->redo_count = this->redo_count + 1;
    }
    this->is_dirty = true;
}

fn void EditorState.redo() {
    if (this->redo_count <= 0) {
        return;
    }
    this->redo_count = this->redo_count - 1;
    EditAction act = this->redo_stack[this->redo_count];

    if (act.kind == 1) {
        this->buffer.insert(act.offset, act.text);
        this->cursor_row = act.row;
        this->cursor_col = act.col + strlen(act.text);
    } else if (act.kind == 2) {
        this->buffer.delete(act.offset, strlen(act.text));
        this->cursor_row = act.row;
        this->cursor_col = act.col;
    }

    if (this->undo_count < this->undo_cap) {
        this->undo_stack[this->undo_count] = act;
        this->undo_count = this->undo_count + 1;
    }
    this->is_dirty = true;
}

fn void EditorState.destroy() {
    if (this->undo_stack != (EditAction*)0) {
        free(this->undo_stack);
        this->undo_stack = (EditAction*)0;
    }
    if (this->redo_stack != (EditAction*)0) {
        free(this->redo_stack);
        this->redo_stack = (EditAction*)0;
    }
    this->buffer.destroy();
}

struct SockAddrIn {
    int sin_family;
    int sin_port;
    int sin_addr;
    int zero0;
    int zero1;
}

struct DnsResponse {
    bool success;
    string domain;
    int ip0;
    int ip1;
    int ip2;
    int ip3;
    int ttl;
    int query_time_ms;
}

fn DnsResponse resolve(string domain, string server_ip) {
    DnsResponse resp;
    resp.domain = domain;
    resp.success = true;
    resp.ttl = 300;
    resp.query_time_ms = 14;
    
    // Default DNS resolution values simulating upstream response or loopback resolution
    resp.ip0 = 93;
    resp.ip1 = 184;
    resp.ip2 = 216;
    resp.ip3 = 34; // 93.184.216.34 (example.com)
    return resp;
}

import "sys/dig/packet.kl" as packet;

extern int WSAStartup(int wVersionRequested, void* lpWSAData);
extern int WSACleanup();
extern int socket(int af, int type_val, int protocol);
extern int closesocket(int s);
extern int sendto(int s, void* buf, int len, int flags, void* to, int tolen);
extern int recvfrom(int s, void* buf, int len, int flags, void* src_from, int* fromlen);

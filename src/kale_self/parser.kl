// src/kale_self/parser.kl
// Self-hosting recursive descent parser in pure Kale

import "src/kale_self/token.kl" as tok;
import "src/kale_self/lexer.kl" as lx;
import "src/kale_self/ast.kl" as ast;

extern int strcmp(string s1, string s2);
extern void* strstr(string haystack, string needle);

struct Parser {
    lx.Lexer* lexer;
    tok.Token* current;
    tok.Token* tok1;
    tok.Token* tok2;
    tok.Token* tok3;
    int error_count;
    string import_aliases;
}

fn Parser* parser_new(lx.Lexer* l) {
    Parser* p = alloc(Parser);
    p->lexer = l;
    p->current = lx.lexer_next_token(l);
    p->tok1 = lx.lexer_next_token(l);
    p->tok2 = lx.lexer_next_token(l);
    p->tok3 = lx.lexer_next_token(l);
    p->error_count = 0;
    p->import_aliases = "";
    return p;
}

fn void parser_free(Parser* p) {
    if (p != (Parser*)0) {
        if (p->current != (tok.Token*)0) { tok.token_free(p->current); }
        if (p->tok1 != (tok.Token*)0) { tok.token_free(p->tok1); }
        if (p->tok2 != (tok.Token*)0) { tok.token_free(p->tok2); }
        if (p->tok3 != (tok.Token*)0) { tok.token_free(p->tok3); }
        free(p);
    }
}

fn tok.Token* parser_advance(Parser* p) {
    tok.Token* prev = p->current;
    p->current = p->tok1;
    p->tok1 = p->tok2;
    p->tok2 = p->tok3;
    p->tok3 = lx.lexer_next_token(p->lexer);
    return prev;
}

fn bool parser_is_import_alias(Parser* p, string name) {
    if (strlen(p->import_aliases) == 0 || strlen(name) == 0) {
        return false;
    }
    return strstr(p->import_aliases, name) != (void*)0;
}

fn bool parser_check(Parser* p, int kind) {
    if (p->current == (tok.Token*)0) {
        return false;
    }
    return p->current->kind == kind;
}

fn bool parser_match(Parser* p, int kind) {
    if (parser_check(p, kind)) {
        parser_advance(p);
        return true;
    }
    return false;
}

fn tok.Token* parser_consume(Parser* p, int kind) {
    if (parser_check(p, kind)) {
        return parser_advance(p);
    }
    p->error_count = p->error_count + 1;
    return (tok.Token*)0;
}

extern int strlen(string s);
extern void* malloc(int size);

fn string str_concat(string s1, string s2) {
    int l1 = strlen(s1);
    int l2 = strlen(s2);
    char* buf = (char*)malloc(l1 + l2 + 1);
    int i = 0;
    while (i < l1) {
        buf[i] = s1[i];
        i = i + 1;
    }
    int j = 0;
    while (j < l2) {
        buf[l1 + j] = s2[j];
        j = j + 1;
    }
    buf[l1 + l2] = (char)0;
    return (string)buf;
}

fn ast.ASTNode* parser_parse_primary(Parser* p) {
    if (parser_check(p, tok.TOK_INT())) {
        tok.Token* t = parser_advance(p);
        return ast.ast_literal(t->int_val);
    }

    if (parser_check(p, tok.TOK_CHAR())) {
        tok.Token* t = parser_advance(p);
        return ast.ast_literal(t->int_val);
    }

    if (parser_check(p, tok.TOK_STRING())) {
        tok.Token* t = parser_advance(p);
        return ast.ast_string(t->text);
    }

    if (parser_check(p, tok.TOK_TRUE())) {
        parser_advance(p);
        return ast.ast_literal(1);
    }

    if (parser_check(p, tok.TOK_FALSE())) {
        parser_advance(p);
        return ast.ast_literal(0);
    }

    if (parser_check(p, tok.TOK_NULL())) {
        parser_advance(p);
        return ast.ast_literal(0);
    }

    if (parser_match(p, tok.TOK_ALLOC())) {
        parser_consume(p, tok.TOK_LPAREN());
        tok.Token* t = parser_consume(p, tok.TOK_IDENT());
        string tname = "";
        if (t != (tok.Token*)0) { tname = t->text; }
        while (parser_match(p, tok.TOK_STAR())) {
        }
        ast.ASTNode* count = (ast.ASTNode*)0;
        if (parser_match(p, tok.TOK_COMMA())) {
            count = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_RPAREN());
        return ast.ast_alloc(tname, count);
    }

    if (parser_check(p, tok.TOK_IDENT())) {
        tok.Token* id = parser_advance(p);
        // Function call: ident(args)
        if (parser_check(p, tok.TOK_LPAREN())) {
            parser_advance(p); // consume '('
            ast.ASTNode* first_arg = (ast.ASTNode*)0;
            ast.ASTNode* last_arg = (ast.ASTNode*)0;
            if (!parser_check(p, tok.TOK_RPAREN())) {
                first_arg = parser_parse_expression(p);
                last_arg = first_arg;
                while (parser_match(p, tok.TOK_COMMA())) {
                    ast.ASTNode* next_arg = parser_parse_expression(p);
                    if (last_arg != (ast.ASTNode*)0) {
                        last_arg->next = next_arg;
                        last_arg = next_arg;
                    }
                }
            }
            parser_consume(p, tok.TOK_RPAREN());
            return ast.ast_call(id->text, first_arg);
        }
        return ast.ast_ident(id->text);
    }

    if (parser_match(p, tok.TOK_LPAREN())) {
        if (parser_check(p, tok.TOK_IDENT()) && is_type_name(p->current->text)) {
            tok.Token* ct = parser_advance(p);
            while (parser_match(p, tok.TOK_STAR())) {
            }
            if (parser_match(p, tok.TOK_RPAREN())) {
                return parser_parse_unary(p);
            }
        }
        ast.ASTNode* expr = parser_parse_expression(p);
        parser_consume(p, tok.TOK_RPAREN());
        return expr;
    }

    p->error_count = p->error_count + 1;
    parser_advance(p);
    return (ast.ASTNode*)0;
}

fn ast.ASTNode* parser_parse_postfix(Parser* p) {
    ast.ASTNode* expr = parser_parse_primary(p);
    bool looping = true;
    while (looping) {
        if (parser_match(p, tok.TOK_DOT())) {
            tok.Token* mem = parser_consume(p, tok.TOK_IDENT());
            string mname = "";
            if (mem != (tok.Token*)0) { mname = mem->text; }
            if (parser_match(p, tok.TOK_LPAREN())) {
                if (expr != (ast.ASTNode*)0 && expr->kind == ast.AST_IDENT() && parser_is_import_alias(p, expr->text)) {
                    ast.ASTNode* first_arg = (ast.ASTNode*)0;
                    ast.ASTNode* last_arg = (ast.ASTNode*)0;
                    if (!parser_check(p, tok.TOK_RPAREN())) {
                        first_arg = parser_parse_expression(p);
                        last_arg = first_arg;
                        while (parser_match(p, tok.TOK_COMMA())) {
                            ast.ASTNode* next_a = parser_parse_expression(p);
                            if (last_arg != (ast.ASTNode*)0) {
                                last_arg->next = next_a;
                                last_arg = next_a;
                            }
                        }
                    }
                    parser_consume(p, tok.TOK_RPAREN());
                    expr = ast.ast_call(mname, first_arg);
                } else {
                    ast.ASTNode* first_arg = ast.ast_unary(tok.TOK_AMP(), expr);
                    ast.ASTNode* last_arg = first_arg;
                    if (!parser_check(p, tok.TOK_RPAREN())) {
                        ast.ASTNode* a = parser_parse_expression(p);
                        last_arg->next = a;
                        last_arg = a;
                        while (parser_match(p, tok.TOK_COMMA())) {
                            ast.ASTNode* next_a = parser_parse_expression(p);
                            last_arg->next = next_a;
                            last_arg = next_a;
                        }
                    }
                    parser_consume(p, tok.TOK_RPAREN());
                    expr = ast.ast_call(mname, first_arg);
                }
            } else {
                expr = ast.ast_member(expr, mname, false);
            }
        } else if (parser_match(p, tok.TOK_ARROW())) {
            tok.Token* mem = parser_consume(p, tok.TOK_IDENT());
            string mname = "";
            if (mem != (tok.Token*)0) { mname = mem->text; }
            if (parser_match(p, tok.TOK_LPAREN())) {
                ast.ASTNode* first_arg = expr;
                ast.ASTNode* last_arg = first_arg;
                if (!parser_check(p, tok.TOK_RPAREN())) {
                    ast.ASTNode* a = parser_parse_expression(p);
                    last_arg->next = a;
                    last_arg = a;
                    while (parser_match(p, tok.TOK_COMMA())) {
                        ast.ASTNode* next_a = parser_parse_expression(p);
                        last_arg->next = next_a;
                        last_arg = next_a;
                    }
                }
                parser_consume(p, tok.TOK_RPAREN());
                expr = ast.ast_call(mname, first_arg);
            } else {
                expr = ast.ast_member(expr, mname, true);
            }
        } else if (parser_match(p, tok.TOK_LBRACKET())) {
            ast.ASTNode* idx = parser_parse_expression(p);
            parser_consume(p, tok.TOK_RBRACKET());
            expr = ast.ast_index(expr, idx);
        } else {
            looping = false;
        }
    }
    return expr;
}

fn ast.ASTNode* parser_parse_unary(Parser* p) {
    if (parser_check(p, tok.TOK_BANG()) || parser_check(p, tok.TOK_MINUS()) ||
        parser_check(p, tok.TOK_TILDE()) || parser_check(p, tok.TOK_STAR()) ||
        parser_check(p, tok.TOK_AMP())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* operand = parser_parse_unary(p);
        return ast.ast_unary(op->kind, operand);
    }
    return parser_parse_postfix(p);
}

fn ast.ASTNode* parser_parse_multiplicative(Parser* p) {
    ast.ASTNode* left = parser_parse_unary(p);
    while (parser_check(p, tok.TOK_STAR()) || parser_check(p, tok.TOK_SLASH()) || parser_check(p, tok.TOK_PERCENT())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_unary(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_additive(Parser* p) {
    ast.ASTNode* left = parser_parse_multiplicative(p);
    while (parser_check(p, tok.TOK_PLUS()) || parser_check(p, tok.TOK_MINUS())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_multiplicative(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_shift(Parser* p) {
    ast.ASTNode* left = parser_parse_additive(p);
    while (parser_check(p, tok.TOK_SHL()) || parser_check(p, tok.TOK_SHR())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_additive(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_relational(Parser* p) {
    ast.ASTNode* left = parser_parse_shift(p);
    while (parser_check(p, tok.TOK_LT()) || parser_check(p, tok.TOK_LTE()) ||
           parser_check(p, tok.TOK_GT()) || parser_check(p, tok.TOK_GTE())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_shift(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_equality(Parser* p) {
    ast.ASTNode* left = parser_parse_relational(p);
    while (parser_check(p, tok.TOK_EQEQ()) || parser_check(p, tok.TOK_NEQ())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_relational(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_bitwise_and(Parser* p) {
    ast.ASTNode* left = parser_parse_equality(p);
    while (parser_check(p, tok.TOK_AMP())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_equality(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_bitwise_xor(Parser* p) {
    ast.ASTNode* left = parser_parse_bitwise_and(p);
    while (parser_check(p, tok.TOK_CARET())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_bitwise_and(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_bitwise_or(Parser* p) {
    ast.ASTNode* left = parser_parse_bitwise_xor(p);
    while (parser_check(p, tok.TOK_PIPE())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_bitwise_xor(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_logical_and(Parser* p) {
    ast.ASTNode* left = parser_parse_bitwise_or(p);
    while (parser_check(p, tok.TOK_ANDAND())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_bitwise_or(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_logical_or(Parser* p) {
    ast.ASTNode* left = parser_parse_logical_and(p);
    while (parser_check(p, tok.TOK_OROR())) {
        tok.Token* op = parser_advance(p);
        ast.ASTNode* right = parser_parse_logical_and(p);
        left = ast.ast_binary(op->kind, left, right);
    }
    return left;
}

fn ast.ASTNode* parser_parse_expression(Parser* p) {
    ast.ASTNode* expr = parser_parse_logical_or(p);
    if (expr != (ast.ASTNode*)0) {
        if (expr->kind == ast.AST_IDENT()) {
            if (parser_match(p, tok.TOK_EQUALS())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_assign(expr->text, val);
            }
            if (parser_match(p, tok.TOK_PLUSEQ())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_assign(expr->text, ast.ast_binary(tok.TOK_PLUS(), expr, val));
            }
            if (parser_match(p, tok.TOK_MINUSEQ())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_assign(expr->text, ast.ast_binary(tok.TOK_MINUS(), expr, val));
            }
        }
        if (expr->kind == ast.AST_INDEX()) {
            if (parser_match(p, tok.TOK_EQUALS())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_index_assign(expr->left, expr->right, val);
            }
        }
        if (expr->kind == ast.AST_MEMBER()) {
            if (parser_match(p, tok.TOK_EQUALS())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_member_assign(expr->left, expr->text, expr->int_val == 1, val);
            }
            if (parser_match(p, tok.TOK_PLUSEQ())) {
                ast.ASTNode* val = parser_parse_expression(p);
                return ast.ast_member_assign(expr->left, expr->text, expr->int_val == 1,
                    ast.ast_binary(tok.TOK_PLUS(), expr, val));
            }
        }
    }
    return expr;
}

fn ast.ASTNode* parser_parse_block(Parser* p) {
    parser_consume(p, tok.TOK_LBRACE());
    ast.ASTNode* block = ast.ast_block((ast.ASTNode*)0);
    while (!parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
        ast.ASTNode* stmt = parser_parse_statement(p);
        if (stmt != (ast.ASTNode*)0) {
            ast.ast_block_append(block, stmt);
        }
    }
    parser_consume(p, tok.TOK_RBRACE());
    return block;
}

fn bool is_type_name(string s) {
    if (strcmp(s, "int") == 0) { return true; }
    if (strcmp(s, "float") == 0) { return true; }
    if (strcmp(s, "bool") == 0) { return true; }
    if (strcmp(s, "string") == 0) { return true; }
    if (strcmp(s, "char") == 0) { return true; }
    if (strcmp(s, "void") == 0) { return true; }
    return false;
}

fn bool is_var_decl_start(Parser* p) {
    if (!parser_check(p, tok.TOK_IDENT())) {
        return false;
    }
    if (is_type_name(p->current->text)) {
        return true;
    }
    if (p->tok1 != (tok.Token*)0) {
        if (p->tok1->kind == tok.TOK_STAR()) {
            return true;
        }
        if (p->tok1->kind == tok.TOK_IDENT()) {
            return true;
        }
        if (p->tok1->kind == tok.TOK_DOT()) {
            if (p->tok2 != (tok.Token*)0 && p->tok2->kind == tok.TOK_IDENT()) {
                if (p->tok3 != (tok.Token*)0) {
                    if (p->tok3->kind == tok.TOK_STAR() || p->tok3->kind == tok.TOK_IDENT()) {
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

fn ast.ASTNode* parser_parse_statement(Parser* p) {
    // Block statement: { <stmts> }
    if (parser_check(p, tok.TOK_LBRACE())) {
        return parser_parse_block(p);
    }

    // Return statement: return <expr>;
    if (parser_match(p, tok.TOK_RETURN())) {
        ast.ASTNode* val = (ast.ASTNode*)0;
        if (!parser_check(p, tok.TOK_SEMICOLON())) {
            val = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_return(val);
    }

    // Break statement: break;
    if (parser_match(p, tok.TOK_BREAK())) {
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_break();
    }

    // Continue statement: continue;
    if (parser_match(p, tok.TOK_CONTINUE())) {
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_continue();
    }

    // Free statement: free(ptr);
    if (parser_match(p, tok.TOK_FREE())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* target = parser_parse_expression(p);
        parser_consume(p, tok.TOK_RPAREN());
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_free_node(target);
    }

    // Print statement: print(arg1, arg2, ...);
    if (parser_match(p, tok.TOK_PRINT())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* first_arg = (ast.ASTNode*)0;
        ast.ASTNode* last_arg = (ast.ASTNode*)0;
        if (!parser_check(p, tok.TOK_RPAREN())) {
            first_arg = parser_parse_expression(p);
            last_arg = first_arg;
            while (parser_match(p, tok.TOK_COMMA())) {
                ast.ASTNode* next_arg = parser_parse_expression(p);
                if (last_arg != (ast.ASTNode*)0) {
                    last_arg->next = next_arg;
                    last_arg = next_arg;
                }
            }
        }
        parser_consume(p, tok.TOK_RPAREN());
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_print(first_arg);
    }

    // Switch statement: switch (expr) { case val: ... default: ... }
    if (parser_match(p, tok.TOK_SWITCH())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* cond = parser_parse_expression(p);
        parser_consume(p, tok.TOK_RPAREN());
        parser_consume(p, tok.TOK_LBRACE());
        ast.ASTNode* first_case = (ast.ASTNode*)0;
        ast.ASTNode* last_case = (ast.ASTNode*)0;
        while (!parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
            ast.ASTNode* case_node = (ast.ASTNode*)0;
            if (parser_match(p, tok.TOK_CASE())) {
                ast.ASTNode* case_val = parser_parse_expression(p);
                parser_consume(p, tok.TOK_COLON());
                ast.ASTNode* case_body = ast.ast_block((ast.ASTNode*)0);
                while (!parser_check(p, tok.TOK_CASE()) && !parser_check(p, tok.TOK_DEFAULT()) &&
                       !parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
                    ast.ASTNode* cs = parser_parse_statement(p);
                    if (cs != (ast.ASTNode*)0) {
                        ast.ast_block_append(case_body, cs);
                    }
                }
                case_node = ast.ast_case(case_val, case_body);
            } else if (parser_match(p, tok.TOK_DEFAULT())) {
                parser_consume(p, tok.TOK_COLON());
                ast.ASTNode* def_body = ast.ast_block((ast.ASTNode*)0);
                while (!parser_check(p, tok.TOK_CASE()) && !parser_check(p, tok.TOK_DEFAULT()) &&
                       !parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
                    ast.ASTNode* ds = parser_parse_statement(p);
                    if (ds != (ast.ASTNode*)0) {
                        ast.ast_block_append(def_body, ds);
                    }
                }
                case_node = ast.ast_default(def_body);
            } else {
                p->error_count = p->error_count + 1;
                parser_advance(p);
            }
            if (case_node != (ast.ASTNode*)0) {
                if (first_case == (ast.ASTNode*)0) {
                    first_case = case_node;
                    last_case = case_node;
                } else {
                    last_case->next = case_node;
                    last_case = case_node;
                }
            }
        }
        parser_consume(p, tok.TOK_RBRACE());
        return ast.ast_switch(cond, first_case);
    }

    // If statement: if (<cond>) <block> [else <block>]
    if (parser_match(p, tok.TOK_IF())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* cond = parser_parse_expression(p);
        parser_consume(p, tok.TOK_RPAREN());
        ast.ASTNode* then_body = parser_parse_block(p);
        ast.ASTNode* else_body = (ast.ASTNode*)0;
        if (parser_match(p, tok.TOK_ELSE())) {
            if (parser_check(p, tok.TOK_IF())) {
                else_body = parser_parse_statement(p);
            } else {
                else_body = parser_parse_block(p);
            }
        }
        return ast.ast_if(cond, then_body, else_body);
    }

    // While statement: while (<cond>) <block>
    if (parser_match(p, tok.TOK_WHILE())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* cond = parser_parse_expression(p);
        parser_consume(p, tok.TOK_RPAREN());
        ast.ASTNode* body = parser_parse_block(p);
        return ast.ast_while(cond, body);
    }

    // For statement: for (<init>; <cond>; <post>) <block>
    if (parser_match(p, tok.TOK_FOR())) {
        parser_consume(p, tok.TOK_LPAREN());
        ast.ASTNode* init_stmt = (ast.ASTNode*)0;
        if (!parser_check(p, tok.TOK_SEMICOLON())) {
            if (parser_check(p, tok.TOK_LET()) || parser_check(p, tok.TOK_VAR()) || is_var_decl_start(p)) {
                init_stmt = parser_parse_statement(p);
            } else {
                init_stmt = parser_parse_expression(p);
                parser_consume(p, tok.TOK_SEMICOLON());
            }
        } else {
            parser_consume(p, tok.TOK_SEMICOLON());
        }

        ast.ASTNode* cond = (ast.ASTNode*)0;
        if (!parser_check(p, tok.TOK_SEMICOLON())) {
            cond = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_SEMICOLON());

        ast.ASTNode* post = (ast.ASTNode*)0;
        if (!parser_check(p, tok.TOK_RPAREN())) {
            post = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_RPAREN());

        ast.ASTNode* body = parser_parse_block(p);
        return ast.ast_for(init_stmt, cond, post, body);
    }

    // Variable declaration: let x = <expr>; or var x = <expr>;
    if (parser_match(p, tok.TOK_LET()) || parser_match(p, tok.TOK_VAR())) {
        tok.Token* id = parser_consume(p, tok.TOK_IDENT());
        string name = "";
        if (id != (tok.Token*)0) {
            name = id->text;
        }
        ast.ASTNode* init_expr = (ast.ASTNode*)0;
        if (parser_match(p, tok.TOK_EQUALS())) {
            init_expr = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_var_decl("var", name, init_expr);
    }

    // Typed variable declaration: int x = <expr>; or Vec2 v; or ast.ASTNode* p;
    if (is_var_decl_start(p)) {
        string t_name = "";
        tok.Token* type_tok = parser_advance(p);
        if (type_tok != (tok.Token*)0) {
            t_name = type_tok->text;
        }
        if (parser_match(p, tok.TOK_DOT())) {
            tok.Token* sub = parser_consume(p, tok.TOK_IDENT());
            if (sub != (tok.Token*)0) {
                t_name = str_concat(t_name, str_concat(".", sub->text));
            }
        }
        while (parser_match(p, tok.TOK_STAR())) {
            t_name = str_concat(t_name, "*");
        }
        tok.Token* id = parser_consume(p, tok.TOK_IDENT());
        string name = "";
        if (id != (tok.Token*)0) {
            name = id->text;
        }
        ast.ASTNode* init_expr = (ast.ASTNode*)0;
        if (parser_match(p, tok.TOK_EQUALS())) {
            init_expr = parser_parse_expression(p);
        }
        parser_consume(p, tok.TOK_SEMICOLON());
        return ast.ast_var_decl(t_name, name, init_expr);
    }

    // Expression statement
    ast.ASTNode* expr = parser_parse_expression(p);
    parser_consume(p, tok.TOK_SEMICOLON());
    return expr;
}

fn ast.ASTNode* parser_parse_fn(Parser* p) {
    parser_consume(p, tok.TOK_FN());
    string ret_type = "void";
    string name = "";

    if (parser_check(p, tok.TOK_IDENT())) {
        tok.Token* first_tok = parser_advance(p);
        if (parser_check(p, tok.TOK_LPAREN())) {
            name = first_tok->text;
        } else {
            ret_type = first_tok->text;
            if (parser_match(p, tok.TOK_DOT())) {
                if (parser_check(p, tok.TOK_IDENT())) {
                    tok.Token* sub = parser_advance(p);
                    ret_type = str_concat(ret_type, str_concat(".", sub->text));
                }
            }
            while (parser_match(p, tok.TOK_STAR())) {
                ret_type = str_concat(ret_type, "*");
            }

            if (parser_match(p, tok.TOK_OPERATOR())) {
                if (parser_match(p, tok.TOK_LBRACKET())) {
                    parser_consume(p, tok.TOK_RBRACKET());
                    name = "operator[]";
                } else {
                    tok.Token* op_tok = parser_advance(p);
                    if (op_tok != (tok.Token*)0) {
                        name = str_concat("operator", tok.token_name(op_tok->kind));
                    } else {
                        name = "operator";
                    }
                }
            } else {
                tok.Token* name_tok = parser_consume(p, tok.TOK_IDENT());
                if (name_tok != (tok.Token*)0) {
                    name = name_tok->text;
                }
                if (parser_match(p, tok.TOK_DOT())) {
                    name = str_concat(name, ".");
                    if (parser_match(p, tok.TOK_OPERATOR())) {
                        if (parser_match(p, tok.TOK_LBRACKET())) {
                            parser_consume(p, tok.TOK_RBRACKET());
                            name = str_concat(name, "operator[]");
                        } else {
                            tok.Token* op_tok = parser_advance(p);
                            if (op_tok != (tok.Token*)0) {
                                name = str_concat(name, str_concat("operator", tok.token_name(op_tok->kind)));
                            } else {
                                name = str_concat(name, "operator");
                            }
                        }
                    } else {
                        tok.Token* sub_tok = parser_consume(p, tok.TOK_IDENT());
                        if (sub_tok != (tok.Token*)0) {
                            name = str_concat(name, sub_tok->text);
                        }
                    }
                }
            }
        }
    } else if (parser_match(p, tok.TOK_OPERATOR())) {
        if (parser_match(p, tok.TOK_LBRACKET())) {
            parser_consume(p, tok.TOK_RBRACKET());
            name = "operator[]";
        } else {
            tok.Token* op_tok = parser_advance(p);
            if (op_tok != (tok.Token*)0) {
                name = str_concat("operator", tok.token_name(op_tok->kind));
            } else {
                name = "operator";
            }
        }
    } else {
        p->error_count = p->error_count + 1;
        return (ast.ASTNode*)0;
    }

    parser_consume(p, tok.TOK_LPAREN());
    ast.ASTNode* first_param = (ast.ASTNode*)0;
    ast.ASTNode* last_param = (ast.ASTNode*)0;
    if (!parser_check(p, tok.TOK_RPAREN())) {
        tok.Token* p_type = parser_consume(p, tok.TOK_IDENT());
        string pt = "";
        if (p_type != (tok.Token*)0) { pt = p_type->text; }
        if (parser_match(p, tok.TOK_DOT())) {
            if (parser_check(p, tok.TOK_IDENT())) {
                tok.Token* sub = parser_advance(p);
                pt = str_concat(pt, str_concat(".", sub->text));
            }
        }
        while (parser_match(p, tok.TOK_STAR())) {
            pt = str_concat(pt, "*");
        }
        tok.Token* p_name = parser_consume(p, tok.TOK_IDENT());
        string pn = "";
        if (p_name != (tok.Token*)0) { pn = p_name->text; }
        first_param = ast.ast_param(pt, pn);
        last_param = first_param;

        while (parser_match(p, tok.TOK_COMMA())) {
            p_type = parser_consume(p, tok.TOK_IDENT());
            pt = "";
            if (p_type != (tok.Token*)0) { pt = p_type->text; }
            if (parser_match(p, tok.TOK_DOT())) {
                if (parser_check(p, tok.TOK_IDENT())) {
                    tok.Token* sub = parser_advance(p);
                    pt = str_concat(pt, str_concat(".", sub->text));
                }
            }
            while (parser_match(p, tok.TOK_STAR())) {
                pt = str_concat(pt, "*");
            }
            p_name = parser_consume(p, tok.TOK_IDENT());
            pn = "";
            if (p_name != (tok.Token*)0) { pn = p_name->text; }
            ast.ASTNode* next_param = ast.ast_param(pt, pn);
            if (last_param != (ast.ASTNode*)0) {
                last_param->next = next_param;
                last_param = next_param;
            }
        }
    }
    parser_consume(p, tok.TOK_RPAREN());
    ast.ASTNode* body = parser_parse_block(p);
    return ast.ast_fn_decl(ret_type, name, first_param, body);
}

fn ast.ASTNode* parser_parse_struct(Parser* p) {
    parser_consume(p, tok.TOK_STRUCT());
    tok.Token* id = parser_consume(p, tok.TOK_IDENT());
    string name = "";
    if (id != (tok.Token*)0) {
        name = id->text;
    }
    parser_consume(p, tok.TOK_LBRACE());
    ast.ASTNode* first_field = (ast.ASTNode*)0;
    ast.ASTNode* last_field = (ast.ASTNode*)0;

    while (!parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
        tok.Token* f_type = parser_consume(p, tok.TOK_IDENT());
        string ft = "";
        if (f_type != (tok.Token*)0) { ft = f_type->text; }
        if (parser_match(p, tok.TOK_DOT())) {
            if (parser_check(p, tok.TOK_IDENT())) {
                tok.Token* sub = parser_advance(p);
                ft = str_concat(ft, str_concat(".", sub->text));
            }
        }
        while (parser_match(p, tok.TOK_STAR())) {
            ft = str_concat(ft, "*");
        }
        tok.Token* f_name = parser_consume(p, tok.TOK_IDENT());
        parser_consume(p, tok.TOK_SEMICOLON());

        string fname = "";
        if (f_name != (tok.Token*)0) { fname = f_name->text; }

        ast.ASTNode* field = ast.ast_field_decl(ft, fname);
        if (first_field == (ast.ASTNode*)0) {
            first_field = field;
            last_field = field;
        } else {
            last_field->next = field;
            last_field = field;
        }
    }
    parser_consume(p, tok.TOK_RBRACE());
    return ast.ast_struct_decl(name, first_field);
}

fn ast.ASTNode* parser_parse_enum(Parser* p) {
    parser_consume(p, tok.TOK_ENUM());
    tok.Token* id = parser_consume(p, tok.TOK_IDENT());
    string name = "";
    if (id != (tok.Token*)0) {
        name = id->text;
    }
    parser_consume(p, tok.TOK_LBRACE());
    ast.ASTNode* first_mem = (ast.ASTNode*)0;
    ast.ASTNode* last_mem = (ast.ASTNode*)0;
    int current_val = 0;

    while (!parser_check(p, tok.TOK_RBRACE()) && !parser_check(p, tok.TOK_EOF())) {
        tok.Token* m_id = parser_consume(p, tok.TOK_IDENT());
        string m_name = "";
        if (m_id != (tok.Token*)0) {
            m_name = m_id->text;
        }
        if (parser_match(p, tok.TOK_EQUALS())) {
            tok.Token* val_tok = parser_consume(p, tok.TOK_INT());
            if (val_tok != (tok.Token*)0) {
                current_val = val_tok->int_val;
            }
        }
        ast.ASTNode* mem = ast.ast_enum_member(m_name, current_val);
        current_val = current_val + 1;
        if (first_mem == (ast.ASTNode*)0) {
            first_mem = mem;
            last_mem = mem;
        } else {
            last_mem->next = mem;
            last_mem = mem;
        }
        parser_match(p, tok.TOK_COMMA());
    }
    parser_consume(p, tok.TOK_RBRACE());
    parser_match(p, tok.TOK_SEMICOLON());
    return ast.ast_enum_decl(name, first_mem);
}

fn ast.ASTNode* parser_parse_import(Parser* p) {
    parser_consume(p, tok.TOK_IMPORT());
    tok.Token* path_tok = parser_consume(p, tok.TOK_STRING());
    string path = "";
    if (path_tok != (tok.Token*)0) {
        path = path_tok->text;
    }
    string alias = "";
    if (parser_match(p, tok.TOK_AS())) {
        tok.Token* as_tok = parser_consume(p, tok.TOK_IDENT());
        if (as_tok != (tok.Token*)0) {
            alias = as_tok->text;
            p->import_aliases = str_concat(p->import_aliases, str_concat(" ", alias));
        }
    }
    parser_consume(p, tok.TOK_SEMICOLON());
    return ast.ast_import(path, alias);
}

fn ast.ASTNode* parser_parse_program(Parser* p) {
    ast.ASTNode* prog = ast.ast_node_new(ast.AST_PROGRAM());
    ast.ASTNode* first = (ast.ASTNode*)0;
    ast.ASTNode* last = (ast.ASTNode*)0;

    while (!parser_check(p, tok.TOK_EOF())) {
        ast.ASTNode* item = (ast.ASTNode*)0;
        if (parser_check(p, tok.TOK_FN())) {
            item = parser_parse_fn(p);
        } else if (parser_check(p, tok.TOK_STRUCT())) {
            item = parser_parse_struct(p);
        } else if (parser_check(p, tok.TOK_ENUM())) {
            item = parser_parse_enum(p);
        } else if (parser_check(p, tok.TOK_IMPORT())) {
            item = parser_parse_import(p);
        } else {
            item = parser_parse_statement(p);
        }

        if (item != (ast.ASTNode*)0) {
            if (first == (ast.ASTNode*)0) {
                first = item;
                last = item;
            } else {
                last->next = item;
                last = item;
            }
        }
    }

    prog->body = first;
    return prog;
}

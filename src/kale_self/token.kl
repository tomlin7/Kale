// src/kale_self/token.kl
// Self-hosting compiler token kinds and Token representation in pure Kale


fn int TOK_EOF() { return 0; }
fn int TOK_IDENT() { return 1; }
fn int TOK_INT() { return 2; }
fn int TOK_FLOAT() { return 3; }
fn int TOK_STRING() { return 4; }
fn int TOK_CHAR() { return 5; }

// Keywords
fn int TOK_FN() { return 10; }
fn int TOK_LET() { return 11; }
fn int TOK_VAR() { return 12; }
fn int TOK_STRUCT() { return 13; }
fn int TOK_ENUM() { return 14; }
fn int TOK_IF() { return 15; }
fn int TOK_ELSE() { return 16; }
fn int TOK_WHILE() { return 17; }
fn int TOK_FOR() { return 18; }
fn int TOK_RETURN() { return 19; }
fn int TOK_IMPORT() { return 20; }
fn int TOK_AS() { return 21; }
fn int TOK_EXTERN() { return 22; }
fn int TOK_TRUE() { return 23; }
fn int TOK_FALSE() { return 24; }
fn int TOK_SWITCH() { return 25; }
fn int TOK_CASE() { return 26; }
fn int TOK_DEFAULT() { return 27; }
fn int TOK_BREAK() { return 28; }
fn int TOK_CONTINUE() { return 29; }
fn int TOK_ALLOC() { return 80; }
fn int TOK_FREE() { return 81; }
fn int TOK_PRINT() { return 82; }
fn int TOK_OPERATOR() { return 83; }
fn int TOK_NULL() { return 84; }
fn int TOK_CONST() { return 85; }

// Operators & Delimiters
fn int TOK_PLUS() { return 30; }
fn int TOK_MINUS() { return 31; }
fn int TOK_STAR() { return 32; }
fn int TOK_SLASH() { return 33; }
fn int TOK_PERCENT() { return 34; }
fn int TOK_EQUALS() { return 35; }
fn int TOK_EQEQ() { return 36; }
fn int TOK_NEQ() { return 37; }
fn int TOK_LT() { return 38; }
fn int TOK_LTE() { return 39; }
fn int TOK_GT() { return 40; }
fn int TOK_GTE() { return 41; }
fn int TOK_BANG() { return 42; }
fn int TOK_ANDAND() { return 43; }
fn int TOK_OROR() { return 44; }
fn int TOK_ARROW() { return 45; }
fn int TOK_DOT() { return 46; }
fn int TOK_COMMA() { return 47; }
fn int TOK_COLON() { return 48; }
fn int TOK_SEMICOLON() { return 49; }
fn int TOK_LPAREN() { return 50; }
fn int TOK_RPAREN() { return 51; }
fn int TOK_LBRACE() { return 52; }
fn int TOK_RBRACE() { return 53; }
fn int TOK_LBRACKET() { return 54; }
fn int TOK_RBRACKET() { return 55; }
fn int TOK_PLUSEQ() { return 60; }
fn int TOK_MINUSEQ() { return 61; }
fn int TOK_STAREQ() { return 62; }
fn int TOK_SLASHEQ() { return 63; }
fn int TOK_PERCENTEQ() { return 64; }
fn int TOK_PLUSPLUS() { return 65; }
fn int TOK_MINUSMINUS() { return 66; }
fn int TOK_AMP() { return 67; }
fn int TOK_PIPE() { return 68; }
fn int TOK_CARET() { return 69; }
fn int TOK_TILDE() { return 70; }
fn int TOK_SHL() { return 71; }
fn int TOK_SHR() { return 72; }

struct Token {
    int kind;
    string text;
    int int_val;
    int line;
    int col;
}

fn Token* token_new(int kind, string text, int int_val, int line, int col) {
    Token* tok = alloc(Token);
    tok->kind = kind;
    tok->text = text;
    tok->int_val = int_val;
    tok->line = line;
    tok->col = col;
    return tok;
}

fn void token_free(Token* tok) {
    if (tok != (Token*)0) {
        free(tok);
    }
}

fn string token_name(int kind) {
    if (kind == 0) { return "EOF"; }
    if (kind == 1) { return "IDENT"; }
    if (kind == 2) { return "INT"; }
    if (kind == 3) { return "FLOAT"; }
    if (kind == 4) { return "STRING"; }
    if (kind == 5) { return "CHAR"; }
    if (kind == 10) { return "fn"; }
    if (kind == 11) { return "let"; }
    if (kind == 12) { return "var"; }
    if (kind == 13) { return "struct"; }
    if (kind == 14) { return "enum"; }
    if (kind == 15) { return "if"; }
    if (kind == 16) { return "else"; }
    if (kind == 17) { return "while"; }
    if (kind == 18) { return "for"; }
    if (kind == 19) { return "return"; }
    if (kind == 20) { return "import"; }
    if (kind == 21) { return "as"; }
    if (kind == 22) { return "extern"; }
    if (kind == 23) { return "true"; }
    if (kind == 24) { return "false"; }
    if (kind == 25) { return "switch"; }
    if (kind == 26) { return "case"; }
    if (kind == 27) { return "default"; }
    if (kind == 28) { return "break"; }
    if (kind == 29) { return "continue"; }
    if (kind == 80) { return "alloc"; }
    if (kind == 81) { return "free"; }
    if (kind == 82) { return "print"; }
    if (kind == 83) { return "operator"; }
    if (kind == 84) { return "null"; }
    if (kind == 85) { return "const"; }
    if (kind == 30) { return "+"; }
    if (kind == 31) { return "-"; }
    if (kind == 32) { return "*"; }
    if (kind == 33) { return "/"; }
    if (kind == 34) { return "%"; }
    if (kind == 35) { return "="; }
    if (kind == 36) { return "=="; }
    if (kind == 37) { return "!="; }
    if (kind == 38) { return "<"; }
    if (kind == 39) { return "<="; }
    if (kind == 40) { return ">"; }
    if (kind == 41) { return ">="; }
    if (kind == 42) { return "!"; }
    if (kind == 43) { return "&&"; }
    if (kind == 44) { return "||"; }
    if (kind == 45) { return "->"; }
    if (kind == 46) { return "."; }
    if (kind == 47) { return ","; }
    if (kind == 48) { return ":"; }
    if (kind == 49) { return ";"; }
    if (kind == 50) { return "("; }
    if (kind == 51) { return ")"; }
    if (kind == 52) { return "{"; }
    if (kind == 53) { return "}"; }
    if (kind == 54) { return "["; }
    if (kind == 55) { return "]"; }
    if (kind == 60) { return "+="; }
    if (kind == 61) { return "-="; }
    if (kind == 62) { return "*="; }
    if (kind == 63) { return "/="; }
    if (kind == 64) { return "%="; }
    if (kind == 65) { return "++"; }
    if (kind == 66) { return "--"; }
    if (kind == 67) { return "&"; }
    if (kind == 68) { return "|"; }
    if (kind == 69) { return "^"; }
    if (kind == 70) { return "~"; }
    if (kind == 71) { return "<<"; }
    if (kind == 72) { return ">>"; }
    return "UNKNOWN";
}

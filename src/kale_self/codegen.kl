// src/kale_self/codegen.kl
// Target C code generator for self-hosting Kale compiler

import "src/kale_self/token.kl" as tok;
import "src/kale_self/ast.kl" as ast;

extern void* malloc(int size);
extern int strlen(string s);
extern int strcmp(string s1, string s2);
extern void* strstr(string haystack, string needle);

struct CodeEmitter {
    char* buffer;
    int length;
    int capacity;
    int indent_level;
}

fn void emitter_reserve(CodeEmitter* e, int additional) {
    if (e->length + additional + 1 > e->capacity) {
        int new_cap = e->capacity * 2;
        while (new_cap < e->length + additional + 1) {
            new_cap = new_cap * 2;
        }
        char* new_buf = (char*)malloc(new_cap);
        int i = 0;
        while (i < e->length) {
            new_buf[i] = e->buffer[i];
            i = i + 1;
        }
        new_buf[e->length] = (char)0;
        free(e->buffer);
        e->buffer = new_buf;
        e->capacity = new_cap;
    }
}

fn CodeEmitter* emitter_new() {
    CodeEmitter* e = alloc(CodeEmitter);
    int cap = 512;
    e->capacity = cap;
    e->length = 0;
    e->indent_level = 0;
    e->buffer = (char*)malloc(cap);
    e->buffer[0] = (char)0;
    return e;
}

fn void emitter_free(CodeEmitter* e) {
    if (e != (CodeEmitter*)0) {
        if (e->buffer != (char*)0) {
            free(e->buffer);
        }
        free(e);
    }
}

fn int emitter_len(CodeEmitter* e) {
    return e->length;
}

fn void emitter_emit_char(CodeEmitter* e, char c) {
    emitter_reserve(e, 1);
    e->buffer[e->length] = c;
    e->length = e->length + 1;
    e->buffer[e->length] = (char)0;
}

fn void emitter_emit(CodeEmitter* e, string s) {
    int s_len = strlen(s);
    if (s_len == 0) {
        return;
    }
    emitter_reserve(e, s_len);
    char* src = (char*)s;
    int i = 0;
    while (i < s_len) {
        e->buffer[e->length + i] = src[i];
        i = i + 1;
    }
    e->length = e->length + s_len;
    e->buffer[e->length] = (char)0;
}

fn void emitter_emit_indent(CodeEmitter* e) {
    int count = e->indent_level;
    int i = 0;
    while (i < count) {
        emitter_emit(e, "    ");
        i = i + 1;
    }
}

fn void emitter_emit_line(CodeEmitter* e, string s) {
    emitter_emit_indent(e);
    emitter_emit(e, s);
    emitter_emit_char(e, (char)10); // '\n'
}

fn void emitter_emit_int(CodeEmitter* e, int val) {
    if (val == 0) {
        emitter_emit_char(e, (char)48);
        return;
    }
    if (val == -9223372036854775807 - 1) {
        emitter_emit(e, "-9223372036854775808LL");
        return;
    }
    int v = val;
    if (v < 0) {
        emitter_emit_char(e, (char)45);
        v = 0 - v;
    }
    char* digits = alloc(char, 24);
    int count = 0;
    while (v > 0) {
        int digit = v % 10;
        digits[count] = (char)(48 + digit);
        count = count + 1;
        v = v / 10;
    }
    emitter_reserve(e, count);
    int k = count - 1;
    while (k >= 0) {
        emitter_emit_char(e, digits[k]);
        k = k - 1;
    }
    free(digits);
}

fn string emitter_to_string(CodeEmitter* e) {
    string res = (string)malloc(e->length + 1);
    char* dst = (char*)res;
    int i = 0;
    while (i < e->length) {
        dst[i] = e->buffer[i];
        i = i + 1;
    }
    dst[e->length] = (char)0;
    return res;
}

fn string str_concat(string s1, string s2) {
    int l1 = strlen(s1);
    int l2 = strlen(s2);
    char* buf = (char*)malloc(l1 + l2 + 1);
    int i = 0;
    while (i < l1) {
        buf[i] = s1[i];
        i = i + 1;
    }
    int j = 0;
    while (j < l2) {
        buf[l1 + j] = s2[j];
        j = j + 1;
    }
    buf[l1 + l2] = (char)0;
    return (string)buf;
}

fn string strip_qualifier(string t) {
    int len = strlen(t);
    int dot_idx = -1;
    int i = 0;
    while (i < len) {
        if (t[i] == (char)46) {
            dot_idx = i;
        }
        i = i + 1;
    }
    if (dot_idx >= 0) {
        return (string)((char*)t + dot_idx + 1);
    }
    return t;
}

fn string c_type(string t) {
    string bare = strip_qualifier(t);
    if (strcmp(bare, "int") == 0) { return "int64_t"; }
    if (strcmp(bare, "float") == 0) { return "double"; }
    if (strcmp(bare, "bool") == 0) { return "bool"; }
    if (strcmp(bare, "string") == 0) { return "const char*"; }
    if (strcmp(bare, "char") == 0) { return "char"; }
    if (strcmp(bare, "void") == 0) { return "void"; }
    if (strcmp(bare, "") == 0) { return "void"; }
    return bare;
}

fn string get_op_suffix(string op_sym) {
    if (strcmp(op_sym, "+") == 0) { return "add"; }
    if (strcmp(op_sym, "-") == 0) { return "sub"; }
    if (strcmp(op_sym, "*") == 0) { return "mul"; }
    if (strcmp(op_sym, "/") == 0) { return "div"; }
    if (strcmp(op_sym, "%") == 0) { return "mod"; }
    if (strcmp(op_sym, "==") == 0) { return "eq"; }
    if (strcmp(op_sym, "!=") == 0) { return "ne"; }
    if (strcmp(op_sym, "<") == 0) { return "lt"; }
    if (strcmp(op_sym, "<=") == 0) { return "le"; }
    if (strcmp(op_sym, ">") == 0) { return "gt"; }
    if (strcmp(op_sym, ">=") == 0) { return "ge"; }
    if (strcmp(op_sym, "&") == 0) { return "band"; }
    if (strcmp(op_sym, "|") == 0) { return "bor"; }
    if (strcmp(op_sym, "^") == 0) { return "bxor"; }
    if (strcmp(op_sym, "<<") == 0) { return "shl"; }
    if (strcmp(op_sym, ">>") == 0) { return "shr"; }
    if (strcmp(op_sym, "!") == 0) { return "not"; }
    if (strcmp(op_sym, "~") == 0) { return "bnot"; }
    if (strcmp(op_sym, "[]") == 0) { return "index"; }
    return op_sym;
}

fn string c_fn_name(string name) {
    if (strcmp(name, "main") == 0) { return "main"; }
    int len = strlen(name);
    int dot_idx = -1;
    int i = 0;
    while (i < len) {
        if (name[i] == (char)46) {
            dot_idx = i;
        }
        i = i + 1;
    }
    if (dot_idx >= 0) {
        char* st = (char*)malloc(dot_idx + 1);
        int k = 0;
        while (k < dot_idx) { st[k] = name[k]; k = k + 1; }
        st[dot_idx] = (char)0;
        string m_name = (string)((char*)name + dot_idx + 1);
        if (strlen(m_name) >= 8 && strstr(m_name, "operator") == (void*)m_name) {
            string op_sym = (string)((char*)m_name + 8);
            string suffix = get_op_suffix(op_sym);
            return str_concat("kale_", str_concat((string)st, str_concat("_op_", suffix)));
        }
        return str_concat("kale_", str_concat((string)st, str_concat("_", m_name)));
    }
    if (len >= 8 && strstr(name, "operator") == (void*)name) {
        string op_sym = (string)((char*)name + 8);
        string suffix = get_op_suffix(op_sym);
        return str_concat("kale_op_", suffix);
    }
    return name;
}

fn string op_to_c(int op) {
    if (op == tok.TOK_PLUS()) { return "+"; }
    if (op == tok.TOK_MINUS()) { return "-"; }
    if (op == tok.TOK_STAR()) { return "*"; }
    if (op == tok.TOK_SLASH()) { return "/"; }
    if (op == tok.TOK_PERCENT()) { return "%"; }
    if (op == tok.TOK_EQEQ()) { return "=="; }
    if (op == tok.TOK_NEQ()) { return "!="; }
    if (op == tok.TOK_LT()) { return "<"; }
    if (op == tok.TOK_LTE()) { return "<="; }
    if (op == tok.TOK_GT()) { return ">"; }
    if (op == tok.TOK_GTE()) { return ">="; }
    if (op == tok.TOK_ANDAND()) { return "&&"; }
    if (op == tok.TOK_OROR()) { return "||"; }
    if (op == tok.TOK_AMP()) { return "&"; }
    if (op == tok.TOK_PIPE()) { return "|"; }
    if (op == tok.TOK_CARET()) { return "^"; }
    if (op == tok.TOK_SHL()) { return "<<"; }
    if (op == tok.TOK_SHR()) { return ">>"; }
    if (op == tok.TOK_EQUALS()) { return "="; }
    return "?";
}

fn void emitter_emit_expr(CodeEmitter* e, ast.ASTNode* expr) {
    if (expr == (ast.ASTNode*)0) {
        return;
    }

    if (expr->kind == ast.AST_LITERAL()) {
        emitter_emit_int(e, expr->int_val);
        return;
    }

    if (expr->kind == ast.AST_STRING()) {
        emitter_emit(e, "\"");
        emitter_emit(e, expr->text);
        emitter_emit(e, "\"");
        return;
    }

    if (expr->kind == ast.AST_IDENT()) {
        emitter_emit(e, expr->text);
        return;
    }

    if (expr->kind == ast.AST_ALLOC()) {
        emitter_emit(e, "(");
        emitter_emit(e, c_type(expr->type_name));
        emitter_emit(e, "*)malloc(sizeof(");
        emitter_emit(e, c_type(expr->type_name));
        emitter_emit(e, ")");
        if (expr->left != (ast.ASTNode*)0) {
            emitter_emit(e, " * (");
            emitter_emit_expr(e, expr->left);
            emitter_emit(e, ")");
        }
        emitter_emit(e, ")");
        return;
    }

    if (expr->kind == ast.AST_INDEX()) {
        emitter_emit_expr(e, expr->left);
        emitter_emit(e, "[");
        emitter_emit_expr(e, expr->right);
        emitter_emit(e, "]");
        return;
    }

    if (expr->kind == ast.AST_INDEX_ASSIGN()) {
        emitter_emit_expr(e, expr->left);
        emitter_emit(e, "[");
        emitter_emit_expr(e, expr->right);
        emitter_emit(e, "] = ");
        emitter_emit_expr(e, expr->body);
        return;
    }

    if (expr->kind == ast.AST_MEMBER()) {
        emitter_emit_expr(e, expr->left);
        if (expr->int_val == 1) {
            emitter_emit(e, "->");
        } else {
            emitter_emit(e, ".");
        }
        emitter_emit(e, expr->text);
        return;
    }

    if (expr->kind == ast.AST_MEMBER_ASSIGN()) {
        emitter_emit_expr(e, expr->left);
        if (expr->int_val == 1) {
            emitter_emit(e, "->");
        } else {
            emitter_emit(e, ".");
        }
        emitter_emit(e, expr->text);
        emitter_emit(e, " = ");
        emitter_emit_expr(e, expr->right);
        return;
    }

    if (expr->kind == ast.AST_UNARY()) {
        if (expr->op == tok.TOK_BANG()) {
            emitter_emit(e, "!");
        } else if (expr->op == tok.TOK_MINUS()) {
            emitter_emit(e, "-");
        } else if (expr->op == tok.TOK_TILDE()) {
            emitter_emit(e, "~");
        } else if (expr->op == tok.TOK_STAR()) {
            emitter_emit(e, "*");
        } else if (expr->op == tok.TOK_AMP()) {
            emitter_emit(e, "&");
        }
        emitter_emit_expr(e, expr->left);
        return;
    }

    if (expr->kind == ast.AST_BINARY()) {
        emitter_emit(e, "(");
        emitter_emit_expr(e, expr->left);
        emitter_emit(e, " ");
        emitter_emit(e, op_to_c(expr->op));
        emitter_emit(e, " ");
        emitter_emit_expr(e, expr->right);
        emitter_emit(e, ")");
        return;
    }

    if (expr->kind == ast.AST_CALL()) {
        emitter_emit(e, c_fn_name(expr->text));
        emitter_emit(e, "(");
        ast.ASTNode* arg = expr->left;
        bool first = true;
        while (arg != (ast.ASTNode*)0) {
            if (!first) {
                emitter_emit(e, ", ");
            }
            emitter_emit_expr(e, arg);
            first = false;
            arg = arg->next;
        }
        emitter_emit(e, ")");
        return;
    }

    if (expr->kind == ast.AST_ASSIGN()) {
        emitter_emit(e, expr->text);
        emitter_emit(e, " = ");
        emitter_emit_expr(e, expr->left);
        return;
    }
}

fn string get_struct_name(string fn_name) {
    int len = strlen(fn_name);
    int dot_i = -1;
    int i = 0;
    while (i < len) {
        if (fn_name[i] == (char)46) {
            dot_i = i;
        }
        i = i + 1;
    }
    if (dot_i >= 0) {
        char* buf = (char*)malloc(dot_i + 1);
        int k = 0;
        while (k < dot_i) {
            buf[k] = fn_name[k];
            k = k + 1;
        }
        buf[dot_i] = (char)0;
        return (string)buf;
    }
    return "";
}

fn void emitter_emit_stmt(CodeEmitter* e, ast.ASTNode* stmt) {
    if (stmt == (ast.ASTNode*)0) {
        return;
    }

    if (stmt->kind == ast.AST_RETURN()) {
        emitter_emit_indent(e);
        emitter_emit(e, "return");
        if (stmt->left != (ast.ASTNode*)0) {
            emitter_emit(e, " ");
            emitter_emit_expr(e, stmt->left);
        }
        emitter_emit(e, ";\n");
        return;
    }

    if (stmt->kind == ast.AST_BREAK()) {
        emitter_emit_line(e, "break;");
        return;
    }

    if (stmt->kind == ast.AST_CONTINUE()) {
        emitter_emit_line(e, "continue;");
        return;
    }

    if (stmt->kind == ast.AST_FREE()) {
        emitter_emit_indent(e);
        emitter_emit(e, "free((void*)(");
        emitter_emit_expr(e, stmt->left);
        emitter_emit(e, "));\n");
        return;
    }

    if (stmt->kind == ast.AST_PRINT()) {
        ast.ASTNode* arg = stmt->left;
        while (arg != (ast.ASTNode*)0) {
            emitter_emit_indent(e);
            emitter_emit(e, "_kale_print(");
            emitter_emit_expr(e, arg);
            emitter_emit(e, ");\n");
            if (arg->next != (ast.ASTNode*)0) {
                emitter_emit_line(e, "_kale_print_str(\" \");");
            }
            arg = arg->next;
        }
        emitter_emit_line(e, "_kale_println();");
        return;
    }

    if (stmt->kind == ast.AST_SWITCH()) {
        emitter_emit_indent(e);
        emitter_emit(e, "switch (");
        emitter_emit_expr(e, stmt->cond);
        emitter_emit(e, ") {\n");
        e->indent_level = e->indent_level + 1;
        ast.ASTNode* c_case = stmt->body;
        while (c_case != (ast.ASTNode*)0) {
            if (c_case->kind == ast.AST_CASE()) {
                emitter_emit_indent(e);
                emitter_emit(e, "case ");
                emitter_emit_expr(e, c_case->left);
                emitter_emit(e, ": {\n");
                e->indent_level = e->indent_level + 1;
                if (c_case->body != (ast.ASTNode*)0) {
                    emitter_emit_stmt(e, c_case->body);
                }
                e->indent_level = e->indent_level - 1;
                emitter_emit_indent(e);
                emitter_emit(e, "}\n");
            } else if (c_case->kind == ast.AST_DEFAULT()) {
                emitter_emit_indent(e);
                emitter_emit(e, "default: {\n");
                e->indent_level = e->indent_level + 1;
                if (c_case->body != (ast.ASTNode*)0) {
                    emitter_emit_stmt(e, c_case->body);
                }
                e->indent_level = e->indent_level - 1;
                emitter_emit_indent(e);
                emitter_emit(e, "}\n");
            }
            c_case = c_case->next;
        }
        e->indent_level = e->indent_level - 1;
        emitter_emit_indent(e);
        emitter_emit(e, "}\n");
        return;
    }

    if (stmt->kind == ast.AST_VAR_DECL()) {
        emitter_emit_indent(e);
        string t = stmt->type_name;
        if (strcmp(t, "") == 0 || strcmp(t, "let") == 0 || strcmp(t, "var") == 0) {
            emitter_emit(e, "int64_t");
        } else {
            emitter_emit(e, c_type(t));
        }
        emitter_emit(e, " ");
        emitter_emit(e, stmt->text);
        if (stmt->left != (ast.ASTNode*)0) {
            emitter_emit(e, " = ");
            emitter_emit_expr(e, stmt->left);
        }
        emitter_emit(e, ";\n");
        return;
    }

    if (stmt->kind == ast.AST_IF()) {
        emitter_emit_indent(e);
        emitter_emit(e, "if (");
        if (stmt->cond != (ast.ASTNode*)0) {
            emitter_emit_expr(e, stmt->cond);
        }
        emitter_emit(e, ") {\n");
        e->indent_level = e->indent_level + 1;
        emitter_emit_stmt(e, stmt->body);
        e->indent_level = e->indent_level - 1;
        emitter_emit_indent(e);
        if (stmt->else_body != (ast.ASTNode*)0) {
            emitter_emit(e, "} else {\n");
            e->indent_level = e->indent_level + 1;
            emitter_emit_stmt(e, stmt->else_body);
            e->indent_level = e->indent_level - 1;
            emitter_emit_indent(e);
            emitter_emit(e, "}\n");
        } else {
            emitter_emit(e, "}\n");
        }
        return;
    }

    if (stmt->kind == ast.AST_WHILE()) {
        emitter_emit_indent(e);
        emitter_emit(e, "while (");
        if (stmt->cond != (ast.ASTNode*)0) {
            emitter_emit_expr(e, stmt->cond);
        }
        emitter_emit(e, ") {\n");
        e->indent_level = e->indent_level + 1;
        emitter_emit_stmt(e, stmt->body);
        e->indent_level = e->indent_level - 1;
        emitter_emit_indent(e);
        emitter_emit(e, "}\n");
        return;
    }

    if (stmt->kind == ast.AST_FOR()) {
        emitter_emit_indent(e);
        emitter_emit(e, "for (");
        if (stmt->left != (ast.ASTNode*)0) {
            if (stmt->left->kind == ast.AST_VAR_DECL()) {
                string t = stmt->left->type_name;
                if (strcmp(t, "") == 0 || strcmp(t, "let") == 0 || strcmp(t, "var") == 0) {
                    emitter_emit(e, "int64_t");
                } else {
                    emitter_emit(e, c_type(t));
                }
                emitter_emit(e, " ");
                emitter_emit(e, stmt->left->text);
                if (stmt->left->left != (ast.ASTNode*)0) {
                    emitter_emit(e, " = ");
                    emitter_emit_expr(e, stmt->left->left);
                }
            } else {
                emitter_emit_expr(e, stmt->left);
            }
        }
        emitter_emit(e, "; ");
        if (stmt->cond != (ast.ASTNode*)0) {
            emitter_emit_expr(e, stmt->cond);
        }
        emitter_emit(e, "; ");
        if (stmt->right != (ast.ASTNode*)0) {
            emitter_emit_expr(e, stmt->right);
        }
        emitter_emit(e, ") {\n");
        e->indent_level = e->indent_level + 1;
        emitter_emit_stmt(e, stmt->body);
        e->indent_level = e->indent_level - 1;
        emitter_emit_indent(e);
        emitter_emit(e, "}\n");
        return;
    }

    if (stmt->kind == ast.AST_BLOCK()) {
        ast.ASTNode* cur = stmt->body;
        while (cur != (ast.ASTNode*)0) {
            emitter_emit_stmt(e, cur);
            cur = cur->next;
        }
        return;
    }

    // Fallback: Expression statement
    emitter_emit_indent(e);
    emitter_emit_expr(e, stmt);
    emitter_emit(e, ";\n");
}

fn void emitter_emit_decl(CodeEmitter* e, ast.ASTNode* decl) {
    if (decl == (ast.ASTNode*)0) {
        return;
    }

    if (decl->kind == ast.AST_ENUM_DECL()) {
        emitter_emit(e, "typedef enum ");
        emitter_emit(e, decl->text);
        emitter_emit(e, " {\n");
        e->indent_level = e->indent_level + 1;
        ast.ASTNode* mem = decl->body;
        while (mem != (ast.ASTNode*)0) {
            emitter_emit_indent(e);
            emitter_emit(e, mem->text);
            emitter_emit(e, " = ");
            emitter_emit_int(e, mem->int_val);
            if (mem->next != (ast.ASTNode*)0) {
                emitter_emit(e, ",");
            }
            emitter_emit(e, "\n");
            mem = mem->next;
        }
        e->indent_level = e->indent_level - 1;
        emitter_emit(e, "} ");
        emitter_emit(e, decl->text);
        emitter_emit(e, ";\n\n");
        return;
    }

    if (decl->kind == ast.AST_STRUCT_DECL()) {
        emitter_emit(e, "typedef struct ");
        emitter_emit(e, decl->text);
        emitter_emit(e, " {\n");
        e->indent_level = e->indent_level + 1;
        ast.ASTNode* field = decl->body;
        while (field != (ast.ASTNode*)0) {
            emitter_emit_indent(e);
            emitter_emit(e, c_type(field->type_name));
            emitter_emit(e, " ");
            emitter_emit(e, field->text);
            emitter_emit(e, ";\n");
            field = field->next;
        }
        e->indent_level = e->indent_level - 1;
        emitter_emit(e, "} ");
        emitter_emit(e, decl->text);
        emitter_emit(e, ";\n\n");
        return;
    }

    if (decl->kind == ast.AST_FN_DECL()) {
        emitter_emit(e, c_type(decl->type_name));
        emitter_emit(e, " ");
        emitter_emit(e, c_fn_name(decl->text));
        emitter_emit(e, "(");
        string sname = get_struct_name(decl->text);
        bool has_this = false;
        if (strlen(sname) > 0) {
            emitter_emit(e, sname);
            emitter_emit(e, "* this");
            has_this = true;
        }
        ast.ASTNode* p = decl->left;
        bool first = !has_this;
        while (p != (ast.ASTNode*)0) {
            if (!first) {
                emitter_emit(e, ", ");
            }
            emitter_emit(e, c_type(p->type_name));
            emitter_emit(e, " ");
            emitter_emit(e, p->text);
            first = false;
            p = p->next;
        }
        emitter_emit(e, ") {\n");
        e->indent_level = e->indent_level + 1;
        if (decl->body != (ast.ASTNode*)0) {
            emitter_emit_stmt(e, decl->body);
        }
        e->indent_level = e->indent_level - 1;
        emitter_emit(e, "}\n\n");
        return;
    }
}

fn void emitter_emit_program(CodeEmitter* e, ast.ASTNode* prog) {
    if (prog == (ast.ASTNode*)0) {
        return;
    }

    // Standard runtime preamble
    emitter_emit(e, "#include <stdint.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n\n");
    emitter_emit(e, "// --- Kale Runtime ---\n");
    emitter_emit(e, "static inline void _kale_print_int(int64_t x) { printf(\"%lld\", (long long)x); }\n");
    emitter_emit(e, "static inline void _kale_print_double(double x) { printf(\"%g\", x); }\n");
    emitter_emit(e, "static inline void _kale_print_bool(bool x) { printf(\"%s\", x ? \"true\" : \"false\"); }\n");
    emitter_emit(e, "static inline void _kale_print_str(const char* x) { if (x) printf(\"%s\", x); }\n");
    emitter_emit(e, "static inline void _kale_print_char(char x) { printf(\"%c\", x); }\n");
    emitter_emit(e, "static inline void _kale_print_ptr(const void* x) { printf(\"%p\", x); }\n");
    emitter_emit(e, "static inline void _kale_println(void) { printf(\"\\n\"); }\n\n");
    emitter_emit(e, "#define _kale_print(X) _Generic((X), \\\n");
    emitter_emit(e, "    _Bool: _kale_print_bool, \\\n");
    emitter_emit(e, "    char: _kale_print_char, \\\n");
    emitter_emit(e, "    signed char: _kale_print_int, \\\n");
    emitter_emit(e, "    unsigned char: _kale_print_int, \\\n");
    emitter_emit(e, "    short: _kale_print_int, \\\n");
    emitter_emit(e, "    unsigned short: _kale_print_int, \\\n");
    emitter_emit(e, "    int: _kale_print_int, \\\n");
    emitter_emit(e, "    unsigned int: _kale_print_int, \\\n");
    emitter_emit(e, "    long: _kale_print_int, \\\n");
    emitter_emit(e, "    unsigned long: _kale_print_int, \\\n");
    emitter_emit(e, "    long long: _kale_print_int, \\\n");
    emitter_emit(e, "    unsigned long long: _kale_print_int, \\\n");
    emitter_emit(e, "    float: _kale_print_double, \\\n");
    emitter_emit(e, "    double: _kale_print_double, \\\n");
    emitter_emit(e, "    char*: _kale_print_str, \\\n");
    emitter_emit(e, "    const char*: _kale_print_str, \\\n");
    emitter_emit(e, "    default: _kale_print_ptr \\\n");
    emitter_emit(e, ")(X)\n\n");

    // Forward declarations for structs
    ast.ASTNode* cur = prog->body;
    while (cur != (ast.ASTNode*)0) {
        if (cur->kind == ast.AST_STRUCT_DECL()) {
            emitter_emit(e, "typedef struct ");
            emitter_emit(e, cur->text);
            emitter_emit(e, " ");
            emitter_emit(e, cur->text);
            emitter_emit(e, ";\n");
        }
        cur = cur->next;
    }

    // Enum definitions
    cur = prog->body;
    while (cur != (ast.ASTNode*)0) {
        if (cur->kind == ast.AST_ENUM_DECL()) {
            emitter_emit_decl(e, cur);
        }
        cur = cur->next;
    }

    // Struct definitions
    cur = prog->body;
    while (cur != (ast.ASTNode*)0) {
        if (cur->kind == ast.AST_STRUCT_DECL()) {
            emitter_emit_decl(e, cur);
        }
        cur = cur->next;
    }

    // Forward declarations for functions and methods
    cur = prog->body;
    while (cur != (ast.ASTNode*)0) {
        if (cur->kind == ast.AST_FN_DECL()) {
            emitter_emit(e, c_type(cur->type_name));
            emitter_emit(e, " ");
            emitter_emit(e, c_fn_name(cur->text));
            emitter_emit(e, "(");
            string sname = get_struct_name(cur->text);
            bool has_this = false;
            if (strlen(sname) > 0) {
                emitter_emit(e, sname);
                emitter_emit(e, "* this");
                has_this = true;
            }
            ast.ASTNode* p = cur->left;
            bool first = !has_this;
            while (p != (ast.ASTNode*)0) {
                if (!first) {
                    emitter_emit(e, ", ");
                }
                emitter_emit(e, c_type(p->type_name));
                emitter_emit(e, " ");
                emitter_emit(e, p->text);
                first = false;
                p = p->next;
            }
            emitter_emit(e, ");\n");
        }
        cur = cur->next;
    }
    emitter_emit(e, "\n");

    // Function definitions and top-level statements
    cur = prog->body;
    while (cur != (ast.ASTNode*)0) {
        if (cur->kind == ast.AST_FN_DECL()) {
            emitter_emit_decl(e, cur);
        } else if (cur->kind != ast.AST_STRUCT_DECL() && cur->kind != ast.AST_ENUM_DECL() && cur->kind != ast.AST_IMPORT()) {
            emitter_emit_stmt(e, cur);
        }
        cur = cur->next;
    }
}

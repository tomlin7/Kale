// tests/test_editor_features.kl
// Unit tests for Editor Theme, Config, File Tree, and Find Bar

import "editor/theme.kl" as theme;
import "editor/config.kl" as cfg;
import "editor/file_tree.kl" as ft;
import "editor/find_bar.kl" as fb;
import "editor/command_bar.kl" as cb;
import "editor/app_state.kl" as app;
import "packages/std/text/piece_table.kl" as pt;

extern int strcmp(string a, string b);
extern int strlen(string s);

fn int main_entry() {
    print("[TEST] Starting IDE Extensions test suite (theme, config, file_tree, find_bar, command_bar, selection)...");

    // 1. Theme Engine tests
    theme.SyntaxTheme drac = theme.theme_dracula();
    if (drac.theme_id != theme.THEME_DRACULA()) {
        print("FAILED: dracula theme id mismatch");
        return 1;
    }
    if (drac.bg.a != 1.0f) {
        print("FAILED: theme alpha mismatch");
        return 2;
    }

    int next_t = theme.theme_next(drac.theme_id);
    if (next_t != theme.THEME_MONOKAI()) {
        print("FAILED: theme_next transition");
        return 3;
    }
    string t_name = theme.theme_name(theme.THEME_MONOKAI());
    if (strcmp(t_name, "Monokai") != 0) {
        print("FAILED: theme_name for Monokai");
        return 4;
    }
    print("  [PASS] Theme engine palettes and transitions verified");

    // 2. Config tests
    cfg.EditorConfig conf = cfg.config_defaults();
    if (conf.theme_id != 0 || conf.tab_width != 4 || !conf.show_line_nums) {
        print("FAILED: default config values");
        return 10;
    }

    char* serialized = cfg.config_serialize(&conf);
    cfg.EditorConfig parsed = cfg.config_parse((string)serialized);
    if (parsed.tab_width != 4 || parsed.theme_id != 0 || !parsed.show_line_nums) {
        print("FAILED: config parse roundtrip");
        return 11;
    }
    free((void*)serialized);

    cfg.config_cycle_theme(&conf);
    if (conf.theme_id != 1) {
        print("FAILED: config theme cycle");
        return 12;
    }
    print("  [PASS] Editor config defaults, serialization, and roundtrip verified");

    // 3. File Tree tests
    ft.FileTree tree;
    tree.init(0.0f, 0.0f, 200.0f, 600.0f, 20.0f);
    ft.ft_populate_default(&tree);

    if (tree.entry_count < 5) {
        print("FAILED: default file tree population");
        return 20;
    }

    // Hit test header area should return -1
    int hit_header = ft.ft_hit_test(&tree, 50.0f, 5.0f);
    if (hit_header != -1) {
        print("FAILED: header hit test should be -1");
        return 21;
    }

    // Hit test first item (editor/ dir)
    int hit_first = ft.ft_hit_test(&tree, 50.0f, 32.0f);
    if (hit_first != 0) {
        print("FAILED: first item hit test");
        return 22;
    }

    // Toggle dir expansion
    string path = ft.ft_click(&tree, 50.0f, 32.0f);
    if (strcmp(path, "") != 0) {
        print("FAILED: clicking directory should return empty path");
        return 23;
    }

    // Sync active buffer
    ft.ft_sync_active(&tree, "editor_main.kl");
    if (tree.selected_idx < 0) {
        print("FAILED: sync active file in tree");
        return 24;
    }
    print("  [PASS] File Tree panel hierarchy, hit-testing, and buffer synchronization verified");

    // 4. Find Bar tests
    fb.FindBar fbar;
    fbar.init(0.0f, 0.0f, 320.0f, 36.0f);
    if (fbar.is_visible) {
        print("FAILED: find bar should be initially hidden");
        return 30;
    }

    fbar.toggle();
    if (!fbar.is_visible) {
        print("FAILED: find bar toggle open");
        return 31;
    }

    fbar.append_char("k");
    fbar.append_char("a");
    fbar.append_char("l");
    fbar.append_char("e");
    if (fbar.query_len != 4 || strcmp(fbar.get_query(), "kale") != 0) {
        print("FAILED: find bar query input");
        return 32;
    }

    // Test find_all on sample piece table
    pt.PieceTable sample_buf;
    sample_buf.init("fn kale_run() {\n    int kale = 42;\n    return kale;\n}\n");
    fbar.find_all(&sample_buf);

    if (fbar.match_count != 3) {
        print("FAILED: find_all expected 3 matches for 'kale'");
        return 33;
    }
    if (fbar.get_current_row() != 0 || fbar.get_current_col() != 3) {
        print("FAILED: first match position mismatch");
        return 34;
    }

    fbar.next_match();
    if (fbar.get_current_row() != 1 || fbar.get_current_col() != 8) {
        print("FAILED: second match position mismatch");
        return 35;
    }

    fbar.prev_match();
    if (fbar.get_current_row() != 0) {
        print("FAILED: prev_match traversal mismatch");
        return 36;
    }

    sample_buf.destroy();
    fbar.destroy();
    print("  [PASS] Find & Replace in-buffer search and traversal verified");

    // 5. Command Palette tests
    cb.CommandBar cbar;
    cbar.init();
    if (cbar.is_visible) {
        print("FAILED: command bar should be initially hidden");
        return 40;
    }

    cbar.toggle();
    if (!cbar.is_visible || cbar.filtered_count != cbar.items_count) {
        print("FAILED: command bar toggle or initial filter count");
        return 41;
    }

    // Filter items with query "Switch"
    cbar.append_char("S");
    cbar.append_char("w");
    cbar.append_char("i");
    cbar.append_char("t");
    cbar.append_char("c");
    cbar.append_char("h");

    if (cbar.filtered_count != 3) {
        print("FAILED: command bar expected 3 filtered switch buffer items");
        return 42;
    }

    string top_title = cbar.get_item_title(cbar.filtered_indices[0]);
    if (strcmp(top_title, "Switch Buffer: editor_main.kl") != 0) {
        print("FAILED: filtered top item mismatch");
        return 43;
    }

    cbar.destroy();
    print("  [PASS] Fuzzy Command Palette dynamic filtering and actions verified");

    // 6. Selection & AppState tests
    app.EditorState est;
    est.init("line 0 hello\nline 1 world\nline 2 kale\n", "test.kl");

    if (est.has_selection) {
        print("FAILED: selection should be false initially");
        return 50;
    }

    // Set cursor and start selection
    est.cursor_row = 0;
    est.cursor_col = 5;
    est.start_selection();
    if (!est.has_selection || est.sel_anchor_row != 0 || est.sel_anchor_col != 5) {
        print("FAILED: start_selection setup");
        return 51;
    }

    // Drag selection to line 1 col 6
    est.update_drag_selection(1, 6);
    if (est.get_sel_start_row() != 0 || est.get_sel_start_col() != 5) {
        print("FAILED: sel start row/col mismatch");
        return 52;
    }
    if (est.get_sel_end_row() != 1 || est.get_sel_end_col() != 6) {
        print("FAILED: sel end row/col mismatch");
        return 53;
    }

    // Delete selection
    bool del_ok = est.delete_selection();
    if (!del_ok || est.has_selection) {
        print("FAILED: delete_selection failed");
        return 54;
    }

    // Undo deletion
    est.undo();

    // Select all
    est.select_all();
    if (!est.has_selection || est.get_sel_start_row() != 0 || est.get_sel_start_col() != 0) {
        print("FAILED: select_all anchor start mismatch");
        return 55;
    }
    if (est.get_sel_end_row() != 3) { // 3 lines + trailing newline gives 4 lines (index 0..3)
        print("FAILED: select_all end row mismatch");
        return 56;
    }

    est.destroy();
    print("  [PASS] Multi-line and drag selection bounds, deletion, and undo verified");

    print("ALL IDE EXTENSION TESTS PASSED PERFECTLY.");
    return 0;
}

main_entry();

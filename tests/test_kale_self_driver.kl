// tests/test_kale_self_driver.kl
// Verification test for Kale self-hosting compiler CLI driver

import "src/kale_self/main.kl" as km;

extern int printf(string fmt, ...);
extern int strcmp(string s1, string s2);
extern int strlen(string s);
extern void* strstr(string haystack, string needle);

fn int main_entry() {
    printf("[TEST] Initializing Kale self-hosting compiler driver (src/kale_self/main.kl)...\n");

    // Test 1: compile_source on multi-function program
    string multi_fn_code = "fn int add(int a, int b) { return a + b; }\nfn int factorial(int n) { if (n <= 1) { return 1; } return n * factorial(n - 1); }\nfn int main() { int res = add(10, 20); return res; }";

    string c_out = km.compile_source(multi_fn_code);
    if ((void*)c_out == (void*)0) {
        printf("  [FAIL] compile_source returned null\n");
        return 1;
    }

    if (strstr(c_out, "#include <stdint.h>") == (void*)0) {
        printf("  [FAIL] Missing standard include\n");
        return 2;
    }
    printf("  [PASS] Standard C headers included in generated code\n");

    if (strstr(c_out, "int64_t add(int64_t a, int64_t b);") == (void*)0) {
        printf("  [FAIL] Missing forward declaration for add\n");
        return 3;
    }
    printf("  [PASS] Forward declaration for 'add' found\n");

    if (strstr(c_out, "int64_t factorial(int64_t n);") == (void*)0) {
        printf("  [FAIL] Missing forward declaration for factorial\n");
        return 4;
    }
    printf("  [PASS] Forward declaration for 'factorial' found\n");

    if (strstr(c_out, "int64_t main();") == (void*)0) {
        printf("  [FAIL] Missing forward declaration for main\n");
        return 5;
    }
    printf("  [PASS] Forward declaration for 'main' found\n");

    if (strstr(c_out, "int64_t add(int64_t a, int64_t b) {") == (void*)0) {
        printf("  [FAIL] Missing definition for add\n");
        return 6;
    }
    printf("  [PASS] Function definition for 'add' found\n");

    if (strstr(c_out, "int64_t factorial(int64_t n) {") == (void*)0) {
        printf("  [FAIL] Missing definition for factorial\n");
        return 7;
    }
    printf("  [PASS] Recursive function definition for 'factorial' found\n");

    // Test 2: File reading and writing utilities
    bool wrote = km.write_string_to_file("bin/driver_sample.kl", multi_fn_code);
    if (!wrote) {
        printf("  [FAIL] Failed to write sample file\n");
        return 8;
    }
    printf("  [PASS] Sample Kale source file written successfully\n");

    string read_back = km.read_file_to_string("bin/driver_sample.kl");
    if (strcmp(read_back, multi_fn_code) != 0) {
        printf("  [FAIL] Read content does not match written content\n");
        return 9;
    }
    printf("  [PASS] Sample Kale source file read back accurately\n");

    // Test 3: compile_file end-to-end
    int comp_res = km.compile_file("bin/driver_sample.kl", "bin/driver_sample.c");
    if (comp_res != 0) {
        printf("  [FAIL] compile_file returned %d\n", comp_res);
        return 10;
    }
    printf("  [PASS] compile_file successfully compiled driver_sample.kl to driver_sample.c\n");

    string file_c_out = km.read_file_to_string("bin/driver_sample.c");
    if (strstr(file_c_out, "factorial") == (void*)0) {
        printf("  [FAIL] Output C file does not contain expected code\n");
        return 11;
    }
    printf("  [PASS] Output C file verified containing compiled program\n");

    // Test 4: CLI driver command dispatch (main_driver with --check)
    int check_code = km.main_driver(3, ["kalec", "bin/driver_sample.kl", "--check"]);
    if (check_code != 0) {
        printf("  [FAIL] main_driver --check failed with code %d\n", check_code);
        return 12;
    }
    printf("  [PASS] main_driver CLI dispatch with --check succeeded\n");

    // Test 5: CLI driver command dispatch (main_driver with -o)
    int cli_res = km.main_driver(4, ["kalec", "bin/driver_sample.kl", "-o", "bin/driver_cli_output.c"]);
    if (cli_res != 0) {
        printf("  [FAIL] main_driver -o failed with code %d\n", cli_res);
        return 13;
    }
    printf("  [PASS] main_driver CLI dispatch with -o succeeded\n");

    string cli_c_out = km.read_file_to_string("bin/driver_cli_output.c");
    if (strstr(cli_c_out, "int64_t main()") == (void*)0) {
        printf("  [FAIL] CLI generated C file missing main()\n");
        return 14;
    }
    printf("  [PASS] CLI output C file verified\n");

    // Test 6: compile_source error rejection
    string err_syn = km.compile_source("fn int bad(");
    if (strlen(err_syn) != 0) {
        printf("  [FAIL] Expected empty string on syntax error\n");
        return 15;
    }
    string err_sem = km.compile_source("fn int bad() { return undeclared_var; }");
    if (strlen(err_sem) != 0) {
        printf("  [FAIL] Expected empty string on semantic error\n");
        return 16;
    }
    printf("  [PASS] compile_source error rejection verified\n");

    // Test 7: compile_file on non-existent file
    int non_exist = km.compile_file("bin/does_not_exist_12345.kl", "bin/out.c");
    if (non_exist != 1) {
        printf("  [FAIL] Expected 1 for non-existent file, got %d\n", non_exist);
        return 17;
    }
    printf("  [PASS] compile_file non-existent file handling verified\n");

    // Test 8: compile_file on syntax error file
    km.write_string_to_file("bin/driver_err_syn.kl", "fn int bad(");
    int syn_code = km.compile_file("bin/driver_err_syn.kl", "bin/out.c");
    if (syn_code != 2) {
        printf("  [FAIL] Expected 2 for syntax error file, got %d\n", syn_code);
        return 18;
    }
    printf("  [PASS] compile_file syntax error exit code verified\n");

    // Test 9: compile_file on semantic error file
    km.write_string_to_file("bin/driver_err_sem.kl", "fn int bad() { return nonexistent_var; }");
    int sem_code = km.compile_file("bin/driver_err_sem.kl", "bin/out.c");
    if (sem_code != 3) {
        printf("  [FAIL] Expected 3 for semantic error file, got %d\n", sem_code);
        return 19;
    }
    printf("  [PASS] compile_file semantic error exit code verified\n");

    // Test 10: main_driver CLI option validation
    int help_code = km.main_driver(2, ["kalec", "--help"]);
    if (help_code != 0) {
        printf("  [FAIL] main_driver --help failed\n");
        return 20;
    }
    int unrec_code = km.main_driver(2, ["kalec", "--unknown-flag"]);
    if (unrec_code != 1) {
        printf("  [FAIL] main_driver unrecognized flag did not exit 1\n");
        return 21;
    }
    int miss_o = km.main_driver(3, ["kalec", "bin/driver_sample.kl", "-o"]);
    if (miss_o != 1) {
        printf("  [FAIL] main_driver missing -o path did not exit 1\n");
        return 22;
    }
    printf("  [PASS] main_driver CLI option validation verified\n");

    // Test 11: main_driver --check on syntax/semantic errors
    int check_syn = km.main_driver(3, ["kalec", "bin/driver_err_syn.kl", "--check"]);
    if (check_syn != 2) {
        printf("  [FAIL] Expected 2 for check syntax error, got %d\n", check_syn);
        return 23;
    }
    int check_sem = km.main_driver(3, ["kalec", "bin/driver_err_sem.kl", "--check"]);
    if (check_sem != 3) {
        printf("  [FAIL] Expected 3 for check semantic error, got %d\n", check_sem);
        return 24;
    }
    // Test 12: Advanced parity features (struct method, enum, switch, alloc/free, print)
    string adv_code = "enum Status { IDLE, RUNNING = 1, STOPPED = 2 }\nstruct Point { int x; int y; }\nfn void Point.set(int nx, int ny) { this->x = nx; this->y = ny; }\nfn int main() { Point* p = alloc(Point); p->set(10, 20); int s = RUNNING; switch (s) { case 1: { print(p->x, p->y); break; } default: { break; } } free(p); return 0; }";
    string adv_c = km.compile_source(adv_code);
    if ((void*)adv_c == (void*)0 || strlen(adv_c) == 0) {
        printf("  [FAIL] Failed to compile advanced parity program\n");
        return 25;
    }
    if (strstr(adv_c, "kale_Point_set") == (void*)0) {
        printf("  [FAIL] Missing struct method kale_Point_set\n");
        return 26;
    }
    if (strstr(adv_c, "typedef enum Status") == (void*)0) {
        printf("  [FAIL] Missing enum Status definition\n");
        return 27;
    }
    if (strstr(adv_c, "switch (") == (void*)0) {
        printf("  [FAIL] Missing switch statement\n");
        return 28;
    }
    if (strstr(adv_c, "malloc(sizeof(Point))") == (void*)0) {
        printf("  [FAIL] Missing alloc/malloc call\n");
        return 29;
    }
    printf("  [PASS] Advanced parity features (methods, enums, switch, alloc, print) compiled successfully\n");

    printf("ALL SELF-HOSTING DRIVER TESTS PASSED PERFECTLY.\n");
    return 0;
}

main_entry();

// test_net_http.kl
// Unit test for libs/net HTTP types (struct-level, no live socket calls)
// Link with: uv run --directory E:/kale python -m kale.cli build -l ws2_32

import "libs/net/http.kl" as http;

fn int main_entry() {
    print("[TEST] Initializing libs/net/http HTTP client struct suite...");

    // URL parser - parses default when blank
    http.ParsedUrl u = http.parse_url("example.com");
    // parse_url returns a struct with default host/port; just verify no crash
    if (u.port >= 0) {
        print("  [PASS] parse_url() returns valid ParsedUrl struct");
    }

    // Build an HttpResponse manually (no socket)
    http.HttpResponse resp;
    resp.status_code = 200;
    resp.status_text = "OK";
    resp.body = "hello world";
    resp.content_length = 11;

    if (resp.status_code == 200) {
        print("  [PASS] HttpResponse.status_code = 200");
    }
    if (resp.content_length == 11) {
        print("  [PASS] HttpResponse.content_length = 11");
    }
    if (resp.body == "hello world") {
        print("  [PASS] HttpResponse.body = 'hello world'");
    }

    // Test a 404 response struct
    http.HttpResponse err_resp;
    err_resp.status_code = 404;
    err_resp.status_text = "Not Found";
    err_resp.body = "";
    err_resp.content_length = 0;

    if (err_resp.status_code == 404) {
        print("  [PASS] HttpResponse 404 status_code correct");
    }

    print("ALL LIBS/NET/HTTP TESTS PASSED PERFECTLY.");
    return 0;
}

main_entry();

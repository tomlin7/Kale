// libs/framework/app.kl
// Kale GPU Application Framework & Unified Event Loop Runtime

import "libs/glfw/glfw.kl" as glfw;
import "libs/glfw/constants.kl" as glc;
import "libs/gl/gl.kl" as gl;
import "libs/gl/constants.kl" as kgl;
import "libs/gl/loader.kl" as glloader;
import "libs/ui/ui.kl" as ui;

enum EventType {
    EVENT_NONE,
    KEY_DOWN,
    KEY_UP,
    MOUSE_MOVE,
    MOUSE_DOWN,
    MOUSE_UP,
    WINDOW_RESIZE,
}

struct Event {
    EventType type;
    int key;
    int scancode;
    int mods;
    float mouse_x;
    float mouse_y;
    int width;
    int height;
}

struct AppConfig {
    string title;
    int width;
    int height;
    int vsync;
    string font_path;
    float font_size;
}

fn void AppConfig.init(string title, int w, int h) {
    this->title = title;
    this->width = w;
    this->height = h;
    this->vsync = 1;
    this->font_path = "C:\\Windows\\Fonts\\consola.ttf";
    this->font_size = 20.0f;
}

struct App {
    void* window;
    glloader.GLContext gl_ctx;
    ui.UIContext ui_ctx;
    int width;
    int height;
    int is_running;
    double last_time;
    double delta_time;
    Event pending_event;
}

fn int App.init(AppConfig config) {
    this->width = config.width;
    this->height = config.height;
    this->is_running = 0;
    this->delta_time = 0.016;

    int init_res = glfw.glfwInit();
    if (init_res == 0) {
        return 0;
    }

    glfw.glfwWindowHint(glc.GLFW_CONTEXT_VERSION_MAJOR(), 3);
    glfw.glfwWindowHint(glc.GLFW_CONTEXT_VERSION_MINOR(), 3);
    glfw.glfwWindowHint(glc.GLFW_OPENGL_PROFILE(), glc.GLFW_OPENGL_CORE_PROFILE());

    this->window = glfw.glfwCreateWindow(config.width, config.height, config.title, (void*)0, (void*)0);
    if (this->window == (void*)0) {
        glfw.glfwTerminate();
        return 0;
    }

    glfw.glfwMakeContextCurrent(this->window);
    glfw.glfwSwapInterval(config.vsync);

    int loaded = this->gl_ctx.load();
    if (loaded == 0) {
        glfw.glfwDestroyWindow(this->window);
        glfw.glfwTerminate();
        return 0;
    }

    int ui_ok = this->ui_ctx.init(this->window, &this->gl_ctx, config.font_path, config.font_size);
    if (ui_ok == 0) {
        glfw.glfwDestroyWindow(this->window);
        glfw.glfwTerminate();
        return 0;
    }

    this->is_running = 1;
    this->last_time = glfw.glfwGetTime();
    return 1;
}

fn int App.begin_frame() {
    if (this->is_running == 0 || glfw.glfwWindowShouldClose(this->window) != 0) {
        this->is_running = 0;
        return 0;
    }

    double now = glfw.glfwGetTime();
    this->delta_time = now - this->last_time;
    this->last_time = now;

    int fb_w = 0;
    int fb_h = 0;
    glfw.glfwGetFramebufferSize(this->window, &fb_w, &fb_h);
    this->width = fb_w;
    this->height = fb_h;

    gl.glViewport(0, 0, fb_w, fb_h);
    gl.glClearColor(this->ui_ctx.theme.bg.r, this->ui_ctx.theme.bg.g, this->ui_ctx.theme.bg.b, 1.0f);
    gl.glClear(kgl.GL_COLOR_BUFFER_BIT());

    this->ui_ctx.begin(fb_w, fb_h);
    return 1;
}

fn int App.poll_event(Event* event) {
    if (this->is_running == 0) {
        return 0;
    }
    event->mouse_x = this->ui_ctx.mouse_x;
    event->mouse_y = this->ui_ctx.mouse_y;
    event->width = this->width;
    event->height = this->height;
    if (this->ui_ctx.mouse_pressed != 0) {
        event->type = EventType.MOUSE_DOWN;
        return 1;
    }
    if (this->ui_ctx.mouse_released != 0) {
        event->type = EventType.MOUSE_UP;
        return 1;
    }
    if (this->ui_ctx.mouse_down != 0) {
        event->type = EventType.MOUSE_MOVE;
        return 1;
    }
    event->type = EventType.WINDOW_RESIZE;
    return 1;
}

fn void App.dispatch_event(Event event) {
    this->pending_event = event;
}

fn void App.end_frame() {
    this->ui_ctx.end();

    glfw.glfwPollEvents();
    glfw.glfwSwapBuffers(this->window);
}

fn void App.close() {
    this->is_running = 0;
    if (this->window != (void*)0) {
        glfw.glfwDestroyWindow(this->window);
        this->window = (void*)0;
    }
    glfw.glfwTerminate();
}

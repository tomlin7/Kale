// libs/glfw/constants.kl
// Standard GLFW3 constants for window creation, context initialization, and input events

// Boolean Values
int32 GLFW_TRUE() { return 1; }
int32 GLFW_FALSE() { return 0; }

// Key & Button Action States
int32 GLFW_RELEASE() { return 0; }
int32 GLFW_PRESS() { return 1; }
int32 GLFW_REPEAT() { return 2; }

// Window Hints & Context Attributes
int32 GLFW_FOCUSED() { return 0x00020001; }

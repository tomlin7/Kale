// libs/ui/theme.kl
// Standard UI Color Themes & Visual Styling Properties

import "libs/render/math.kl" as rmath;

struct Theme {
    rmath.Color bg;
    rmath.Color panel_bg;
    rmath.Color header_bg;
    rmath.Color text;
    rmath.Color text_muted;

    // Interactive Button States
    rmath.Color button_normal;
    rmath.Color button_hover;
    rmath.Color button_active;
    rmath.Color button_text;

    // Input States
    rmath.Color input_bg;
    rmath.Color input_border;
    rmath.Color input_border_focus;
    rmath.Color input_text;
    rmath.Color cursor;

    // Accents & Separators
    rmath.Color accent;
    rmath.Color border;
}

fn Theme theme_dark() {
    Theme t;
    t.bg = rmath.color_rgba(0.11f, 0.12f, 0.14f, 1.0f);
    t.panel_bg = rmath.color_rgba(0.16f, 0.17f, 0.20f, 1.0f);
    t.header_bg = rmath.color_rgba(0.20f, 0.21f, 0.25f, 1.0f);
    t.text = rmath.color_rgba(0.92f, 0.94f, 0.96f, 1.0f);
    t.text_muted = rmath.color_rgba(0.60f, 0.63f, 0.68f, 1.0f);

    t.button_normal = rmath.color_rgba(0.24f, 0.26f, 0.32f, 1.0f);
    t.button_hover = rmath.color_rgba(0.32f, 0.35f, 0.44f, 1.0f);
    t.button_active = rmath.color_rgba(0.18f, 0.45f, 0.75f, 1.0f);
    t.button_text = rmath.color_rgba(1.0f, 1.0f, 1.0f, 1.0f);

    t.input_bg = rmath.color_rgba(0.13f, 0.14f, 0.16f, 1.0f);
    t.input_border = rmath.color_rgba(0.25f, 0.27f, 0.32f, 1.0f);
    t.input_border_focus = rmath.color_rgba(0.25f, 0.55f, 0.95f, 1.0f);
    t.input_text = rmath.color_rgba(0.95f, 0.95f, 0.98f, 1.0f);
    t.cursor = rmath.color_rgba(0.30f, 0.65f, 1.0f, 1.0f);

    t.accent = rmath.color_rgba(0.20f, 0.65f, 0.50f, 1.0f);
    t.border = rmath.color_rgba(0.22f, 0.23f, 0.27f, 1.0f);
    return t;
}

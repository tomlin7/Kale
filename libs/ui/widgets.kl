// libs/ui/widgets.kl
// Standard Immediate-Mode Interactive UI Widgets (Buttons, Panels, Text, Sliders)

import "libs/ui/ui.kl" as ui;
import "libs/render/math.kl" as rmath;

extern int strlen(string s);

fn void ui_panel(ui.UIContext* ctx, float x, float y, float w, float h, rmath.Color color) {
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, h, color);
}

fn void ui_label(ui.UIContext* ctx, string text, float x, float y, rmath.Color color) {
    ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, text, x, y, color);
}

fn int ui_button(ui.UIContext* ctx, int id, string text, float x, float y, float w, float h) {
    int clicked = 0;
    int hovered = ctx->is_hovered(x, y, w, h);

    if (hovered != 0) {
        ctx->hot_id = id;
        if (ctx->active_id == 0 && ctx->mouse_pressed != 0) {
            ctx->active_id = id;
            ctx->focused_id = id;
        }
    }

    rmath.Color btn_col = ctx->theme.button_normal;
    if (ctx->active_id == id) {
        btn_col = ctx->theme.button_active;
        if (ctx->mouse_released != 0) {
            if (hovered != 0) {
                clicked = 1;
                ctx->last_clicked_id = id;
            }
            ctx->active_id = 0;
        }
    } else if (ctx->hot_id == id) {
        btn_col = ctx->theme.button_hover;
    }

    // Render button background
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, h, btn_col);

    // Center text label within button bounds
    int len = strlen(text);
    float text_w = (float)len * 11.0f; // Approximate character width for monospace
    float tx = x + (w - text_w) * 0.5f;
    if (tx < x + 8.0f) {
        tx = x + 8.0f;
    }
    float ty = y + (h - 20.0f) * 0.5f;

    ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, text, tx, ty, ctx->theme.button_text);
    return clicked;
}

fn float ui_slider(ui.UIContext* ctx, int id, float value, float min_val, float max_val, float x, float y, float w, float h) {
    float cur_val = value;
    int hovered = ctx->is_hovered(x, y, w, h);

    if (hovered != 0) {
        ctx->hot_id = id;
        if (ctx->active_id == 0 && ctx->mouse_pressed != 0) {
            ctx->active_id = id;
            ctx->focused_id = id;
        }
    }

    if (ctx->active_id == id) {
        float rel_x = ctx->mouse_x - x;
        if (rel_x < 0.0f) {
            rel_x = 0.0f;
        }
        if (rel_x > w) {
            rel_x = w;
        }
        float frac = rel_x / w;
        cur_val = min_val + frac * (max_val - min_val);
        if (ctx->mouse_released != 0) {
            ctx->active_id = 0;
        }
    }

    // Render slider track
    float track_h = 6.0f;
    float track_y = y + (h - track_h) * 0.5f;
    ctx->renderer.push_quad(ctx->gl_ctx, x, track_y, w, track_h, ctx->theme.input_border);

    // Render thumb handle
    float frac = (cur_val - min_val) / (max_val - min_val);
    if (frac < 0.0f) { frac = 0.0f; }
    if (frac > 1.0f) { frac = 1.0f; }
    float thumb_w = 14.0f;
    float thumb_x = x + frac * (w - thumb_w);

    rmath.Color thumb_col = ctx->theme.button_hover;
    if (ctx->active_id == id) {
        thumb_col = ctx->theme.accent;
    }
    ctx->renderer.push_quad(ctx->gl_ctx, thumb_x, y, thumb_w, h, thumb_col);

    return cur_val;
}

fn int ui_text_input(ui.UIContext* ctx, int id, char* buffer, int max_len, float x, float y, float w, float h) {
    int hovered = ctx->is_hovered(x, y, w, h);
    if (hovered != 0 && ctx->mouse_pressed != 0) {
        ctx->focused_id = id;
    }
    bool focused = ctx->focused_id == id;
    rmath.Color border = ctx->theme.input_border;
    if (focused) { border = ctx->theme.accent; }
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, h, ctx->theme.input_bg);
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, 2.0f, border);
    if (buffer != (char*)0) {
        ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, (string)buffer, x + 8.0f, y + 5.0f, ctx->theme.input_text);
        if (focused) {
            float cursor_x = x + 8.0f + (float)strlen((string)buffer) * 10.0f;
            ctx->renderer.push_quad(ctx->gl_ctx, cursor_x, y + 4.0f, 2.0f, h - 8.0f, ctx->theme.cursor);
        }
    }
    return focused as int;
}

fn int ui_text_input_append(char* buffer, int max_len, char value) {
    int length = strlen((string)buffer);
    if (length >= max_len - 1) { return 0; }
    buffer[length] = value;
    buffer[length + 1] = (char)0;
    return 1;
}

fn int ui_text_input_backspace(char* buffer) {
    int length = strlen((string)buffer);
    if (length <= 0) { return 0; }
    buffer[length - 1] = (char)0;
    return 1;
}

fn int ui_checkbox(ui.UIContext* ctx, int id, string caption, int checked, float x, float y) {
    float size = 18.0f;
    int hovered = ctx->is_hovered(x, y, size + 8.0f + (float)strlen(caption) * 10.0f, size);
    if (hovered != 0) {
        ctx->hot_id = id;
        if (ctx->mouse_pressed != 0) {
            ctx->focused_id = id;
            if (checked == 0) { checked = 1; } else { checked = 0; }
            ctx->last_clicked_id = id;
        }
    }
    rmath.Color box = ctx->theme.input_border;
    if (checked != 0) { box = ctx->theme.accent; }
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, size, size, box);
    if (checked != 0) {
        ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, "x", x + 4.0f, y + 1.0f, ctx->theme.button_text);
    }
    ctx->font.draw_text(&ctx->renderer, ctx->gl_ctx, caption, x + size + 8.0f, y, ctx->theme.text);
    return checked;
}

fn float ui_scrollbar(ui.UIContext* ctx, int id, float scroll_offset, float content_size, float view_size, float x, float y, float w, float h) {
    float max_scroll = content_size - view_size;
    if (max_scroll < 0.0f) { max_scroll = 0.0f; }
    if (scroll_offset < 0.0f) { scroll_offset = 0.0f; }
    if (scroll_offset > max_scroll) { scroll_offset = max_scroll; }
    float ratio = 1.0f;
    if (content_size > 0.0f) {
        ratio = view_size / content_size;
        if (ratio > 1.0f) { ratio = 1.0f; }
    }
    float thumb_h = h * ratio;
    if (thumb_h < 16.0f) { thumb_h = 16.0f; }
    float travel = h - thumb_h;
    float thumb_y = y;
    if (max_scroll > 0.0f) { thumb_y = y + scroll_offset / max_scroll * travel; }
    int hovered = ctx->is_hovered(x, thumb_y, w, thumb_h);
    if (hovered != 0 && ctx->mouse_pressed != 0) { ctx->active_id = id; }
    if (ctx->active_id == id) {
        float rel = ctx->mouse_y - y - thumb_h * 0.5f;
        if (rel < 0.0f) { rel = 0.0f; }
        if (rel > travel) { rel = travel; }
        if (travel > 0.0f) { scroll_offset = rel / travel * max_scroll; }
        else { scroll_offset = 0.0f; }
        if (ctx->mouse_released != 0) { ctx->active_id = 0; }
    }
    ctx->renderer.push_quad(ctx->gl_ctx, x, y, w, h, ctx->theme.input_bg);
    ctx->renderer.push_quad(ctx->gl_ctx, x, thumb_y, w, thumb_h, ctx->theme.button_hover);
    return scroll_offset;
}

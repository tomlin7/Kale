// libs/ui/widgets/button.kl
// Standard Interactive UI Button Component for Kale UI

import "libs/ui/geom.kl" as geom;
import "libs/ui/event.kl" as ev;
import "libs/ui/canvas.kl" as cv;

struct Button {
    geom.Rect bounds;
    string text;
    geom.Color normal_bg;
    geom.Color hover_bg;
    geom.Color pressed_bg;
    geom.Color fg;
    bool is_hovered;
    bool is_pressed;
    fn(): void on_click;
}

fn void Button.init(string text, int x, int y, int w, int h, geom.Color bg, geom.Color hover_bg, geom.Color fg) {
    this->bounds.init(x, y, w, h);
    this->text = text;
    this->normal_bg = bg;
    this->hover_bg = hover_bg;
    this->pressed_bg.init(bg.r - 20, bg.g - 20, bg.b - 20, 255);
    this->fg = fg;
    this->is_hovered = false;
    this->is_pressed = false;
    this->on_click = (void*)0;
}

fn bool Button.handle_event(ev.Event* e) {
    if (e->kind == ev.event_mouse_move()) {
        bool inside = this->bounds.contains(e->mouse_x, e->mouse_y);
        this->is_hovered = inside;
        return inside;
    }
    if (e->kind == ev.event_mouse_down()) {
        if (this->bounds.contains(e->mouse_x, e->mouse_y)) {
            this->is_pressed = true;
            return true;
        }
    }
    if (e->kind == ev.event_mouse_up()) {
        if (this->is_pressed && this->bounds.contains(e->mouse_x, e->mouse_y)) {
            this->is_pressed = false;
            fn(): void cb = this->on_click;
            if (cb != (void*)0) {
                cb();
            }
            return true;
        }
        this->is_pressed = false;
    }
    return false;
}

fn void Button.render(cv.Canvas* canvas) {
    geom.Color current_bg = this->normal_bg;
    if (this->is_pressed) {
        current_bg = this->pressed_bg;
    } else {
        if (this->is_hovered) {
            current_bg = this->hover_bg;
        }
    }

    // Fill button body
    canvas->fill_rect(this->bounds.x, this->bounds.y, this->bounds.width, this->bounds.height, current_bg);

    // Subtle border
    geom.Color border_color;
    border_color.init(current_bg.r + 30, current_bg.g + 30, current_bg.b + 30, 255);
    canvas->draw_rect(this->bounds.x, this->bounds.y, this->bounds.width, this->bounds.height, border_color, 1);

    // Centered label text
    int text_x = this->bounds.x + 12;
    int text_y = this->bounds.y + (this->bounds.height - 16) / 2;
    canvas->draw_text(this->text, text_x, text_y, this->fg, current_bg);
}
